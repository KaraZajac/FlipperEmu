From: FlipperEmu
Subject: [PATCH] cputlb: the host's time that a vCPU is in a device's model

An access to a device's register is one instruction of the guest's,
however long the device's model takes over it. Some take long: the write
that starts a DMA transfer, where the model moves the whole block before
it returns (a block of an SD card over SPI, 512 bytes there and 512 back:
a millisecond of the host's time on the Flipper's machine).

Without -icount the virtual clock is the host's, and that millisecond is
the guest's time: one instruction, and every timer that ran out in it is
run late by as much, with the vCPU's thread holding the big lock. A
machine that keeps a clock of the CPU's own running (the Flipper's, on
the hook that -icount's clock has) can leave such time out, if it knows
it.

Say how long accesses took. With tcg_mmio_timed set (a machine's
choice), tcg_mmio_ns is what every device access under the big lock took
beyond tcg_mmio_free_ns, in all: two readings of the host's clock an
access. The lock keeps the sum whole. Nothing is timed, and nothing
changes, for a machine that does not set it.

On the Flipper's machine, with what an access takes beyond 20 us out of
the clock, on a host with nothing else to do: while the firmware reads a
file of its card, the timers that the main loop runs more than 200 us
late are 1 where they were 4358 (one for every block), and while it reads
an NFC card eight times, none where they were 376.

Signed-off-by: FlipperEmu
---
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -1964,6 +1964,36 @@
     return ret_be;
 }
 
+/*
+ * The host's time that a vCPU is in the model of a device.  A device access
+ * is one instruction of the guest's, however long the model takes over it
+ * (a write that starts a DMA transfer, done before it returns: a
+ * millisecond), and a machine that keeps a clock of the CPU's own running
+ * can leave that out of it: with tcg_mmio_timed set, tcg_mmio_ns is what
+ * every access took beyond tcg_mmio_free_ns, in all.  Accesses under the
+ * big lock, which is what keeps the sum whole; a lockless one is short.
+ */
+bool tcg_mmio_timed;
+int64_t tcg_mmio_free_ns;
+int64_t tcg_mmio_ns;
+
+static inline void tcg_mmio_timed_end(int64_t *t0)
+{
+    if (*t0) {
+        int64_t took = get_clock() - *t0;
+
+        if (took > tcg_mmio_free_ns) {
+            qatomic_set(&tcg_mmio_ns, qatomic_read(&tcg_mmio_ns)
+                        + took - tcg_mmio_free_ns);
+        }
+    }
+}
+
+#define TCG_MMIO_TIMED()                                                \
+    int64_t tcg_mmio_t0                                                 \
+        __attribute__((cleanup(tcg_mmio_timed_end), unused))            \
+        = tcg_mmio_timed ? get_clock() : 0
+
 static uint64_t do_ld_mmio_beN(CPUState *cpu, CPUTLBEntryFull *full,
                                uint64_t ret_be, vaddr addr, int size,
                                int mmu_idx, MMUAccessType type, uintptr_t ra)
@@ -1983,6 +2013,7 @@
                                type, ra, mr, mr_offset);
     }
     BQL_LOCK_GUARD();
+    TCG_MMIO_TIMED();
     return int_ld_mmio_beN(cpu, full, ret_be, addr, size, mmu_idx,
                            type, ra, mr, mr_offset);
 }
@@ -2002,6 +2033,7 @@
     mr = section->mr;
 
     BQL_LOCK_GUARD();
+    TCG_MMIO_TIMED();
     a = int_ld_mmio_beN(cpu, full, ret_be, addr, size - 8, mmu_idx,
                         MMU_DATA_LOAD, ra, mr, mr_offset);
     b = int_ld_mmio_beN(cpu, full, ret_be, addr + size - 8, 8, mmu_idx,
@@ -2497,6 +2529,7 @@
     mr = section->mr;
 
     BQL_LOCK_GUARD();
+    TCG_MMIO_TIMED();
     return int_st_mmio_leN(cpu, full, val_le, addr, size, mmu_idx,
                            ra, mr, mr_offset);
 }
@@ -2515,6 +2548,7 @@
     mr = section->mr;
 
     BQL_LOCK_GUARD();
+    TCG_MMIO_TIMED();
     int_st_mmio_leN(cpu, full, int128_getlo(val_le), addr, 8,
                     mmu_idx, ra, mr, mr_offset);
     return int_st_mmio_leN(cpu, full, int128_gethi(val_le), addr + 8,
--- a/include/exec/cputlb.h
+++ b/include/exec/cputlb.h
@@ -92,6 +92,16 @@
                   int mmu_idx, vaddr size);
 
 #if defined(CONFIG_TCG) && !defined(CONFIG_USER_ONLY)
+
+/*
+ * The host's time that vCPUs spend in the models of devices: with
+ * tcg_mmio_timed set, tcg_mmio_ns is what every device access under the
+ * big lock took beyond tcg_mmio_free_ns, in all.
+ */
+extern bool tcg_mmio_timed;
+extern int64_t tcg_mmio_free_ns;
+extern int64_t tcg_mmio_ns;
+
 /**
  * tlb_flush_page:
  * @cpu: CPU whose TLB should be flushed
