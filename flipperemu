def cmd_rfid(args):
    import fe_rfid
    from fe_monitor import Monitor
    if args.list:
        for name, (_, size, mod) in fe_rfid.PROTOCOLS.items():
            print(f"{name:12} {size} bytes  {mod}")
        return 0
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    tag = args.tag
    label, value, t5577 = None, None, None
    try:
        if not tag:
            pass
        elif tag == ["none"]:
            label, value = "no tag", "none"
        elif tag[0].lower() == "t5577":
            blocks = [int(b, 16) for b in tag[1:]]
            if len(blocks) > 8 or any(b >> 32 for b in blocks):
                raise ValueError("a T5577 has blocks 0-7, 32-bit hex words")
            b0 = blocks[0] if blocks else 0x000880E8
            label = (f"a T5577 ({'blank, ' if not blocks else ''}"
                     f"{fe_rfid.t5577_config(b0)}) that the firmware can write")
            t5577 = ",".join(f"{b:08X}" for b in blocks) or "blank"
        elif len(tag) == 1 and tag[0].endswith(".rfid"):
            proto, data = fe_rfid.parse_rfid(tag[0])
            label = f"{proto} {data.hex(' ').upper()} ({pathlib.Path(tag[0]).name})"
            value = fe_rfid.tag(proto, data)
        elif len(tag) == 1 and pathlib.Path(tag[0]).is_file():
            frame, mod = fe_rfid.capture_frame(fe_rfid.parse_capture(tag[0]))
            label = (f"the tag emulated in {pathlib.Path(tag[0]).name} "
                     f"({sum(n for _, n in frame)}-cycle frame, {mod.upper()})")
            value = fe_rfid.tag_string(frame, mod)
        elif len(tag) >= 2:
            data = fe_rfid.parse_hex(" ".join(tag[1:]))
            name, frame, mod = fe_rfid.encode(tag[0], data)
            label = f"{name} {data.hex(' ').upper()}"
            value = fe_rfid.tag_string(frame, mod)
        else:
            sys.exit("usage: rfid PROTOCOL DATA | rfid FILE.rfid | rfid CAPTURE.txt | "
                     "rfid t5577 [BLOCK0 ...] | rfid none | rfid --list")
    except (ValueError, KeyError, OSError) as e:
        sys.exit(f"rfid: {e}")
    m = Monitor(str(dev.monitor))
    try:
        for prop, on in (("reader", args.reader), ("noise", args.noise)):
            if on is not None:
                err = m.cmd(f"qom-set /machine/rfid {prop} {'on' if on == 'on' else 'off'}")
                if err:
                    sys.exit(f"rfid: {err}")
        if t5577 is not None:
            err = m.cmd(f"qom-set /machine/rfid t5577 {t5577}")
            if err:
                sys.exit(f"rfid: {err}")
            dev.set_held("rfid", label)
            print(f"[{dev.name}] 125 kHz field: {label}")
        elif value is not None:
            if value != "none":
                path = dev.dir / "rfid-tag.txt"     # long frames: past HMP line limits
                path.write_text(value + "\n")
                value = f"file:{path}"
            err = m.cmd(f"qom-set /machine/rfid tag {value}")
            if err:
                sys.exit(f"rfid: {err}")
            dev.set_held("rfid", None if value == "none" else label)
            print(f"[{dev.name}] 125 kHz field: {label}")
        else:
            get = lambda prop: m.cmd(f"qom-get /machine/rfid {prop}").strip().strip('"')
            onoff = lambda prop: "on" if get(prop) == "true" else "off"
            print(f"[{dev.name}] its reader's field: {get('field')}; tag in it: "
                  f"{'yes' if get('tag') else 'none'}; field noise: {onoff('noise')}; "
                  f"a virtual reader's field around it: {onoff('reader')}")
            t5 = get("t5577")
            if t5:
                print(f"T5577 ({fe_rfid.t5577_config(int(t5.split()[0], 16))}): {t5}")
            last = get("tx")
            if last:
                print(f"latest emulation capture: {last}")
    finally:
        m.close()
    return 0


def cmd_nfc(args):
