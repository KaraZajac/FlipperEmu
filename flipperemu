        if after and after != before:
            print(f"[{dev.name}] it read: {after}")
            print(pathlib.Path(after).read_text(), end="")
            return 0
        sys.exit(f"[{dev.name}] nothing read: is the Flipper emulating a card "
                 "(NFC -> Saved -> Emulate, or `emulate -f` in the nfc shell)?")
