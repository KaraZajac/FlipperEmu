def spi_device(dev, m, d):
    """A device on the header's SPI bus as `spi --json` prints it: what
    fe_header.parse_spi has for it, the "drive" that its contents are in
    (None: it has none, and forgets when the emulator stops), and the "file"
    in the device's folder if that drive is the launcher's own."""
    drive = qom_get(m, f"/machine/peripheral/spi-{d['select']}", "drive")
    own = drive == f"spi-{d['select']}-rom"
    return dict(d, drive=drive or None,
                file=str(spi_rom(dev, d["select"])) if own else None)


def cmd_spi(args):
    """The SPI bus of a running device's GPIO header: the devices on it,
    with where a flash's contents are kept, and what the firmware clocked
    there"""
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        bus = read_spi(m)
        if not bus:
            sys.exit(f"[{dev.name}] this emulator cannot tell what is on the "
                     "header's SPI bus: `spi` needs one that is built from "
                     "this tree as it is now (scripts/setup_qemu.sh)")
        devices = [spi_device(dev, m, d) for d in bus["devices"]]
    finally:
        m.close()
    if args.json:
