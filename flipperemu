def header_pin(pins, word):
    """The pin a user means: by the MCU's name (PA7), by what the case says
    (A7, TX, 1W), or by its number on the header (2)"""
    want = word.upper()
    for p in pins:
        if want in (p["pin"], p["label"], str(p["number"])):
            return p
    names = " ".join(p["pin"] for p in pins)
    other = {**{str(n): what for n, what in fe_header.POWER.items()},
             "5V": "+5V", "+5V": "+5V", "3V3": "3V3", "GND": "GND"}.get(want)
    sys.exit(f"gpio: {word!r} is " + (f"{other} on the header, and no pin to "
                                     "read or hold" if other else
                                     "no pin of the GPIO header's") +
             f": {names} (or as on the case: A7, C0; or its number there)")


def header_record(m):
    """The record of the header's pins that runs: (changes, ns, the file).
    None: none runs.  False: an emulator that cannot record."""
    text = qom_get(m, "/machine", "header-record")
    if not isinstance(text, str):
        return False
    return fe_header.parse_record(text)


def set_header_record(m, value):
    err = m.cmd(f"qom-set /machine header-record {value}").strip()
    if err:
        sys.exit("gpio: " + re.sub(r"^Error: (header-record: )?", "", err))


def changes_text(n):
    return ("no change" if not n else "1 change" if n == 1
            else f"{n} changes") + " of a pin's level"


RECORD_OLD = ("this emulator cannot record its GPIO header: it was started "
              "before it could (`stop`, and `run` again)")


def gpio_record(dev, what):
    """gpio record FILE: every change of a header pin's level with its time,
    into a VCD file.  gpio record stop: the end of that.  gpio record: does
    one run?"""
    if what and "\n" in what:
        sys.exit("gpio: a file's name in one line")
    m = open_monitor(dev)
    try:
        was = header_record(m)
        if was is False:
            sys.exit(f"[{dev.name}] {RECORD_OLD}")
        if what is None:
            print(f"[{dev.name}] " + (
                f"recording the GPIO header's pins to {was[2]}: "
                f"{changes_text(was[0])} in {was[1] / 1e9:.1f} s so far "
                "(`gpio record stop` ends it)" if was else
                "the GPIO header's pins are not being recorded "
                "(gpio record FILE.vcd)"))
            return 0
        if what.lower() == "stop":
            if not was:
                sys.exit("gpio: nothing is being recorded "
                         "(gpio record FILE.vcd)")
            set_header_record(m, "off")
            print(f"[{dev.name}] the record is {was[2]}: "
                  f"{changes_text(was[0])} in {was[1] / 1e9:.1f} s of the "
                  "Flipper's time (a VCD file, as GTKWave and PulseView open)")
            return 0
        if was:
            sys.exit(f"gpio: it records to {was[2]} already (`gpio record "
                     "stop` ends that)")
        set_header_record(m, os.path.abspath(what))
        print(f"[{dev.name}] recording the GPIO header's pins to {what}: "
              "every change of a level, with its time (`gpio record stop` "
              "ends it)")
        return 0
    finally:
        m.close()


def watch_ends():
    """What ends a watch: Ctrl+C, and the `kill` of a script that started it
    in its background.  There SIGINT comes ignored and SIGTERM would end us
    with our record still running: each is a KeyboardInterrupt from here on."""
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, signal.default_int_handler)


def gpio_watch(dev, pins, words, seconds):
    """gpio watch [PIN,PIN...]: the header's changes as they happen.  They
    are read from the record: its own, in the device's directory, unless one
    runs already."""
    want = [header_pin(pins, w)["pin"]
            for w in re.split(r"[,\s]+", words or "") if w]
    m = open_monitor(dev)
    try:
        was = header_record(m)
        if was is False:
            sys.exit(f"[{dev.name}] {RECORD_OLD}")
        path = pathlib.Path(was[2]) if was else dev.dir / "gpio-watch.vcd"
        if not was:
            set_header_record(m, path)
    finally:
        m.close()
    t0 = was[1] if was else 0           # the record's time as the watch begins
    print(f"[{dev.name}] " + (", ".join(want) if want else "the GPIO header's "
                              "pins") + " as " + ("they change" if len(want) != 1
                                                 else "it changes")
          + (f", for {seconds:g} s" if seconds else "; Ctrl+C ends it")
          + (f" (from the record that runs: {path})" if was else ""),
          flush=True)
    record, since, shown, rest, idle = fe_header.Record(), {}, 0, "", 0.0
    began = time.time()
    try:
        watch_ends()
        with open(path, encoding="ascii") as f:
            while True:
                text = f.read()
                if text:
                    *lines, rest = (rest + text).split("\n")
                    for line in lines:
                        change = record.feed(line)
                        if not change:
                            continue
                        ns, pin, level, before = change
                        if ns >= t0 and (not want or pin in want):
                            print(f"{(ns - t0) / 1e9:12.6f}  {pin:5} {level}"
                                  + (f"  ({before} for "
                                     f"{fe_header.span(ns - since[pin])})"
                                     if pin in since else ""), flush=True)
                            shown += 1
                        since[pin] = ns
                    idle = 0.0
                    continue
                if seconds and time.time() - began >= seconds:
                    break
                time.sleep(0.05)
                idle += 0.05
                if idle >= 1.0:
                    idle = 0.0
                    if not dev.running():
                        print(f"[{dev.name}] it stopped", flush=True)
                        break
    except KeyboardInterrupt:
        print()
    finally:
        if not was:
            try:
                m = open_monitor(dev)
                try:
                    if header_record(m):
                        m.cmd("qom-set /machine header-record off")
                finally:
                    m.close()
            except (SystemExit, OSError):
                pass                    # the emulator is gone, and its record
            path.unlink(missing_ok=True)
    print(f"[{dev.name}] {changes_text(shown)} in {time.time() - began:.1f} s")
    return 0


def cmd_gpio(args):
    dev = Device(args.device)
    levels = {"high": "1", "1": "1", "low": "0", "0": "0", "free": "z"}
    word = (args.pin or "").lower()
    if word not in ("record", "watch") or args.wait:
        level = args.level.lower() if args.level else None
    else:
        level = None
    if args.seconds is not None and (word != "watch" or args.seconds <= 0):
        sys.exit("gpio: --for goes with watch, and is more than 0 seconds: "
                 "gpio watch PA7 --for 5")
    if word == "record" and not args.wait:
        return gpio_record(dev, args.level)
    volts = fe_header.parse_volts(level) if level else None
    if level is not None and level not in levels and volts is None:
        sys.exit(f"gpio: {args.level!r}: a pin is held high or low, or at a "
                 "voltage (1.25V, 1250mV), or let go of (free)")
    if volts is not None and volts > fe_header.VDD_MV:
        sys.exit(f"gpio: {args.level}: a pin is held at 0 to "
                 f"{fe_header.volts(fe_header.VDD_MV)}, which is what the "
                 "chip runs on; its pins are not for more")
    if args.wait and (level or not args.pin or args.pin.lower() == "free"):
        sys.exit("gpio: --wait goes with a pin, and nothing to hold: "
                 "gpio PA7 --wait high")
    if args.timeout <= 0:
        sys.exit("gpio: --timeout is more than 0 seconds")

    ports = bus = adc = spi = None

    def now():
        # (the monitor takes one client at a time: not kept, so that a test
        # can press a button while this waits)
        nonlocal ports, bus, adc, spi
        m = open_monitor(dev)
        try:
            pins = read_header(m)
            ports = read_serial(m)
            bus = read_i2c(m)
            adc = read_adc(m)
            spi = read_spi(m)
        finally:
            m.close()
        if pins is None:
            sys.exit(f"[{dev.name}] this emulator cannot tell of its GPIO "
                     "header: it was started before it could (`stop`, and "
                     "`run` again)")
        return pins

    def hold(words):
        m = open_monitor(dev)
        try:
            err = m.cmd("qom-set /machine header " + ",".join(words)).strip()
        finally:
            m.close()
        if err:
            sys.exit("gpio: " + re.sub(r"^Error: (header: )?", "", err))

    pins = now()
    if word == "watch" and not args.wait:
        return gpio_watch(dev, pins, args.level, args.seconds)
    if args.pin and args.pin.lower() == "free" and level is None:
        held = [p for p in pins if p["held"]]
        if held:
            hold([f"{p['pin']}=z" for p in held])
        print(f"[{dev.name}] nothing is held to the GPIO header"
              + (" any more (it was: " + ", ".join(
                  f"{p['pin']} {fe_header.held_word(p)}" for p in held) + ")"
                 if held else ""))
        return 0
    if not args.pin:
        print(f"[{dev.name}] the GPIO header (1 is +5V, 9 is 3V3; 8, 11 and "
              "18 are GND)")
        wide = max(len(fe_header.mode_text(p)) for p in pins)
        for p in pins:
            note = fe_header.NOT_HELD.get(p["number"], "")
            of = fe_header.port_pin(p, ports)
            if of and not note:
                note = f"{of[0]['name']}'s {of[1]}"
            if fe_header.i2c_pin(p, bus):
                note = f"{bus['name']}'s {fe_header.i2c_pin(p, bus)}"
            if fe_header.spi_pin(p, spi):
                note = f"{spi['name']}'s {fe_header.spi_pin(p, spi)}"
            chip = fe_header.spi_chip(p, spi)
            if chip:
                note = fe_header.spi_chip_text(chip)
            if p["pwm"]:
                note = fe_header.pwm_text(p["pwm"])
            if p["held"]:
                note = (note + "; " if p["pwm"] or chip else "") + fe_header.held_text(p) + (
                    ", which does not show while the firmware drives the pin"
                    if fe_header.overruled(p) else "")
            elif p["label"] in ("SWC", "SIO") and not p["pwm"] and not chip:
                note = f"{p['label']} on the case"
            print(f"  {p['number']:>2}  {p['pin']:5} "
                  f"{fe_header.mode_text(p):{wide}}  {p['level']:8}  {note}".rstrip())
        if ports:
            print("its serial ports, as the firmware has them (`uart` sends "
                  "and reads there)")
            wide = max(len(fe_header.port_name(p)) for p in ports)
            for p in ports:
                print(f"  {fe_header.port_name(p):{wide}}  "
                      f"{fe_header.port_text(p)}")
        if bus:
            print("its I2C bus, SDA on pin 15 and SCL on pin 16 (`run --i2c "
                  "TYPE@ADDRESS` puts a device there)")
            print(f"  {fe_header.i2c_name(bus)}  {fe_header.i2c_text(bus)}")
        if spi:
            print(f"its SPI bus, MOSI on pin {spi['mosi']}, MISO on pin "
                  f"{spi['miso']} and SCK on pin {spi['sck']} (`run --spi "
                  "TYPE@PIN` puts a device there, PIN its chip select)")
            print(f"  {fe_header.spi_name(spi)}  {fe_header.spi_text(spi)}")
        if adc:
            inputs = sorted(fe_header.ADC_PINS.values())
            print("its ADC, with pins " + ", ".join(map(str, inputs[:-1]))
                  + f" and {inputs[-1]} as inputs (`gpio PIN 1.25V` holds a "
                  "voltage to one)")
            print(f"  {adc['name']}  {fe_header.adc_text(adc, pins)}")
        return 0

    p = header_pin(pins, args.pin)
    if args.wait:
        t0 = time.time()
        while p["level"] != args.wait:
            if time.time() - t0 > args.timeout:
                sys.exit(f"[{dev.name}] {p['pin']} {fe_header.level_text(p)}, "
                         f"not {args.wait} after {args.timeout:g} s (the firmware "
                         f"has it as: {fe_header.mode_text(p)}"
                         + (f"; {fe_header.held_text(p)}" if p["held"]
                            else "") + ")")
            time.sleep(0.05)
            p = header_pin(now(), p["pin"])
        print(f"[{dev.name}] {p['pin']} {fe_header.level_text(p)} "
              f"({time.time() - t0:.1f} s)")
        return 0
    if level is None:
        print(p["level"])
        return 0
    if not p["holdable"]:
        sys.exit(f"gpio: {p['pin']} is not a pin to hold; "
                 + fe_header.NOT_HELD.get(p["number"], "it has its own use"))
    hold([f"{p['pin']}=" + (levels[level] if level in levels
                            else f"{volts}mV")])
    p = header_pin(now(), p["pin"])
    print(f"[{dev.name}] {p['pin']} (pin {p['number']} of the header): "
          + (fe_header.held_text(p) if p["held"] else "let go of")
          + f"; it {fe_header.level_text(p)} (the firmware has it as: "
          f"{fe_header.mode_text(p)})"
          + (". The firmware drives it, and what is held to it shows when it "
             "is an input again" if fe_header.overruled(p) else "")
          + (f". {p['pin']} is no input of the ADC's: a voltage there is a "
             "level to the firmware and no more"
             if fe_header.held_word(p) not in (None, "high", "low")
             and not p["adc"] else ""))
    return 0


