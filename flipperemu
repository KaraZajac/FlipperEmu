    n = fe_log.show(path, follow=args.follow, count=args.lines,
                    level=fe_log.LEVELS.get(args.level, ""), pattern=pattern,
                    color={"always": True, "never": False}.get(args.color))
    if n is None:
        sys.exit(f"[{dev.name}] no log" + (" of a run before this one"
                                           if args.previous else
                                           " yet: it has not run"))
    return 0


def sdk_home():
    """ufbt's folder: its SDK, its toolchain, and what it built"""
    return pathlib.Path(os.environ.get("UFBT_HOME") or "~/.ufbt").expanduser()


def source_tree(start=None):
    """The firmware source tree a folder is in (None: it is in none)"""
    here = start or pathlib.Path.cwd()
    for folder in (here, *here.parents):
        if (folder / "fbt").is_file() and (folder / "SConstruct").is_file():
            return folder
    return None


def gdb_stub(m):
    """A running device's gdb stub: (what gdb's `target remote` takes, whether
    a gdb is on it), or None when it has none"""
    for line in m.cmd("info chardev").splitlines():
        hit = re.match(r"gdb: filename=(disconnected:)?(unix|tcp):(.*?),server=on",
                       line.strip())
        if hit:
            free, kind, where = hit.groups()
            if kind == "tcp":
                host, _, port = where.rpartition(":")
                if host in ("", "0.0.0.0", "::", "[::]"):
                    host = "localhost"
                where = f"{host}:{port}"
            return where, not free
    return None


def gdb_open_stub(dev, port=None):
    """-> what `target remote` takes.  The stub of a `run --gdb` is used where
    it is; else one is opened on a socket in the device's folder, or (port)
    on a TCP port of this computer."""
    m = open_monitor(dev)
    try:
        stub = gdb_stub(m)
        if stub and stub[1]:
            sys.exit(f"[{dev.name}] a gdb is on it already (at {stub[0]})")
        want = f"127.0.0.1:{port}" if port else None
        if stub and want in (None, stub[0]):
            return stub[0]
        if stub:
            m.cmd("gdbserver none")     # one stub: it moves
        said = m.cmd(f"gdbserver tcp:{want}" if want else
                     f'gdbserver "unix:{dev.gdb_sock},server=on,wait=off"')
        stub = gdb_stub(m)
        if not stub:
            sys.exit(f"[{dev.name}] no gdb stub: " + " ".join(said.split()))
        return stub[0]
    finally:
        m.close()


def gdb_program(asked, tree):
    """The gdb to run.  The firmware's toolchain has one for this processor
    with Python in it, which the symbols of apps need."""
    if asked:
        found = shutil.which(asked)
        if not found:
            sys.exit(f"flipperemu: no `{asked}`")
        return found
    name = "arm-none-eabi-gdb-py3"
    for home in (os.environ.get("FBT_TOOLCHAIN_PATH"), tree, sdk_home()):
        if not home:
            continue
        base = pathlib.Path(home).expanduser() / "toolchain"
        for gdb in (base / "current" / "bin" / name, *sorted(base.glob(f"*/bin/{name}"))):
            if os.access(gdb, os.X_OK):
                return str(gdb)
    for name in (name, "arm-none-eabi-gdb", "gdb-multiarch", "gdb"):
        found = shutil.which(name)
        if found:
            return found
    sys.exit("flipperemu: no gdb.  The firmware's toolchain has one, which ufbt "
             "gets (`pipx install ufbt`, then `ufbt update`); or your system's "
             "gdb-multiarch")


def gdb_has_python(gdb):
    try:
        out = subprocess.run([gdb, "-nx", "-batch", "-ex", "python print(6 * 7)"],
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "42" in out


def flash_has(dev, elf):
    """Is what this ELF loads what the device's flash holds?"""
    try:
        with open(dev.flash, "rb") as flash:
            for addr, data in parse_elf(elf.read_bytes()):
                flash.seek(addr - FLASH_BASE)
                if flash.read(len(data)) != data:
                    return False
        return True
    except (OSError, ValueError, struct.error):
        return False


def gdb_firmware(dev, asked):
    """-> (the firmware's ELF or None, the folder to look for its source tree
    from).  Not asked for: the first of what was flashed, an ELF beside the
    package that was flashed (the update server has one for each build, and
    scripts/fetch_firmware.py puts it there), a build in the source tree we
    are in, and ufbt's SDK whose contents are in the flash: an update on the
    device itself leaves the others behind."""
    if asked:
        elf = pathlib.Path(asked).resolve()
        if not elf.is_file():
            sys.exit(f"flipperemu: no {asked}")
        if not flash_has(dev, elf):
            print(f"[{dev.name}] {asked} is not what its flash holds: what gdb "
                  "says of the firmware may be off")
        return elf, elf.parent
    source = dev.info().get("source") or ""
    flashed = pathlib.Path(source) if source.endswith(".elf") else None
    beside = sorted(pathlib.Path(source).parent.glob("*.elf")) if source else []
    tree = source_tree()
    for elf, origin in ((flashed, flashed),
                        (dev.elf, flashed),
                        *((elf, None) for elf in beside),
                        (tree and tree / "build" / "latest" / "firmware.elf", None),
                        (sdk_home() / "current" / "firmware.elf", None)):
        if elf and elf.is_file() and flash_has(dev, elf):
            elf = elf.resolve()
            return elf, (origin or elf).parent
    return None, None


STOCK_SYMBOLS = "appsymbols"    # beside a firmware's ELF: its apps' debug ELFs


def gdb_kit(elf, origin, apps):
    """What reads the symbols of apps: (the firmware's gdb script, which is
    in its source tree or in ufbt's SDK; the folders the apps' debug ELFs are
    looked for in, the last one first).  The stock apps' are beside the
    firmware's ELF, where the update server's archive of them was unpacked
    (scripts/fetch_firmware.py does that); the others are what fbt or ufbt
    built, or what `--apps` names."""
    tree = source_tree(origin)
    if tree and (tree / "scripts" / "debug" / "flipperapps.py").is_file():
        kit, built = tree / "scripts" / "debug", origin / ".extapps"
    else:
        kit, built = sdk_home() / "current" / "scripts" / "debug", sdk_home() / "build"
    script = kit / "flipperapps.py"
    built = pathlib.Path(apps).resolve() if apps else built
    stock = (origin / STOCK_SYMBOLS).resolve()
    return (script if script.is_file() else None,
            [stock, built] if stock.is_dir() and stock != built else [built])


VSCODE_PORT = 3333      # the stub's, for `gdb --vscode` without a `--serve`


def jsonc_plain(text):
    """A file of VS Code's, which may have comments and a comma before a
    closing bracket -> the same text with blanks in their place and every
    other character where it was: JSON, if the file is sound"""
    out = list(text)
    i, n, last = 0, len(text), None
    while i < n:
        c = text[i]
        if c == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
            last = i
        elif text.startswith(("//", "/*"), i):
            if text[i + 1] == "/":
                j = text.find("\n", i)
                j = n if j < 0 else j
            else:
                j = text.find("*/", i + 2)
                j = n if j < 0 else j + 2
            for k in range(i, j):
                if out[k] != "\n":
                    out[k] = " "
            i = j
            continue
        elif not c.isspace():
            if c in "}]" and last is not None and text[last] == ",":
                out[last] = " "
            last = i
        i += 1
    return "".join(out)


def launch_spans(plain):
    """Where the debug configurations are in a launch.json that has no
    comments any more: (the place after the '[' of its "configurations",
    [(start, end) of each]), or None when it has no such list"""
    i, n, depth = 0, len(plain), 0
    key = 0                 # 1: "configurations" was read, 2: and its colon
    inside = first = start = None
    spans = []
    while i < n:
        c = plain[i]
        if c == '"':
            j = i + 1
            while j < n and plain[j] != '"':
                j += 2 if plain[j] == "\\" else 1
            key = 1 if (inside is None and depth == 1
                        and plain[i + 1:j] == "configurations") else 0
            i = j
        elif c in "{[":
            depth += 1
            if inside is None and key == 2 and c == "[":
                inside, first = depth, i + 1
            elif inside is not None and depth == inside + 1 and c == "{":
                start = i
            key = 0
        elif c in "}]":
            depth -= 1
            if inside is not None and depth == inside and start is not None:
                spans.append((start, i + 1))
                start = None
            elif inside is not None and depth < inside:
                return first, spans
        elif c == ":" and key == 1:
            key = 2
        elif not c.isspace():
            key = 0
        i += 1
    return None


def vscode_put(text, name, block):
    """A launch.json's text with a debug configuration in it, in the place of
    the one of that name or after the last one: (the text, how it got there),
    or (None, None) when the file is no launch.json.  All else in the file
    stays as it is, its comments too: the launch.json that `ufbt vscode_dist`
    writes has some, and commas that JSON does not take."""
    def named(piece):
        try:
            return json.loads(piece).get("name")
        except (ValueError, AttributeError):
            return None

    plain = jsonc_plain(text)
    found = launch_spans(plain)
    if not found:
        return None, None
    first, spans = found
    ours = [span for span in spans if named(plain[span[0]:span[1]]) == name]
    if ours:
        a, b = ours[0]
        new, how = text[:a] + block.lstrip() + text[b:], "is as of now"
    elif spans:
        b = spans[-1][1]
        new, how = text[:b] + ",\n" + block + text[b:], "added"
    else:
        new, how = text[:first] + "\n" + block + "\n    " + text[first:], "added"
    # (a file that VS Code could not read is never written)
    try:
        configs = json.loads(jsonc_plain(new))["configurations"]
        if name not in [c.get("name") for c in configs if isinstance(c, dict)]:
            return None, None
    except (ValueError, KeyError, TypeError):
        return None, None
    return new, how


def vscode_launch(dev, gdb, elf, port, kit=None):
    """`gdb --vscode`: a debug configuration for VS Code in the folder we are
    in, for the Cortex-Debug extension (the one ufbt's own configurations are
    for).  The extension names the ELF and the stub to its gdb, and the
    device's gdb-ide.init is the rest of what `./flipperemu gdb` sets up."""
    if not elf:
        print(f"[{dev.name}] no configuration for VS Code without the "
              "firmware's ELF")
        return 1
    gdb = os.path.abspath(gdb)
    name = f"FlipperEmu ({dev.name})"
    config = {"name": name, "type": "cortex-debug", "request": "attach",
              "servertype": "external", "gdbTarget": f"localhost:{port}",
              "executable": str(elf), "gdbPath": gdb,
              "cwd": "${workspaceFolder}",
              "postAttachCommands": [f"source {dev.gdb_ide}"]}
    tools = pathlib.Path(gdb).parent
    if (tools / "arm-none-eabi-objdump").is_file():
        config["armToolchainPath"] = str(tools)     # (it reads the ELF with them)
    svd = kit / "STM32WB55_CM4.svd" if kit else None
    if svd and svd.is_file():
        config["svdFile"] = str(svd)                # (its view of the peripherals)
    block = "\n".join(" " * 8 + line for line in json.dumps(
        config, indent=4, ensure_ascii=False).splitlines())
    path = pathlib.Path(".vscode") / "launch.json"
    again = (f"[{dev.name}] Once more after the device was started again, or "
             "has another firmware: the stub and the ELF are those of now")
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        text = None
    except (OSError, UnicodeDecodeError) as e:
        sys.exit(f"flipperemu: {path}: {e}")
    if text is None:
        new, how = ('{\n    "version": "0.2.0",\n    "configurations": [\n'
                    + block + "\n    ]\n}\n"), "is there"
    else:
        new, how = vscode_put(text, name, block)
    if new is None:
        print(f"[{dev.name}] {path} is no launch.json that this can add to, and "
              "is left as it is.  For the Cortex-Debug extension, among its "
              '"configurations":\n' + block)
        print(again)
        return 0
    path.parent.mkdir(exist_ok=True)
    path.write_text(new, encoding="utf-8")
    print(f'[{dev.name}] {path}: "{name}" {how}, for the Cortex-Debug '
          "extension: open this folder in VS Code, and Run and Debug has it "
          "(F5)")
    print(again)
    return 0


def cmd_gdb(args):
    """gdb on a running device.  Its stub is asked of the emulator when it is
    wanted, on a socket in the device's folder: nothing has to be decided when
    the device is started, and two devices do not meet on a port."""
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] is not running: `./flipperemu -d {dev.name} run` "
                 "starts it (`run --wait-gdb`: and has it wait for gdb at its "
                 "first instruction)")
    if args.vscode and not args.serve:
        args.serve = VSCODE_PORT
    target = gdb_open_stub(dev, args.serve)
    elf, origin = gdb_firmware(dev, args.elf)
    gdb = gdb_program(args.program, source_tree(origin) if origin else None)
    lines = [f"# what `./flipperemu -d {dev.name} gdb` tells gdb: written each time",
             "set breakpoint pending on"]
    if elf:
        lines.append(f'file "{elf}"')
        print(f"[{dev.name}] the firmware's symbols: {elf}")
    else:
        print(f"[{dev.name}] no ELF of the firmware in its flash: no symbols.  "
              "A firmware flashed from an .elf has them, and so has the "
              "official release ufbt's SDK is of; --elf FILE names another")
    lines.append(f"target remote {target}")
    script = None
    if not gdb_has_python(gdb):
        print(f"[{dev.name}] {gdb} has no Python: no symbols of apps, and "
              "nothing said at a crash")
    else:
        script, apps = gdb_kit(elf, origin, args.apps) if elf else (None, [])
        if script:
            print(f"[{dev.name}] apps' symbols, as they start: from {apps[-1]}"
                  + (f", and the stock apps' from {apps[0]}" if len(apps) > 1
                     else ""))
        elif elf:
            # (said, or a breakpoint in an app stays pending with no reason
            # to be seen)
            print(f"[{dev.name}] no symbols of apps: the script that reads "
                  f"them comes with ufbt's SDK, and {sdk_home()} has none "
                  "(`ufbt update` fetches it; UFBT_HOME names another place)")
        about = {"fapscript": str(script or ""), "apps": [str(a) for a in apps],
                 "links": str(dev.gdb_apps), "name": dev.name}
        lines += [f"python FLIPPEREMU_GDB = {about!r}",
                  f"source {ROOT / 'scripts' / 'fe_gdb.py'}"]
    dev.gdb_init.write_text("\n".join(lines) + "\n")
    # (an IDE names the ELF and the stub to its gdb itself: the rest, to be
    # sourced by a gdb that is on the device)
    dev.gdb_ide.write_text("\n".join(
        ["# for a gdb that an IDE has put on the device: the rest of gdb.init"]
        + [line for line in lines[1:]
           if not line.startswith(("file ", "target remote "))]) + "\n")
    cmd = [gdb, "-q", "-x", str(dev.gdb_init), *args.gdb_args]
    if args.serve:
        print(f"[{dev.name}] its gdb stub is on localhost:{args.serve}, for an IDE "
              f"(`target remote localhost:{args.serve}`), or with all of the "
              "above:\n    " + shlex.join(cmd))
        if args.vscode:
            return vscode_launch(dev, gdb, elf, args.serve,
                                 script.parent if script else None)
        return 0
    # Ctrl-C in gdb's terminal reaches us too, and is gdb's to take
    ours = signal.signal(signal.SIGINT, lambda *_: None)
    sys.stdout.flush()
    try:
        code = subprocess.call(cmd)
    finally:
        signal.signal(signal.SIGINT, ours)
    if dev.running():
        # a gdb that leaves lets go, and the firmware runs on; one that died
        # does not
        m = open_monitor(dev)
        try:
            if "paused" in m.cmd("info status"):
                m.cmd("cont")
                print(f"[{dev.name}] gdb left it stopped: it runs again")
        finally:
            m.close()
    return code if code >= 0 else 128 - code    # ended by a signal: as a shell has it


def usb_serial(dev):
    """A running device's USB serial port: (the chardev it is bridged to, why
    no CLI can be had on it: None when one can)"""
    from fe_cli import usb_endpoint
    m = open_monitor(dev)
    try:
        still = stopped(m)
        ep = usb_endpoint(m)
        usb = read_usb(m)
        end = time.monotonic() + 10         # just started: the PC finds it soon
        while (not still and ep and usb["cable"] == "computer"
               and time.monotonic() < end
               and usb["device"] in ("none", "enumerating")):
            time.sleep(0.2)
            usb = read_usb(m)
    finally:
        m.close()
    seen = usb["device"] or ""
    why = None
    if not ep:
        why = "it was started with --usb none"
    elif still:
        why = still_text(dev, still)
    elif usb["cable"] != "computer":
        why = (f"its USB port is {usb_text(usb)}; `./flipperemu -d {dev.name} "
               "usb plug` plugs it into the computer")
    elif seen == "usbip":
        why = ("a PC has its USB port over USB/IP (run --usbip), and its "
               "serial port with it")
    elif "CDC ACM" not in seen:
        why = f"it is {usb_text(usb)}, and that is no serial port"
        if seen not in ("none", "enumerating", "failed"):
            why += " (an app on the Flipper has USB: leaving it gives the port back)"
        elif seen == "none":
            why += (" (an app on the Flipper may have switched the port off, "
                    "as Bad USB does: leaving it gives the port back)")
    return ep, why


CUT_WAIT = 1.5      # s for a prompt, after a command that was cut off


def open_cli(dev, prompt=True, timeout=15.0):
    """The CLI on a running device's USB serial port (an fe_cli.FlipperCli, at
    its prompt), or an exit that says why there is none.  The port is one line:
    our commands take turns at it (usb.lock)."""
    from fe_cli import FlipperCli
    ep, why = usb_serial(dev)
    if why:
        sys.exit(f"[{dev.name}] no CLI: {why}")
    halt = firmware_halt(dev)
    if halt:
        what, todo = halt_text(dev, halt)
        sys.exit(f"[{dev.name}] no CLI: the firmware {what}.  {todo}")
    cli = FlipperCli(ep, lock=dev.dir / "usb.lock")
    cli.gone = lambda: firmware_halt(dev)
    waited = 0.0
    if cli.cut:
        # Whoever had the port before was killed in the middle.  A firmware
        # that ends a command when the port closes prompts at once; an old
        # one may need Ctrl-C first (fe_cli.end_cut_off).
        began = time.time()
        left = cli.end_cut_off(min(CUT_WAIT, timeout))
        waited = time.time() - began
        if left is not None:
            sent, typed = left
            if typed:
                shown = typed.decode("latin-1")[:40]
                print(f"[{dev.name}] {cli.cut} was cut off in the middle, and "
                      f"the last of what it was sending ({shown!r}) was left "
                      "typed at the firmware's prompt: Ctrl-C cleared it.",
                      file=sys.stderr)
            elif sent:
                print(f"[{dev.name}] {cli.cut} was cut off in the middle, and "
                      "the firmware's CLI still waited for the rest of what "
                      f"it was to be sent: it got Ctrl-C ({sent} of them) "
                      "until it answered again.  If it was writing a file, "
                      "those are at its end.", file=sys.stderr)
            if prompt:
                cli.buf = b""
            elif sent:
                cli.buf = b"\r\n>: "       # (for the terminal to show)
            return cli
    if prompt:
        try:
            cli.read_until_prompt(
                max(1.0, timeout - waited),
                "no CLI prompt (is the firmware's CLI over USB enabled, and "
                "not still at a command that was cut off?  "
                f"`./flipperemu -d {dev.name} reset` starts the firmware "
                "again)")
        except TimeoutError as e:
            cli.close()
            sys.exit(f"[{dev.name}] {e}")
    return cli


# The serial ports of the GPIO header: (the chardev's name, its pins, what
# the chip calls it), and the chardev of the launcher's own end of each
UART_PORTS = {"lpuart": ("lpuart-user", "15 and 16", "LPUART1"),
              "usart": ("uart-user", "13 and 14", "USART1")}
UART_OWN = {"lpuart": "lpuart-own", "usart": "uart-own"}


def uart_state(dev, port):
    """How the firmware has a port just now (a dict of
    fe_header.parse_serial), or None from an emulator that cannot tell"""
    m = open_monitor(dev)
    try:
        ports = read_serial(m)
    finally:
        m.close()
    return next((p for p in ports or () if p["name"] == UART_PORTS[port][2]),
                None)


def uart_deaf(state):
    """Why the firmware hears nothing on a port, or None: it does (if only
    a call, on a pin that it waits at), or the emulator cannot tell"""
    if state and state["hears"] == "edge":
        return None
    if state and not state["on"]:
        return f"nothing in the firmware has the port open ({state['name']} is off)"
    if state and state["hears"] == "off":
        return (f"the firmware does not listen there ({state['name']}'s "
                "receiver is off)")
    return None


def uart_link(dev, port):
    return dev.lpuart_tty if port == "lpuart" else dev.usart_tty


def uart_log(dev, port):
    """The file that has what the firmware sent on that port, this run"""
    return dev.lpuart_log if port == "lpuart" else dev.uart


def uart_where(dev, port, at):
    """Where a serial port of the header goes, in words"""
    if not at:
        return ("nowhere (started with --lpuart none)" if port == "lpuart"
                else "as QEMU was told with --serial")
    kind, where = at
    if kind == "pty":
        link = uart_link(dev, port)
        return f"{where}" + (f" (also {link})" if link.is_symlink() else "")
    if kind == "tcp":
        return f"TCP port {where[1]} of {where[0]}"
    return {"stdio": "the terminal it was started in", "file": "a file",
            "null": "nowhere"}.get(kind, kind)


UART_ESCAPES = {b"r": b"\r", b"n": b"\n", b"t": b"\t", b"0": b"\0",
                b"e": b"\x1b", b"\\": b"\\"}


def uart_bytes(text, as_hex=False):
    """What `uart send` writes: text, with \\r \\n \\t \\0 \\e \\xNN \\\\ for
    what cannot be typed (any other \\ stays as it is), or bytes in hex"""
    if as_hex:
        try:
            return bytes.fromhex(text)
        except ValueError:
            sys.exit(f"uart: {text!r} is not bytes in hex (as in: 0d 0a ff)")

    def one(m):
        code = m.group(1)
        return (bytes([int(code[1:], 16)]) if code[:1] == b"x"
                else UART_ESCAPES[code])
    return re.sub(rb"\\(x[0-9a-fA-F]{2}|[rnt0e\\])", one, text.encode())


def uart_mark_file(dev, port):
    return dev.dir / f"{port}.mark"


def uart_mark(dev, port):
    """How far `uart wait` and `uart send --expect` have read in what the
    firmware sent this run: what one of them found is not found again, so a
    "ready" from an earlier turn of a loop does not answer the next wait"""
    try:
        mark = int(uart_mark_file(dev, port).read_text())
        return mark if 0 <= mark <= uart_log(dev, port).stat().st_size else 0
    except (OSError, ValueError):
        return 0


def uart_drop(line):
    """Read away what the firmware sent to our end of a port: it is in the
    port's log, and unread it holds the firmware's sending up (a few hundred
    bytes fill a socket that is written a byte at a time)"""
    import select
    try:
        while select.select([line.fd], [], [], 0)[0] and line.sock.recv(65536):
            pass
    except OSError:
        pass


def uart_put(line, data, seconds):
    """Send on our end of a port, and stay until the emulator has taken all
    of it: it takes a byte when the firmware has read the one before and
    the port's speed lets the next one in, and what it has not taken when
    our end closes is lost.  `seconds` is how long nothing may move: a
    long text at 1200 baud takes its time.  -> whether it took all of it"""
    import fcntl
    import select
    import termios
    # The socket counts a piece as unread until its last byte is taken, so
    # the pieces are small: at 300 baud one is gone in half a second.
    piece = 16
    sent = 0
    unread = None
    moved = time.monotonic()
    line.sock.setblocking(False)
    while time.monotonic() - moved < seconds:
        uart_drop(line)
        if sent < len(data) and select.select([], [line.fd], [], 0)[1]:
            try:
                sent += line.sock.send(data[sent:sent + piece])
                moved = time.monotonic()
                continue
            except BlockingIOError:
                pass
        left = struct.unpack("i", fcntl.ioctl(line.fd, termios.TIOCOUTQ,
                                              bytes(4)))[0]
        if sent >= len(data) and not left:
            return True
        if left != unread:
            unread, moved = left, time.monotonic()
        time.sleep(0.002)
    return False


def uart_seen(dev, port, start, want, seconds, line=None):
    """Wait for bytes in what the firmware sent (the port's log, from
    `start` on): (whether they came, all that came). When they came, the
    mark moves behind them."""
    end = time.monotonic() + seconds
    while True:
        if line:
            uart_drop(line)
        try:
            with open(uart_log(dev, port), "rb") as f:
                f.seek(start)
                data = f.read()
        except FileNotFoundError:
            data = b""
        at = data.find(want)
        if at >= 0:
            try:
                uart_mark_file(dev, port).write_text(
                    f"{start + at + len(want)}\n")
            except OSError:
                pass
            return True, data
        if time.monotonic() >= end:
            return False, data
        time.sleep(0.02)


def cmd_uart(args):
    from fe_cli import FlipperCli, PortBusy, leave_port, take_port, usb_endpoint
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        ports = {port: usb_endpoint(m, UART_PORTS[port][0]) for port in UART_PORTS}
        own = usb_endpoint(m, UART_OWN[args.port])
        states = {p["name"]: p for p in read_serial(m) or ()}
    finally:
        m.close()
    if not args.action:
        for port in ("lpuart", "usart"):
            _, pins, chip = UART_PORTS[port]
            log = uart_log(dev, port)
            print(f"[{dev.name}] pins {pins} ({chip}): "
                  f"{uart_where(dev, port, ports[port])}"
                  + (f"; what the firmware sent there: {log}"
                     if log.exists() else ""))
            if chip in states:
                print(f"[{dev.name}]   the firmware has it as: "
                      f"{fe_header.port_text(states[chip])}")
        return 0
    port, at = args.port, ports[args.port]
    _, pins, chip = UART_PORTS[port]
    log = uart_log(dev, port)
    if args.seconds <= 0:
        sys.exit("uart: --for is more than 0 seconds")
    if args.action == "wait":
        if not args.text:
            sys.exit("uart wait: for what?  uart wait \"ready\"")
        want = uart_bytes(" ".join(args.text), args.hex)
        seen, came = uart_seen(dev, port, uart_mark(dev, port), want,
                               args.seconds)
        text = came.decode(errors="replace")
        print(text, end="" if text.endswith("\n") or not text else "\n")
        if not seen:
            print(f"[{dev.name}] pins {pins}: {' '.join(args.text)!r} did not "
                  f"come in {args.seconds:g} s", file=sys.stderr)
        return 0 if seen else 1
    if not own and port == "lpuart":
        sys.exit(f"[{dev.name}] pins {pins} ({chip}) go nowhere: `uart "
                 f"{args.action}` needs a run without --lpuart none")
    if not own:
        sys.exit(f"[{dev.name}] pins {pins} ({chip}) are as QEMU was told "
                 f"with --serial: `uart {args.action}` needs a run with "
                 "--serial stdio, pty, null, tcp:PORT or file:PATH")
    if args.action == "term" and args.text:
        sys.exit("uart term takes no more words")
    if args.action == "send" and not args.text:
        sys.exit("uart send: what?  uart send \"hello\\r\\n\"")
    try:
        lock = take_port(dev.dir / f"{port}.lock", 5.0, f"pins {pins} are")
    except PortBusy as e:
        sys.exit(f"[{dev.name}] {e}")
    line = None
    try:
        try:
            line = FlipperCli(own)
        except OSError as e:
            sys.exit(f"[{dev.name}] pins {pins}: {e}")
        if args.action == "term":
            print(f"[{dev.name}] pins {pins} ({chip}); Ctrl-] quits")
            line.interactive(newline=None)
            return 0
        data = uart_bytes(" ".join(args.text), args.hex)
        want = uart_bytes(args.expect) if args.expect else None
        try:
            start = log.stat().st_size
        except OSError:
            start = 0
        deaf = uart_deaf(states.get(chip))
        called = states.get(chip, {}).get("hears") == "edge"
        if not uart_put(line, data, args.seconds):
            state = uart_state(dev, port)
            print(f"[{dev.name}] pins {pins}: "
                  + (f"{chip}'s receiver is on, but nothing in the firmware "
                     "takes its bytes (neither an interrupt nor the DMA is set "
                     "up for them)" if state and state["hears"] == "unread"
                     else "the firmware has the port open, but did not read "
                          "all of that")
                  + ": the rest is lost", file=sys.stderr)
            return 1
        # (said when it was so before and after: an app that opens the port
        # in between has heard a part of it)
        if deaf and deaf == uart_deaf(uart_state(dev, port)):
            print(f"[{dev.name}] pins {pins}: {deaf}: that was sent, and "
                  "nobody heard it", file=sys.stderr)
        # (the firmware's expansion service waits so: the start bit of the
        # first byte is the short low level a module calls it with)
        if called:
            print(f"[{dev.name}] pins {pins}: {chip}'s receiver was off, and "
                  f"the firmware waited for a call on pin {states[chip]['rx']}"
                  ": it took that as one, as from an expansion module, and "
                  "read none of it as text (`expansion` is a module that "
                  "goes on from there)", file=sys.stderr)
        if want is None:
            return 0
        seen, came = uart_seen(dev, port, start, want, args.seconds, line)
        text = came.decode(errors="replace")
        print(text, end="" if text.endswith("\n") or not text else "\n")
        if not seen:
            print(f"[{dev.name}] pins {pins}: {args.expect!r} did not come in "
                  f"{args.seconds:g} s", file=sys.stderr)
        return 0 if seen else 1
    finally:
        if line:
            line.close()
        leave_port(lock)


I2C_RECORD_OLD = ("this emulator cannot record its I2C bus: it was started "
                  "before it could (`stop`, and `run` again)")


def i2c_recording(m):
    """The record of the header's I2C bus that runs
    (fe_header.parse_i2c_record).  None: none runs.  False: an emulator that
    cannot record."""
    text = qom_get(m, "/machine", "header-i2c-record")
    if not isinstance(text, str):
        return False
    return fe_header.parse_i2c_record(text)


def set_i2c_record(m, value):
    err = m.cmd(f"qom-set /machine header-i2c-record {value}").strip()
    if err:
        sys.exit("i2c: " + re.sub(r"^Error: (header-i2c-record: )?", "", err))


def i2c_record(dev, what):
    """i2c record FILE: every transfer on the header's I2C bus, into a text
    file: the address called, the bytes written and read.  i2c record stop:
    the end of that.  i2c record: does one run?"""
    if what and "\n" in what:
        sys.exit("i2c: a file's name in one line")
    m = open_monitor(dev)
    try:
        was = i2c_recording(m)
        if was is False:
            sys.exit(f"[{dev.name}] {I2C_RECORD_OLD}")
        so_far = was and (f"{fe_header.i2c_recorded(was)} in "
                          f"{was['ns'] / 1e9:.1f} s")
        if what is None:
            print(f"[{dev.name}] " + (
                f"recording the header's I2C bus to {was['path']}: {so_far} "
                "so far (`i2c record stop` ends it)" if was else
                "the header's I2C bus is not being recorded "
                "(i2c record FILE)"))
            return 0
        if what.lower() == "stop":
            if not was:
                sys.exit("i2c: nothing is being recorded (i2c record FILE)")
            set_i2c_record(m, "off")
            print(f"[{dev.name}] the record is {was['path']}: {so_far} of "
                  "the Flipper's time (a text file, a line for each START)")
            return 0
        if was:
            sys.exit(f"i2c: it records to {was['path']} already (`i2c "
                     "record stop` ends that)")
        set_i2c_record(m, os.path.abspath(what))
        print(f"[{dev.name}] recording the header's I2C bus to {what}: "
              "every address called, with the bytes written and read (`i2c "
              "record stop` ends it)")
        return 0
    finally:
        m.close()


def i2c_watch(dev, word, seconds):
    """i2c watch [ADDRESS]: what the firmware does on the header's I2C bus,
    as it happens.  It is read from the record: its own, in the device's
    directory, unless one runs already."""
    only = None
    if word is not None:
        if not re.fullmatch(r"0[xX][0-9a-fA-F]{1,2}", word):
            sys.exit(f"i2c watch {word}: an address is as 0x48 (seven bits, "
                     "in hex)")
        only = int(word, 16)
    m = open_monitor(dev)
    try:
        was = i2c_recording(m)
        if was is False:
            sys.exit(f"[{dev.name}] {I2C_RECORD_OLD}")
        bus = read_i2c(m)
        path = (pathlib.Path(was["path"]) if was
                else dev.dir / "i2c-watch.txt")
        if not was:
            set_i2c_record(m, path)
    finally:
        m.close()
    there = {d["address"]: d["type"] for d in bus["devices"]}
    wide = max(map(len, there.values()), default=0)
    t0 = was["ns"] if was else 0        # the record's time as the watch begins
    print(f"[{dev.name}] " + (
        f"the calls to 0x{only:02x} on the header's I2C bus"
        if only is not None else "the header's I2C bus")
          + " as the firmware talks there (on it: "
          f"{fe_header.i2c_devices(bus)})"
          + (f", for {seconds:g} s" if seconds else "; Ctrl+C ends it")
          + (f" (from the record that runs: {path})" if was else ""),
          flush=True)
    shown, rest, idle, before, told = 0, "", 0.0, None, set()
    began = time.time()
    try:
        watch_ends()
        with open(path, encoding="ascii") as f:
            while True:
                text = f.read()
                if text:
                    *lines, rest = (rest + text).split("\n")
                    for line in lines:
                        part = fe_header.i2c_part(line)
                        if not part:
                            continue
                        at, last, before = part["address"], before, part
                        if part["ns"] < t0 or only not in (None, at):
                            continue
                        print(f"{(part['ns'] - t0) / 1e9:12.6f}  0x{at:02x}  "
                              + (f"{there.get(at, ''):{wide}}  " if wide else "")
                              + fe_header.i2c_part_text(part), flush=True)
                        shown += 1
                        # (a scan calls every address: no word on each)
                        hint = None if part["taken"] or at in told or (
                            last and abs(last["address"] - at) == 1
                        ) else fe_header.i2c_shifted(at, bus["devices"])
                        if hint:
                            told.add(at)
                            print(f"{'':14}{hint}", flush=True)
                    idle = 0.0
                    continue
                if seconds and time.time() - began >= seconds:
                    break
                time.sleep(0.05)
                idle += 0.05
                if idle >= 1.0:
                    idle = 0.0
                    if not dev.running():
                        print(f"[{dev.name}] it stopped", flush=True)
                        break
    except KeyboardInterrupt:
        print()
    finally:
        if not was:
            try:
                m = open_monitor(dev)
                try:
                    if i2c_recording(m):
                        m.cmd("qom-set /machine header-i2c-record off")
                finally:
                    m.close()
            except (SystemExit, OSError):
                pass                    # the emulator is gone, and its record
            path.unlink(missing_ok=True)
    print(f"[{dev.name}] {shown} START{'' if shown == 1 else 's'} in "
          f"{time.time() - began:.1f} s")
    return 0


def cmd_i2c(args):
    """The I2C bus of a running device's GPIO header: the devices on it with
    their values, and what the firmware called there; a device's values; one
    value (bare, for a script); or set one.  --json: the bus, or a device,
    for a program.  record, watch: every transfer, into a file or as it
    happens."""
    dev = Device(args.device)
    word = (args.address or "").lower()
    if args.seconds is not None and (word != "watch" or args.seconds <= 0):
        sys.exit("i2c: --for goes with watch, and is more than 0 seconds: "
                 "i2c watch --for 5")
    if word in ("record", "watch"):
        if args.json:
            sys.exit(f"i2c {word}: not with --json (the record is a text "
                     "file, a line for each START)")
        if args.value is not None:
            sys.exit("i2c record: a file, or `stop`" if word == "record" else
                     "i2c watch: one address, or none: i2c watch 0x48")
        if word == "record":
            return i2c_record(dev, args.prop)
        return i2c_watch(dev, args.prop, args.seconds)
    if args.json and args.prop is not None:
        sys.exit("i2c --json: the bus, or a device (`i2c --json 0x48`); one "
                 "value comes bare without it (`i2c 0x48 temperature`)")
    address = None
    if args.address is not None:
        if not re.fullmatch(r"0[xX][0-9a-fA-F]{1,2}", args.address):
            sys.exit(f"i2c {args.address}: an address is as 0x48 (seven "
                     "bits, in hex)")
        address = int(args.address, 16)
    if args.prop is not None and not re.fullmatch(
            r"[A-Za-z0-9][A-Za-z0-9_.\[\]-]*", args.prop):
        sys.exit(f"i2c: '{args.prop}' is no name of a value")
    m = open_monitor(dev)
    try:
        bus = read_i2c(m)
        if not bus:
            sys.exit(f"[{dev.name}] this emulator cannot tell what is on the "
                     "header's I2C bus: `i2c` needs one that is built from "
                     "this tree as it is now (scripts/setup_qemu.sh)")
        there = {d["address"]: d["type"] for d in bus["devices"]}
        wide = max(map(len, there.values()), default=0)

        def line(at):
            d = i2c_device(dev, m, there[at], at)
            values = ", ".join(fe_header.i2c_value(d, name)
                               for name in d["values"])
            return (f"[{dev.name}]   0x{at:02x}  {there[at]:{wide}}  "
                    f"{values}").rstrip()

        if args.json and (address is None or address in there):
            print(json.dumps(
                dict(bus, devices=[i2c_device(dev, m, there[at], at)
                                   for at in there])
                if address is None else
                i2c_device(dev, m, there[address], address),
                indent=2, ensure_ascii=False))
            return 0
        if address is None:
            print(f"[{dev.name}] {fe_header.i2c_name(bus)}: "
                  f"{fe_header.i2c_text(bus)}")
            hint = fe_header.i2c_hint(bus)
            if hint:
                print(f"[{dev.name}]   ({hint})")
            for at in there:
                print(line(at))
            if not there:
                print(f"[{dev.name}]   (`run --i2c TYPE@ADDRESS` puts a "
                      "device there, as --i2c tmp105@0x48)")
            return 0
        if address not in there:
            print(f"[{dev.name}] nothing is at 0x{address:02x} of the "
                  "header's I2C bus (on it: "
                  f"{fe_header.i2c_devices(bus)})", file=sys.stderr)
            return 1
        kind = f"{there[address]} at 0x{address:02x}"
        own = i2c_own(m, address)
        if args.prop is None:
            print(line(address))
            return 0
        if args.prop not in own:
            print(f"[{dev.name}] {kind} has no '{args.prop}' (it has: "
                  f"{', '.join(own) or 'no value of its own'})",
                  file=sys.stderr)
            return 1
        if args.value is None:
            print(i2c_value(m, address, args.prop, unit=False))
            return 0
        why = i2c_put(m, address, args.prop, args.value)
        if why:
            print(f"[{dev.name}] {kind} did not take {args.prop} "
                  f"{args.value}: {why}", file=sys.stderr)
            return 1
        print(f"[{dev.name}] {kind}: {args.prop} "
              f"{i2c_value(m, address, args.prop)}")
        return 0
    finally:
        m.close()


def cmd_expansion(args):
    """Be an expansion module on a serial port of the header, as far as the
    firmware's expansion service can tell: the call, the baud rate,
    heartbeats, and with --rpc a session that a ping goes through.  Every
    frame is printed with its time (this computer's, from the call on)."""
    import select
    import fe_expansion as x
    from fe_cli import FlipperCli, PortBusy, leave_port, take_port, usb_endpoint
    dev = Device(args.device)
    if args.seconds < 0:
        sys.exit("expansion: --for is 0 seconds or more")
    if not 0 < args.baud < 1 << 32:
        sys.exit("expansion: --baud is a baud rate, as 115200")

    def look():
        m = open_monitor(dev)
        try:
            return ({p["name"]: p for p in read_serial(m) or ()},
                    {port: usb_endpoint(m, UART_OWN[port])
                     for port in UART_PORTS})
        finally:
            m.close()

    def waiting(states):
        return [port for port in ("usart", "lpuart")
                if states.get(UART_PORTS[port][2], {}).get("hears") == "edge"]

    # The port that the firmware waits on.  It may be a moment until it does:
    # a link that has just ended is given up 250 ms after its last frame.
    end = time.monotonic() + 1.5
    while True:
        states, owns = look()
        if not states:
            sys.exit(f"[{dev.name}] this emulator cannot tell how the "
                     "firmware has its serial ports: `expansion` needs one "
                     "that is built from this tree as it is now "
                     "(scripts/setup_qemu.sh)")
        ready = waiting(states)
        port = args.port or (ready[0] if ready else None)
        if port in ready:
            break
        if time.monotonic() >= end:
            for name in ("usart", "lpuart") if not port else (port,):
                _, pins, chip = UART_PORTS[name]
                print(f"[{dev.name}] pins {pins} ({chip}): the firmware "
                      "waits for no module there: it has the port as: "
                      f"{fe_header.port_text(states[chip])}", file=sys.stderr)
            if ready:
                print(f"[{dev.name}] it waits on pin "
                      f"{states[UART_PORTS[ready[0]][2]]['rx']}: --port "
                      f"{ready[0]}", file=sys.stderr)
            else:
                print(f"[{dev.name}] (Settings, Expansion Modules, Listen "
                      "UART is the port it waits on; an app that has the "
                      "port open has it for itself)", file=sys.stderr)
            return 1
        time.sleep(0.1)
    _, pins, chip = UART_PORTS[port]
    own = owns[port]
    if not own and port == "lpuart":
        sys.exit(f"[{dev.name}] pins {pins} ({chip}) go nowhere: `expansion` "
                 "needs a run without --lpuart none")
    if not own:
        sys.exit(f"[{dev.name}] pins {pins} ({chip}) are as QEMU was told "
                 "with --serial: `expansion` needs a run with --serial "
                 "stdio, pty, null, tcp:PORT or file:PATH")
    try:
        lock = take_port(dev.dir / f"{port}.lock", 5.0, f"pins {pins} are")
    except PortBusy as e:
        sys.exit(f"[{dev.name}] {e}")
    line = None
    try:
        try:
            line = FlipperCli(own)
        except OSError as e:
            sys.exit(f"[{dev.name}] pins {pins}: {e}")
        uart_drop(line)
        first = []

        def receive(seconds):
            if not select.select([line.fd], [], [], seconds)[0]:
                return b""
            data = line.sock.recv(4096)
            if not data:
                raise x.Lost("the device is gone (its emulator closed the "
                             "port)")
            return data

        def said(who, data, note):
            now = time.monotonic()
            if not first:
                first.append(now)
            name, words = x.in_words(data) if data else (note, "")
            print(f"{(now - first[0]) * 1000:9.1f} ms  {who:8} {name:10} "
                  f"{data.hex(' '):20} {words}".rstrip(), flush=True)

        module = x.Module(line.sock.sendall, receive, said)
        print(f"[{dev.name}] pins {pins} ({chip}): a module calls, and asks "
              f"for {args.baud} baud", flush=True)
        try:
            module.call()
            module.baud(args.baud)
            module.beat()
            if args.rpc:
                module.control(x.START_RPC)
                text, sent = b"FlipperEmu", time.monotonic()
                module.write(x.ping(1, text))
                module.quiet = True
                if not module.keep(2.0, lambda: x.message(module.stream)):
                    raise x.Lost("the RPC session did not answer a ping "
                                 "in 2 s")
                took = time.monotonic() - sent
                main, module.stream = x.message(module.stream)
                if x.pong(main) != (1, 0, text):
                    raise x.Lost("the RPC session answered the ping with "
                                 f"something else: {main}")
                print(f"[{dev.name}] the RPC session is there: a ping came "
                      f"back in {took * 1000:.0f} ms", flush=True)
            module.quiet = True
            start, before = time.monotonic(), module.beats
            module.keep(args.seconds)
            held = time.monotonic() - start
            module.quiet = False
            if args.rpc:
                module.control(x.STOP_RPC)
        except (x.Lost, OSError) as e:
            print(f"[{dev.name}] pins {pins}: {e}", file=sys.stderr)
            return 1
        beats = module.beats - before
        print(f"[{dev.name}] the link held for {held:.1f} s at {args.baud} "
              "baud" + (f": {beats} more heartbeat"
                        f"{'' if beats == 1 else 's'}, each answered"
                        if beats else ""), flush=True)
    finally:
        if line:
            line.close()
        leave_port(lock)
    # The module says no more: the firmware gives the link up when it has
    # heard nothing for 250 ms, and waits for the next call.
    end = time.monotonic() + 2.0
    while time.monotonic() < end:
        time.sleep(0.1)
        if port in waiting(look()[0]):
            print(f"[{dev.name}] the module is gone; the firmware gave the "
                  "link up, and waits for a call again")
            return 0
    print(f"[{dev.name}] pins {pins}: the module is gone, and 2 s later the "
          "firmware does not wait for the next one: it has the port as: "
          f"{fe_header.port_text(look()[0][chip])}", file=sys.stderr)
    return 1


def cmd_cli(args):
    dev = Device(args.device)
    cli = open_cli(dev, prompt=bool(args.commands), timeout=args.timeout)
    try:
        if not args.commands:
