def cmd_log(args):
    import fe_log
    dev = Device(args.device)
    if args.set_level:
        m = open_monitor(dev)
        try:
            err = m.cmd(f"qom-set /machine log-level {args.set_level}")
            level = qom_get(m, "/machine", "log-level")
        finally:
            m.close()
        if err:
            sys.exit(f"log: {err}")
        print(f"[{dev.name}] the firmware's log level: {log_level_text(level)}, "
              f"from its next start (./flipperemu -d {dev.name} reset)")
        return 0
    path = dev.uart_old if args.previous else dev.uart
    try:
        pattern = fe_log.smart(args.grep) if args.grep else None
    except re.error as e:
        sys.exit(f"log: --grep {args.grep!r}: {e}")
    if args.lines is not None and args.lines < 0:
