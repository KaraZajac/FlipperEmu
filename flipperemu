def cmd_rfid(args):
    import fe_rfid
    from fe_monitor import Monitor
    if args.list:
        for name, (_, size, mod) in fe_rfid.PROTOCOLS.items():
            print(f"{name:12} {size} bytes  {mod}")
        return 0
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    tag = args.tag
    label, value, t5577 = None, None, None
    try:
        if not tag:
            pass
        elif tag == ["none"]:
            label, value = "no tag", "none"
        elif tag[0].lower() == "t5577":
            blocks = [int(b, 16) for b in tag[1:]]
            if len(blocks) > 8 or any(b >> 32 for b in blocks):
                raise ValueError("a T5577 has blocks 0-7, 32-bit hex words")
            b0 = blocks[0] if blocks else 0x000880E8
            label = (f"a T5577 ({'blank, ' if not blocks else ''}"
                     f"{fe_rfid.t5577_config(b0)}) that the firmware can write")
            t5577 = ",".join(f"{b:08X}" for b in blocks) or "blank"
        elif len(tag) == 1 and tag[0].endswith(".rfid"):
            proto, data = fe_rfid.parse_rfid(tag[0])
            label = f"{proto} {data.hex(' ').upper()} ({pathlib.Path(tag[0]).name})"
            value = fe_rfid.tag(proto, data)
        elif len(tag) == 1 and pathlib.Path(tag[0]).is_file():
            frame, mod = fe_rfid.capture_frame(fe_rfid.parse_capture(tag[0]))
            label = (f"the tag emulated in {pathlib.Path(tag[0]).name} "
                     f"({sum(n for _, n in frame)}-cycle frame, {mod.upper()})")
            value = fe_rfid.tag_string(frame, mod)
        elif len(tag) >= 2:
            data = fe_rfid.parse_hex(" ".join(tag[1:]))
            name, frame, mod = fe_rfid.encode(tag[0], data)
            label = f"{name} {data.hex(' ').upper()}"
            value = fe_rfid.tag_string(frame, mod)
        else:
            sys.exit("usage: rfid PROTOCOL DATA | rfid FILE.rfid | rfid CAPTURE.txt | "
                     "rfid t5577 [BLOCK0 ...] | rfid none | rfid --list")
    except (ValueError, KeyError, OSError) as e:
        sys.exit(f"rfid: {e}")
    m = Monitor(str(dev.monitor))
    try:
        for prop, on in (("reader", args.reader), ("noise", args.noise)):
            if on is not None:
                err = m.cmd(f"qom-set /machine/rfid {prop} {'on' if on == 'on' else 'off'}")
                if err:
                    sys.exit(f"rfid: {err}")
        if t5577 is not None:
            err = m.cmd(f"qom-set /machine/rfid t5577 {t5577}")
            if err:
                sys.exit(f"rfid: {err}")
            dev.set_held("rfid", label)
            print(f"[{dev.name}] 125 kHz field: {label}")
        elif value is not None:
            if value != "none":
                path = dev.dir / "rfid-tag.txt"     # long frames: past HMP line limits
                path.write_text(value + "\n")
                value = f"file:{path}"
            err = m.cmd(f"qom-set /machine/rfid tag {value}")
            if err:
                sys.exit(f"rfid: {err}")
            dev.set_held("rfid", None if value == "none" else label)
            print(f"[{dev.name}] 125 kHz field: {label}")
        else:
            get = lambda prop: m.cmd(f"qom-get /machine/rfid {prop}").strip().strip('"')
            onoff = lambda prop: "on" if get(prop) == "true" else "off"
            print(f"[{dev.name}] its reader's field: {get('field')}; tag in it: "
                  f"{'yes' if get('tag') else 'none'}; field noise: {onoff('noise')}; "
                  f"a virtual reader's field around it: {onoff('reader')}")
            t5 = get("t5577")
            if t5:
                print(f"T5577 ({fe_rfid.t5577_config(int(t5.split()[0], 16))}): {t5}")
            last = get("tx")
            if last:
                print(f"latest emulation capture: {last}")
    finally:
        m.close()
    return 0


def cmd_nfc(args):
    import fe_nfc
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    if args.link:                               # a program as the card
        import fe_nfc_link
        held = ""
        try:                                    # (the monitor may be busy)
            m = Monitor(str(dev.monitor))
            try:
                held = m.cmd("qom-get /machine/nfc card").strip().strip('"')
            finally:
                m.close()
        except ConnectionError:
            pass
        if held:
            print(f"[{dev.name}] note: a card is in the field already ({held}); the "
                  "link's card answers once it is gone (`./flipperemu nfc none`)")
        try:
            return fe_nfc_link.run(dev.nfc_sock, fe_nfc_link.make_card(args.link, args),
                                   args.verbose)
        except (OSError, ValueError) as e:
            sys.exit(f"nfc --link: {e}")
    card = args.card
    if args.field:
        m = Monitor(str(dev.monitor))
        try:
            err = m.cmd(f"qom-set /machine/nfc field {args.field}")
        finally:
            m.close()
        if err:
            sys.exit(f"nfc: {err}")
        print(f"[{dev.name}] an NFC reader's field around it: {args.field}")
        if not card and not args.reader:
            return 0
    if args.reader:
        m = Monitor(str(dev.monitor))
        try:
            before = m.cmd("qom-get /machine/nfc tx").strip().strip('"')
            err = m.cmd(f"qom-set /machine/nfc reader {args.reader}")
            if err:
                sys.exit(f"nfc: {err}")
            if args.no_wait:
                print(f"[{dev.name}] a virtual NFC reader ({args.reader}) in front of "
                      "the Flipper")
                return 0
            print(f"[{dev.name}] a virtual NFC reader ({args.reader}) in front of the "
                  "Flipper; waiting for it to finish...", flush=True)
            for _ in range(150):
                time.sleep(0.1)
                if not m.cmd("qom-get /machine/nfc reader").strip().strip('"'):
                    break
            after = m.cmd("qom-get /machine/nfc tx").strip().strip('"')
        finally:
            m.close()
        if after and after != before:
            print(f"[{dev.name}] it read: {after}")
            print(pathlib.Path(after).read_text(), end="")
            return 0
        sys.exit(f"[{dev.name}] nothing read: is the Flipper emulating a card "
                 "(NFC -> Saved -> Emulate, or `emulate -f` in the nfc shell)?")
    try:
        if not card:
            label = None
        elif card == ["none"]:
            label, desc = "no card", None
        elif len(card) == 1 and card[0].endswith(".nfc"):
            fields = fe_nfc.parse_nfc(card[0])
            desc = fe_nfc.describe(fields)
            label = f"{desc.splitlines()[0][2:]} {fields['UID']} ({pathlib.Path(card[0]).name})"
        elif len(card) == 1 and card[0].lower().endswith(".json"):     # a Proxmark3 dump
            desc = fe_nfc.describe_pm3(card[0])
            uid = next(l[4:] for l in desc.splitlines() if l.startswith("uid "))
            label = f"{desc.splitlines()[0][2:]} {uid.upper()} ({pathlib.Path(card[0]).name})"
        elif len(card) == 2 and card[0].lower() in ("mfcmini", "mfc1k", "mfc4k"):
            uid = bytes.fromhex(card[1].replace(":", "").replace(" ", ""))
            desc = fe_nfc.blank_mfc(card[0][3:], uid)
            label = f"a MIFARE Classic {card[0][3:].upper()} {uid.hex(' ').upper()}"
        elif len(card) in (2, 3) and card[0].lower().lstrip("-") in fe_nfc.BLANK:
            uid = bytes.fromhex(card[1].replace(":", "").replace(" ", ""))
            url = card[2] if len(card) == 3 else None
            desc = fe_nfc.blank(card[0].lower().lstrip("-"), uid, url)
            label = (f"an {card[0].upper()} {uid.hex(' ').upper()}" +
                     (f" with {url}" if url else ", blank"))
        else:
            sys.exit("usage: nfc FILE.nfc | nfc DUMP.json (Proxmark3) | nfc ntag215 UID "
                     "[URL] | nfc mfc1k UID | nfc none")
    except (ValueError, KeyError, OSError) as e:
        sys.exit(f"nfc: {e}")
    m = Monitor(str(dev.monitor))
    try:
        if label is None:
            field = m.cmd("qom-get /machine/nfc field").strip() == "true"
            print(f"[{dev.name}] card in the field: "
                  f"{m.cmd('qom-get /machine/nfc card').strip().strip(chr(34)) or 'none'}"
                  f"; a reader's field around it: {'on' if field else 'off'}")
            return 0
        value = "none"
        if desc is not None:
            path = dev.dir / "nfc-card.txt"
            path.write_text(desc)
            value = f"file:{path}"
        err = m.cmd(f"qom-set /machine/nfc card {value}")
        if err:
            sys.exit(f"nfc: {err}")
        dev.set_held("nfc", None if desc is None else label)
        print(f"[{dev.name}] NFC field: {label}")
    finally:
        m.close()
    return 0


def cmd_ibutton(args):
    import fe_ibutton
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    key = args.key
    label, desc = None, None
    if args.reader:
        m = Monitor(str(dev.monitor))
        try:
            before = m.cmd("qom-get /machine/ibutton tx").strip().strip('"')
            err = m.cmd("qom-set /machine/ibutton reader read")
            if err:
                sys.exit(f"ibutton: {err}")
            if args.no_wait:
                print(f"[{dev.name}] a virtual iButton reader on the Flipper's contact")
                return 0
            print(f"[{dev.name}] a virtual iButton reader on the Flipper's contact; "
                  "reading...", flush=True)
            for _ in range(1200):           # a DS1996's 8 KB: ~5 s, more if it resumes
                time.sleep(0.1)
                if not m.cmd("qom-get /machine/ibutton reader").strip().strip('"'):
                    break
            after = m.cmd("qom-get /machine/ibutton tx").strip().strip('"')
        finally:
            m.close()
        if after and after != before and after.endswith(".ibtn"):
            text = pathlib.Path(after).read_text()
            print(f"[{dev.name}] it read: {after}")
            print(text, end="")
            fields = fe_ibutton.parse_ibtn(after)
            rom = fe_ibutton.hexbytes(fields.get("Rom Data", ""))
            _, _, size = fe_ibutton.FAMILIES.get(rom[0] if rom else -1, ("", 0, 0))
            field = fe_ibutton.MEMORY_KEYS.get(fields.get("Protocol", ""))
            got = len(fe_ibutton.hexbytes(fields.get(field, ""))) if field else 0
            if got < size:
                print(f"[{dev.name}] incomplete: {got} of {size} bytes of memory "
                      "(the key stopped answering; see qemu.log)")
                return 1
            return 0
        sys.exit(f"[{dev.name}] nothing read: is the Flipper emulating a Dallas key "
                 "(iButton -> Saved -> Emulate, or `ikey emulate Dallas ...`)?")
    try:
        if not key:
            pass
        elif key == ["none"]:
            label = "no key"
        elif len(key) == 1 and key[0].endswith(".ibtn"):
            desc = fe_ibutton.describe(fe_ibutton.parse_ibtn(key[0]))
            label = f"{desc.splitlines()[0][2:]} ({pathlib.Path(key[0]).name})"
        elif len(key) == 1 and pathlib.Path(key[0]).is_file():
            proto, data = fe_ibutton.decode_capture(fe_ibutton.parse_capture(key[0]))
            desc = fe_ibutton.describe_new(proto, data)
            label = (f"{proto} {data.hex(' ').upper()}, as emulated in "
                     f"{pathlib.Path(key[0]).name}")
        elif len(key) >= 2 or key[0].lower() in fe_ibutton.BLANKS:
            desc = fe_ibutton.describe_new(key[0], fe_ibutton.hexbytes(" ".join(key[1:])))
            label = desc.splitlines()[0][2:]
        else:
            sys.exit("usage: ibutton FILE.ibtn | ibutton ds1990|ds1992|ds1996|ds1971|dallas "
                     "ROM | ibutton cyfral DATA | ibutton metakom DATA | ibutton "
                     "rw1990|rw1990.2|tm2004|tm01x [ROM] | ibutton none")
    except (ValueError, KeyError, OSError) as e:
        sys.exit(f"ibutton: {e}")
    if desc:
        rom = next((l[4:] for l in desc.splitlines() if l.startswith("rom ")), None)
        if rom:
            label += f" {rom.upper()}"
    m = Monitor(str(dev.monitor))
    try:
        if label is None:
            cur = m.cmd("qom-get /machine/ibutton key").strip().strip('"')
            first = ""
            if cur.startswith("file:") and pathlib.Path(cur[5:]).is_file():
                first = pathlib.Path(cur[5:]).read_text().splitlines()[0][2:]
            rom = m.cmd("qom-get /machine/ibutton rom").strip().strip('"')
            print(f"[{dev.name}] key on the iButton contact: {first or 'none'}"
                  + (f", ROM now {rom}" if rom else ""))
            return 0
        value = "none"
        if desc is not None:
            path = dev.dir / "ibutton-key.txt"
            path.write_text(desc)
            value = f"file:{path}"
        err = m.cmd(f"qom-set /machine/ibutton key {value}")
        if err:
            sys.exit(f"ibutton: {err}")
        dev.set_held("ibutton", None if desc is None else label)
        print(f"[{dev.name}] iButton contact: {label}")
    finally:
        m.close()
    return 0


ENCLAVE_USAGE = """\
./flipperemu [-d NAME] enclave ...

  (nothing)               the keys in the device's secure enclave
  encrypt SLOT IV [TEXT]  what `crypto encrypt SLOT IV` prints for TEXT (or stdin).
                          The firmware fills the last block with what its heap
                          holds, this with zeros: a TEXT of 15, 31, 47...
                          characters has no filling, and gives the same.
  decrypt SLOT IV HEX     what `crypto decrypt SLOT IV` prints for HEX
  wrap KEY [IV]           KEY (hex, 16 or 32 bytes) encrypted under the master key:
                          the last argument of `crypto store_key N encrypted BITS`
  reset                   the factory keys again; the device's own key and the
                          keys that were stored are gone, and what they encrypted
  blank                   no keys at all: the firmware reports a damaged enclave,
                          and `crypto store_key` can fill it

Slot 0 is the master key, 1-10 are the factory keys, 11 the device's own key
(the firmware makes it on first use), 12-100 what apps store. The factory keys
of an emulated Flipper are FlipperEmu's and public (docs/ARCHITECTURE.md): what
it encrypts is not secret, and it cannot read what a real Flipper encrypted.
IV: 16 bytes in hex (12 for wrap)."""


def cmd_enclave(args):
    import fe_enclave
    dev = Device(args.device)
    action = args.action[0] if args.action else "show"
    if action in ("reset", "blank"):
        # the emulator reads the file at start and rewrites it from memory
        dev.refuse_if_running()
        dev.dir.mkdir(parents=True, exist_ok=True)
    elif not dev.enclave.exists():
        sys.exit(f"[{dev.name}] no enclave yet: the first run makes one, with "
                 "FlipperEmu's factory keys")
    return fe_enclave.main(["enclave", action, str(dev.enclave), *args.action[1:]],
                           usage=ENCLAVE_USAGE)


