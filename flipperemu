def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-d", "--device", default="default",
                    help="virtual device name (devices/<name>/), default: default")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("run", help="boot the device (optionally flashing first)")
    p.add_argument("-f", "--firmware", help=".elf/.dfu/.bin/update .tgz to flash first")
    p.add_argument("--update", metavar="PKG",
                   help="install an update package (.tgz or folder) through the "
                        "firmware's own updater, like qFlipper: settings and files stay")
    p.add_argument("--keep-radio", action="store_true",
                   help="with --update: keep the radio stack stage (the emulated CPU2 "
                        "cannot install it, so the updater will fail)")
    p.add_argument("--erase-all", action="store_true", help="wipe flash before programming")
    p.add_argument("--headless", action="store_true", help="no window")
    p.add_argument("--gtk", action="store_true",
                   help="QEMU's own window, the bare LCD, instead of the one that "
                        "looks like a Flipper (which needs PySide6)")
    p.add_argument("--unplugged", action="store_true",
                   help="start with the USB cable unplugged, on battery (`usb plug`, "
                        "or the window, plugs it in)")
    p.add_argument("--battery", type=int, metavar="PERCENT",
                   help="start with the battery at this charge (default 87)")
    p.add_argument("--no-sd", action="store_true", help="boot without a microSD card")
    p.add_argument("--usb", default="pty",
                   help="USB serial port (CLI/RPC): pty (default), unix "
                        "(devices/<name>/usb.sock), tcp:PORT, none (cable unplugged)")
    p.add_argument("--audio", default="auto",
                   help="speaker: auto (a desktop audio driver if QEMU has one; silent "
                        "when headless), wav:FILE (record), pipewire, pa, alsa, sdl, none")
    p.add_argument("--usbip", type=int, nargs="?", const=3240, default=None,
                   metavar="PORT",
                   help="export the USB device over USB/IP (default port 3240): "
                        "`sudo scripts/usbip_attach.py` then makes it a real USB "
                        "device on this PC, for qFlipper, lab.flipper.net, ...")
    p.add_argument("--usbip-host", default="127.0.0.1",
                   help="address to serve USB/IP on (default 127.0.0.1)")
    p.add_argument("--serial", default="stdio",
                   help="USART1, where the firmware logs: stdio (default), "
                        "file:PATH, pty, tcp:PORT (on this computer; "
                        "tcp:HOST:PORT for another address of it), null. "
                        "Whichever it is, `flipperemu log` has the log too")
    p.add_argument("--log-level", metavar="LEVEL",
                   choices=("default", "none", "error", "warn", "info", "debug",
                            "trace"),
                   help="start with the firmware's log level (Settings > System "
                        "> Log Level) set to none, error, warn, info, debug, "
                        "trace or default; it stays until it is changed")
