# ---- the firmware's own build tools: ufbt, and a firmware tree's fbt

# their targets that go through a debug probe, which is to a real Flipper
TOOL_PROBE = {"flash", "firmware_flash", "jflash", "firmware_jflash", "debug",
              "debug_other", "debug_other_blackmagic", "blackmagic",
              "flash_blackmagic", "updater_debug", "updater_blackmagic",
              "gdb_trace_all", "openocd", "get_blackmagic", "get_stlink",
              "devboard_flash"}
# ... those that talk to a Flipper on its USB serial port
TOOL_PORT = {"launch", "launch_app", "cli", "cli_perf", "flash_usb",
             "flash_usb_full", "dolphin_ext", "fap_deploy"}
# ... and what ufbt does itself, before there is a build to give a port to
UFBT_OWN = {"update", "clean", "status"}
# an update package with a radio stack in it: fbt's flash_usb sends the one
# without, ufbt's sends the SDK's, which has one
TOOL_STACK = {"fbt": {"flash_usb_full"}, "ufbt": {"flash_usb", "flash_usb_full"}}


def split_tool(argv):
    """`ufbt` and `fbt` are followed by that tool's arguments, which are not
    ours to read: (our arguments, the tool's or None)"""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-d", "--device"):
            i += 2
        elif a.startswith("--device=") or (a.startswith("-d") and len(a) > 2):
            i += 1
        elif a in ("ufbt", "fbt"):
            return argv[:i + 1], argv[i + 1:]
        else:
            break
    return argv, None


def find_tool(name):
    """(the command, the folder it is run in: None = this one)"""
    if name == "ufbt":
        tool = shutil.which("ufbt")
        if not tool:
            sys.exit("flipperemu: no `ufbt` on the PATH: `pipx install ufbt` "
                     "(or pip, in a virtual environment) gets it")
        return [tool], None
    tree = source_tree()
    if tree:
        return [str(tree / "fbt")], tree
    sys.exit("flipperemu: no `fbt` in this folder or above it: it is run in "
             "a firmware's source tree")


def cmd_tool(args):
    """Run ufbt or fbt as it was called, with this device's USB serial port
    named as the Flipper to talk to.  Left to themselves they take a real
    Flipper that is plugged into this computer, before they look at
    FLIPPER_PATH."""
    from fe_cli import leave_port, take_port
    dev = Device(args.device)
    name, rest = args.cmd, list(args.tool_args or [])
    cmd, cwd = find_tool(name)
    if name == "ufbt" and UFBT_OWN.intersection(rest):
        return subprocess.call([*cmd, *rest], cwd=cwd)
    targets = {a for a in rest if not a.startswith("-") and "=" not in a}
    probe = sorted(targets & TOOL_PROBE)
    if probe:
        sys.exit(f"flipperemu: `{name} {probe[0]}` goes through a debug probe, "
                 "to a real Flipper, and not to this one.  "
                 f"`./flipperemu -d {dev.name} flash FILE` programs it, "
                 f"`./flipperemu -d {dev.name} gdb` debugs it")
    stack = sorted(targets & TOOL_STACK[name])
    if stack:
        why = (f"`{name} {stack[0]}` sends an update package with a radio "
               "stack in it, and this Flipper's second core installs no "
               "other stack than its own: with another one its updater "
               "would stop at \"CRC mismatch #[3-99]\"")
        if name == "fbt":
            sys.exit(f"flipperemu: {why} (a held Back leaves it).\n"
                     "`fbt flash_usb` sends the package without one, and "
                     f"works.  `./flipperemu -d {dev.name} update PACKAGE` "
                     "sends a full one (dist/…/f7-update-…), and leaves its "
                     "radio stage out when its stack is not the device's")
        # ufbt has one package to send: its SDK's, with the stack
        found = sorted(sdk_home().glob("current/f7-update-*"))
        if not found:
            sys.exit(f"flipperemu: `ufbt {stack[0]}` sends its SDK's update "
                     f"package, and there is none in {sdk_home() / 'current'} "
                     "(`ufbt update` gets the SDK)")
        if len(targets) > 1:
            sys.exit(f"flipperemu: {why}.\n`./flipperemu -d {dev.name} ufbt "
                     f"{stack[0]}`, with no other target, sends it as "
                     "`update` does: with that stage only when its stack is "
                     "the device's")
        # send_update() keeps the stage when the SDK's stack is the device's
        # (the updater finds it up to date), and says what it did
        if dev.running():
            print(f"[{dev.name}] `ufbt {stack[0]}`: its SDK's update package "
                  f"(./flipperemu -d {dev.name} update {found[-1]})", flush=True)
        return send_update(dev, found[-1])
    lock = None
    if not any(a.startswith("FLIP_PORT=") for a in rest):
        port = sorted(targets & TOOL_PORT)
        if port:
            what = f"`{name} {port[0]}`"
            if not dev.running():
                sys.exit(f"[{dev.name}] is not running, and {what} talks to "
                         "it on its USB serial port "
                         f"(`./flipperemu -d {dev.name} run`)")
            ep, why = usb_serial(dev)
            if not why and ep[0] != "pty":
                why = (f"it is a {ep[0]} socket (run --usb), and the "
                       "firmware's tools open a serial port: the default, "
                       "--usb pty, is one")
            if why:
                sys.exit(f"[{dev.name}] no USB serial port for {what}: {why}")
            lock = take_port(dev.dir / "usb.lock")
        # (a stopped device has no usb.tty: then a target that is not in the
        # list above fails on that name, and does not find a real Flipper)
        rest.append(f"FLIP_PORT={dev.usb_tty}")
    try:
        return subprocess.call([*cmd, *rest], cwd=cwd)
    finally:
        if lock:
            leave_port(lock)


# ---- files on the SD card

def open_card(dev):
    """(files, close): a device's SD card, through the firmware when it runs
    and in the card's image when it does not (scripts/fe_files.py)"""
    import fe_files
    if dev.running():
        cli = open_cli(dev)
        return fe_files.CliFiles(cli), cli.close
    if not dev.sd.exists():
        sys.exit(f"[{dev.name}] has no SD card: `./flipperemu -d {dev.name} sd` "
                 "makes one")
    return fe_files.ImageFiles(dev.sd), lambda: None


CARD_PATH = re.compile(r"/(ext|int|any)(/|$)")


def transfer_progress():
    """Shows how far a big file is: on a terminal only"""
    if not sys.stderr.isatty():
        return None

    def show(name, done, total):
        if total >= 32768:
            sys.stderr.write(f"\r  {name[-48:]}: {done * 100 // total} %"
                             if done < total else "\r\x1b[K")
            sys.stderr.flush()
    return show


class held_interrupt:
    """Ctrl-C during a transfer to the card: taken note of, and acted on where
    the Flipper is at its prompt, so that no half of a file stays behind.  A
    second one is not held back.  Gives the question "was there one?"."""

    def __init__(self, how):
        self.how = how                      # what is said at the first one

    def __enter__(self):
        self.hit = False
        self.old = signal.signal(signal.SIGINT, self.note)
        return lambda: self.hit

    def note(self, *_):
        self.hit = True
        signal.signal(signal.SIGINT, self.old)
        if sys.stderr.isatty():
            print(f"\r\x1b[K({self.how}; Ctrl-C again stops at once)",
                  file=sys.stderr)
        else:
            print(f"({self.how})", file=sys.stderr)

    def __exit__(self, *exc):
        signal.signal(signal.SIGINT, self.old)


def copied_text(dev, files, copied, same):
    text = f"[{dev.name}] {copied} copied"
    if same:
        text += f", {same} unchanged"
    return f"{text} ({files.where})"


def cmd_ls(args):
    import fe_files
    dev = Device(args.device)
    files, close = open_card(dev)
    try:
        path = fe_files.clean(args.path)
        st = files.stat(path)
        if not st:
            raise fe_files.StorageError("file/dir not exist", path)
        if not st.is_dir:
            entries = [st]
        elif args.recursive:
            entries = sorted(files.tree(path),
                             key=lambda e: [p.lower() for p in e.name.split("/")])
        else:
            entries = fe_files.by_name(files.ls(path))
    finally:
        close()
    for e in entries:
        print(f"{'' if e.is_dir else e.size:>10}  {e.name}{'/' if e.is_dir else ''}")
    return 0


def cmd_push(args):
    import fe_files
    dev = Device(args.device)
    sources = list(args.paths)
    remote = sources.pop() if CARD_PATH.match(sources[-1]) else None
    if not sources:
        sys.exit(f"push: what is to go to {remote}? (push LOCAL... [REMOTE])")
    # --card, for a device that runs: its card out of the slot for the write
    by_hand = args.card and dev.running()
    if by_hand and remote and fe_files.clean(remote).startswith("/int"):
        sys.exit("push --card: /int is in the Flipper's own flash and not on "
                 "its card.  Without --card the files go there through the "
                 "firmware")
    if by_hand:                 # no card pulled for what is not there
        for s in sources:
            if not os.path.exists(s):
                raise fe_files.FilesError(f"{s}: no such file or folder")
    files, close = open_card(dev)
    try:
        with held_interrupt("stopping after this piece") as stop:
            if by_hand:
                with card_out(dev, files.cli, "the files are",
                              "Without --card they go through the firmware, "
                              "with the card where it is") as image:
                    copied, same = fe_files.push(image, sources, remote,
                                                 force=args.force, stop=stop)
                files = image
            else:
                copied, same = fe_files.push(files, sources, remote,
                                             force=args.force,
                                             progress=transfer_progress(),
                                             stop=stop)
    finally:
        close()
    print(copied_text(dev, files, copied, same))
    return 0


