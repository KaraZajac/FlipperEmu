    n = fe_log.show(path, follow=args.follow, count=args.lines,
                    level=fe_log.LEVELS.get(args.level, ""), pattern=pattern,
                    color={"always": True, "never": False}.get(args.color))
    if n is None:
        sys.exit(f"[{dev.name}] no log" + (" of a run before this one"
                                           if args.previous else
                                           " yet: it has not run"))
    return 0


def sdk_home():
    """ufbt's folder: its SDK, its toolchain, and what it built"""
    return pathlib.Path(os.environ.get("UFBT_HOME") or "~/.ufbt").expanduser()


def source_tree(start=None):
    """The firmware source tree a folder is in (None: it is in none)"""
    here = start or pathlib.Path.cwd()
    for folder in (here, *here.parents):
        if (folder / "fbt").is_file() and (folder / "SConstruct").is_file():
            return folder
    return None


def gdb_stub(m):
    """A running device's gdb stub: (what gdb's `target remote` takes, whether
    a gdb is on it), or None when it has none"""
    for line in m.cmd("info chardev").splitlines():
        hit = re.match(r"gdb: filename=(disconnected:)?(unix|tcp):(.*?),server=on",
                       line.strip())
        if hit:
            free, kind, where = hit.groups()
            if kind == "tcp":
                host, _, port = where.rpartition(":")
                if host in ("", "0.0.0.0", "::", "[::]"):
                    host = "localhost"
                where = f"{host}:{port}"
            return where, not free
    return None


def gdb_open_stub(dev, port=None):
    """-> what `target remote` takes.  The stub of a `run --gdb` is used where
    it is; else one is opened on a socket in the device's folder, or (port)
    on a TCP port of this computer."""
    m = open_monitor(dev)
    try:
        stub = gdb_stub(m)
        if stub and stub[1]:
            sys.exit(f"[{dev.name}] a gdb is on it already (at {stub[0]})")
        want = f"127.0.0.1:{port}" if port else None
        if stub and want in (None, stub[0]):
            return stub[0]
        if stub:
            m.cmd("gdbserver none")     # one stub: it moves
        said = m.cmd(f"gdbserver tcp:{want}" if want else
                     f'gdbserver "unix:{dev.gdb_sock},server=on,wait=off"')
        stub = gdb_stub(m)
        if not stub:
            sys.exit(f"[{dev.name}] no gdb stub: " + " ".join(said.split()))
        return stub[0]
    finally:
        m.close()


def gdb_program(asked, tree):
    """The gdb to run.  The firmware's toolchain has one for this processor
    with Python in it, which the symbols of apps need."""
    if asked:
        found = shutil.which(asked)
        if not found:
            sys.exit(f"flipperemu: no `{asked}`")
        return found
    name = "arm-none-eabi-gdb-py3"
    for home in (os.environ.get("FBT_TOOLCHAIN_PATH"), tree, sdk_home()):
        if not home:
            continue
        base = pathlib.Path(home).expanduser() / "toolchain"
        for gdb in (base / "current" / "bin" / name, *sorted(base.glob(f"*/bin/{name}"))):
            if os.access(gdb, os.X_OK):
                return str(gdb)
    for name in (name, "arm-none-eabi-gdb", "gdb-multiarch", "gdb"):
        found = shutil.which(name)
        if found:
            return found
    sys.exit("flipperemu: no gdb.  The firmware's toolchain has one, which ufbt "
             "gets (`pipx install ufbt`, then `ufbt update`); or your system's "
             "gdb-multiarch")


def gdb_has_python(gdb):
    try:
        out = subprocess.run([gdb, "-nx", "-batch", "-ex", "python print(6 * 7)"],
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "42" in out


def flash_has(dev, elf):
    """Is what this ELF loads what the device's flash holds?"""
    try:
        with open(dev.flash, "rb") as flash:
            for addr, data in parse_elf(elf.read_bytes()):
                flash.seek(addr - FLASH_BASE)
                if flash.read(len(data)) != data:
                    return False
        return True
    except (OSError, ValueError, struct.error):
        return False


def gdb_firmware(dev, asked):
    """-> (the firmware's ELF or None, the folder to look for its source tree
    from).  Not asked for: the first of what was flashed, an ELF beside the
    package that was flashed (the update server has one for each build, and
    scripts/fetch_firmware.py puts it there), a build in the source tree we
    are in, and ufbt's SDK whose contents are in the flash: an update on the
    device itself leaves the others behind."""
    if asked:
        elf = pathlib.Path(asked).resolve()
        if not elf.is_file():
            sys.exit(f"flipperemu: no {asked}")
        if not flash_has(dev, elf):
            print(f"[{dev.name}] {asked} is not what its flash holds: what gdb "
                  "says of the firmware may be off")
        return elf, elf.parent
    source = dev.info().get("source") or ""
    flashed = pathlib.Path(source) if source.endswith(".elf") else None
    beside = sorted(pathlib.Path(source).parent.glob("*.elf")) if source else []
    tree = source_tree()
    for elf, origin in ((flashed, flashed),
                        (dev.elf, flashed),
                        *((elf, None) for elf in beside),
                        (tree and tree / "build" / "latest" / "firmware.elf", None),
                        (sdk_home() / "current" / "firmware.elf", None)):
        if elf and elf.is_file() and flash_has(dev, elf):
            elf = elf.resolve()
            return elf, (origin or elf).parent
    return None, None


STOCK_SYMBOLS = "appsymbols"    # beside a firmware's ELF: its apps' debug ELFs


def gdb_kit(elf, origin, apps):
    """What reads the symbols of apps: (the firmware's gdb script, which is
    in its source tree or in ufbt's SDK; the folders the apps' debug ELFs are
    looked for in, the last one first).  The stock apps' are beside the
    firmware's ELF, where the update server's archive of them was unpacked
    (scripts/fetch_firmware.py does that); the others are what fbt or ufbt
    built, or what `--apps` names."""
    tree = source_tree(origin)
    if tree and (tree / "scripts" / "debug" / "flipperapps.py").is_file():
        kit, built = tree / "scripts" / "debug", origin / ".extapps"
    else:
        kit, built = sdk_home() / "current" / "scripts" / "debug", sdk_home() / "build"
    script = kit / "flipperapps.py"
    built = pathlib.Path(apps).resolve() if apps else built
    stock = (origin / STOCK_SYMBOLS).resolve()
    return (script if script.is_file() else None,
            [stock, built] if stock.is_dir() and stock != built else [built])


def cmd_gdb(args):
    """gdb on a running device.  Its stub is asked of the emulator when it is
    wanted, on a socket in the device's folder: nothing has to be decided when
    the device is started, and two devices do not meet on a port."""
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] is not running: `./flipperemu -d {dev.name} run` "
                 "starts it (`run --wait-gdb`: and has it wait for gdb at its "
                 "first instruction)")
    target = gdb_open_stub(dev, args.serve)
    elf, origin = gdb_firmware(dev, args.elf)
    gdb = gdb_program(args.program, source_tree(origin) if origin else None)
    lines = [f"# what `./flipperemu -d {dev.name} gdb` tells gdb: written each time",
             "set breakpoint pending on"]
    if elf:
        lines.append(f'file "{elf}"')
        print(f"[{dev.name}] the firmware's symbols: {elf}")
    else:
        print(f"[{dev.name}] no ELF of the firmware in its flash: no symbols.  "
              "A firmware flashed from an .elf has them, and so has the "
              "official release ufbt's SDK is of; --elf FILE names another")
    lines.append(f"target remote {target}")
    if not gdb_has_python(gdb):
        print(f"[{dev.name}] {gdb} has no Python: no symbols of apps, and "
              "nothing said at a crash")
    else:
        script, apps = gdb_kit(elf, origin, args.apps) if elf else (None, [])
        if script:
            print(f"[{dev.name}] apps' symbols, as they start: from {apps[-1]}"
                  + (f", and the stock apps' from {apps[0]}" if len(apps) > 1
                     else ""))
        about = {"fapscript": str(script or ""), "apps": [str(a) for a in apps],
                 "links": str(dev.gdb_apps), "name": dev.name}
        lines += [f"python FLIPPEREMU_GDB = {about!r}",
                  f"source {ROOT / 'scripts' / 'fe_gdb.py'}"]
    dev.gdb_init.write_text("\n".join(lines) + "\n")
    cmd = [gdb, "-q", "-x", str(dev.gdb_init), *args.gdb_args]
    if args.serve:
        print(f"[{dev.name}] its gdb stub is on localhost:{args.serve}, for an IDE "
              f"(`target remote localhost:{args.serve}`), or with all of the "
              "above:\n    " + shlex.join(cmd))
        return 0
    # Ctrl-C in gdb's terminal reaches us too, and is gdb's to take
    ours = signal.signal(signal.SIGINT, lambda *_: None)
    sys.stdout.flush()
    try:
        code = subprocess.call(cmd)
    finally:
        signal.signal(signal.SIGINT, ours)
    if dev.running():
        # a gdb that leaves lets go, and the firmware runs on; one that died
        # does not
        m = open_monitor(dev)
        try:
            if "paused" in m.cmd("info status"):
                m.cmd("cont")
                print(f"[{dev.name}] gdb left it stopped: it runs again")
        finally:
            m.close()
    return code if code >= 0 else 128 - code    # ended by a signal: as a shell has it


def usb_serial(dev):
    """A running device's USB serial port: (the chardev it is bridged to, why
    no CLI can be had on it: None when one can)"""
    from fe_cli import usb_endpoint
    m = open_monitor(dev)
    try:
        still = stopped(m)
        ep = usb_endpoint(m)
        usb = read_usb(m)
        end = time.monotonic() + 10         # just started: the PC finds it soon
        while (not still and ep and usb["cable"] == "computer"
               and time.monotonic() < end
               and usb["device"] in ("none", "enumerating")):
            time.sleep(0.2)
            usb = read_usb(m)
    finally:
        m.close()
    seen = usb["device"] or ""
    why = None
    if not ep:
        why = "it was started with --usb none"
    elif still:
        why = still_text(dev, still)
    elif usb["cable"] != "computer":
        why = (f"its USB port is {usb_text(usb)}; `./flipperemu -d {dev.name} "
               "usb plug` plugs it into the computer")
    elif seen == "usbip":
        why = ("a PC has its USB port over USB/IP (run --usbip), and its "
               "serial port with it")
    elif "CDC ACM" not in seen:
        why = f"it is {usb_text(usb)}, and that is no serial port"
        if seen not in ("none", "enumerating", "failed"):
            why += " (an app on the Flipper has USB: leaving it gives the port back)"
    return ep, why


CUT_WAIT = 1.5      # s for a prompt, after a command that was cut off


def open_cli(dev, prompt=True, timeout=15.0):
    """The CLI on a running device's USB serial port (an fe_cli.FlipperCli, at
    its prompt), or an exit that says why there is none.  The port is one line:
    our commands take turns at it (usb.lock)."""
    from fe_cli import FlipperCli
    ep, why = usb_serial(dev)
    if why:
        sys.exit(f"[{dev.name}] no CLI: {why}")
    halt = firmware_halt(dev)
    if halt:
        what, todo = halt_text(dev, halt)
        sys.exit(f"[{dev.name}] no CLI: the firmware {what}.  {todo}")
    cli = FlipperCli(ep, lock=dev.dir / "usb.lock")
    cli.gone = lambda: firmware_halt(dev)
    waited = 0.0
    if cli.cut:
        # Whoever had the port before was killed in the middle.  A firmware
        # that ends a command when the port closes prompts at once; an old
        # one may need Ctrl-C first (fe_cli.end_cut_off).
        began = time.time()
        left = cli.end_cut_off(min(CUT_WAIT, timeout))
        waited = time.time() - began
        if left is not None:
            sent, typed = left
            if typed:
                shown = typed.decode("latin-1")[:40]
                print(f"[{dev.name}] {cli.cut} was cut off in the middle, and "
                      f"the last of what it was sending ({shown!r}) was left "
                      "typed at the firmware's prompt: Ctrl-C cleared it.",
                      file=sys.stderr)
            elif sent:
                print(f"[{dev.name}] {cli.cut} was cut off in the middle, and "
                      "the firmware's CLI still waited for the rest of what "
                      f"it was to be sent: it got Ctrl-C ({sent} of them) "
                      "until it answered again.  If it was writing a file, "
                      "those are at its end.", file=sys.stderr)
            if prompt:
                cli.buf = b""
            elif sent:
                cli.buf = b"\r\n>: "       # (for the terminal to show)
            return cli
    if prompt:
        try:
            cli.read_until_prompt(
                max(1.0, timeout - waited),
                "no CLI prompt (is the firmware's CLI over USB enabled, and "
                "not still at a command that was cut off?  "
                f"`./flipperemu -d {dev.name} reset` starts the firmware "
                "again)")
        except TimeoutError as e:
            cli.close()
            sys.exit(f"[{dev.name}] {e}")
    return cli


def cmd_cli(args):
    dev = Device(args.device)
    cli = open_cli(dev, prompt=bool(args.commands), timeout=args.timeout)
    try:
        if not args.commands:
            print(f"[{dev.name}] USB CLI; Ctrl-] quits")
            cli.interactive()
            return 0
        for command in args.commands:
            print(cli.run(command, timeout=args.timeout, color=sys.stdout.isatty()))
    finally:
        cli.close()
    return 0


# ---- the firmware's own build tools: ufbt, and a firmware tree's fbt

# their targets that go through a debug probe, which is to a real Flipper
TOOL_PROBE = {"flash", "firmware_flash", "jflash", "firmware_jflash", "debug",
              "debug_other", "debug_other_blackmagic", "blackmagic",
              "flash_blackmagic", "updater_debug", "updater_blackmagic",
              "gdb_trace_all", "openocd", "get_blackmagic", "get_stlink",
              "devboard_flash"}
# ... those that talk to a Flipper on its USB serial port
TOOL_PORT = {"launch", "launch_app", "cli", "cli_perf", "flash_usb",
             "flash_usb_full", "dolphin_ext", "fap_deploy"}
# ... and what ufbt does itself, before there is a build to give a port to
UFBT_OWN = {"update", "clean", "status"}
# an update package with a radio stack in it: fbt's flash_usb sends the one
# without, ufbt's sends the SDK's, which has one
TOOL_STACK = {"fbt": {"flash_usb_full"}, "ufbt": {"flash_usb", "flash_usb_full"}}


def split_tool(argv):
    """`ufbt` and `fbt` are followed by that tool's arguments, which are not
    ours to read: (our arguments, the tool's or None)"""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-d", "--device"):
            i += 2
        elif a.startswith("--device=") or (a.startswith("-d") and len(a) > 2):
            i += 1
        elif a in ("ufbt", "fbt"):
            return argv[:i + 1], argv[i + 1:]
        else:
            break
    return argv, None


def find_tool(name):
    """(the command, the folder it is run in: None = this one)"""
    if name == "ufbt":
        tool = shutil.which("ufbt")
        if not tool:
            sys.exit("flipperemu: no `ufbt` on the PATH: `pipx install ufbt` "
                     "(or pip, in a virtual environment) gets it")
        return [tool], None
    tree = source_tree()
    if tree:
        return [str(tree / "fbt")], tree
    sys.exit("flipperemu: no `fbt` in this folder or above it: it is run in "
             "a firmware's source tree")


def cmd_tool(args):
    """Run ufbt or fbt as it was called, with this device's USB serial port
    named as the Flipper to talk to.  Left to themselves they take a real
    Flipper that is plugged into this computer, before they look at
    FLIPPER_PATH."""
    from fe_cli import leave_port, take_port
    dev = Device(args.device)
    name, rest = args.cmd, list(args.tool_args or [])
    cmd, cwd = find_tool(name)
    if name == "ufbt" and UFBT_OWN.intersection(rest):
        return subprocess.call([*cmd, *rest], cwd=cwd)
    targets = {a for a in rest if not a.startswith("-") and "=" not in a}
    probe = sorted(targets & TOOL_PROBE)
    if probe:
        sys.exit(f"flipperemu: `{name} {probe[0]}` goes through a debug probe, "
                 "to a real Flipper, and not to this one.  "
                 f"`./flipperemu -d {dev.name} flash FILE` programs it, "
                 f"`./flipperemu -d {dev.name} gdb` debugs it")
    stack = sorted(targets & TOOL_STACK[name])
    if stack:
        why = (f"`{name} {stack[0]}` sends an update package with a radio "
               "stack in it, which this Flipper's second core cannot "
               "install: its updater would stop at \"CRC mismatch #[3-99]\"")
        if name == "fbt":
            sys.exit(f"flipperemu: {why} (a held Back leaves it).\n"
                     "`fbt flash_usb` sends the package without one, and "
                     f"works.  `./flipperemu -d {dev.name} update PACKAGE` "
                     "sends a full one (dist/…/f7-update-…) without that "
                     "stage")
        # ufbt has one package to send: its SDK's, with the stack
        found = sorted(sdk_home().glob("current/f7-update-*"))
        if not found:
            sys.exit(f"flipperemu: `ufbt {stack[0]}` sends its SDK's update "
                     f"package, and there is none in {sdk_home() / 'current'} "
                     "(`ufbt update` gets the SDK)")
        if len(targets) > 1:
            sys.exit(f"flipperemu: {why}.\n`./flipperemu -d {dev.name} ufbt "
                     f"{stack[0]}`, with no other target, sends it without "
                     "that stage")
        if dev.running():
            print(f"[{dev.name}] {why}.  Sending that package without the "
                  f"stage (./flipperemu -d {dev.name} update {found[-1]})",
                  flush=True)
        return send_update(dev, found[-1])
    lock = None
    if not any(a.startswith("FLIP_PORT=") for a in rest):
        port = sorted(targets & TOOL_PORT)
        if port:
            what = f"`{name} {port[0]}`"
            if not dev.running():
                sys.exit(f"[{dev.name}] is not running, and {what} talks to "
                         "it on its USB serial port "
                         f"(`./flipperemu -d {dev.name} run`)")
            ep, why = usb_serial(dev)
            if not why and ep[0] != "pty":
                why = (f"it is a {ep[0]} socket (run --usb), and the "
                       "firmware's tools open a serial port: the default, "
                       "--usb pty, is one")
            if why:
                sys.exit(f"[{dev.name}] no USB serial port for {what}: {why}")
            lock = take_port(dev.dir / "usb.lock")
        # (a stopped device has no usb.tty: then a target that is not in the
        # list above fails on that name, and does not find a real Flipper)
        rest.append(f"FLIP_PORT={dev.usb_tty}")
    try:
        return subprocess.call([*cmd, *rest], cwd=cwd)
    finally:
        if lock:
            leave_port(lock)


# ---- files on the SD card

def open_card(dev):
    """(files, close): a device's SD card, through the firmware when it runs
    and in the card's image when it does not (scripts/fe_files.py)"""
    import fe_files
    if dev.running():
        cli = open_cli(dev)
        return fe_files.CliFiles(cli), cli.close
    if not dev.sd.exists():
        sys.exit(f"[{dev.name}] has no SD card: `./flipperemu -d {dev.name} sd` "
                 "makes one")
    return fe_files.ImageFiles(dev.sd), lambda: None


CARD_PATH = re.compile(r"/(ext|int|any)(/|$)")


def transfer_progress():
    """Shows how far a big file is: on a terminal only"""
    if not sys.stderr.isatty():
        return None

    def show(name, done, total):
        if total >= 32768:
            sys.stderr.write(f"\r  {name[-48:]}: {done * 100 // total} %"
                             if done < total else "\r\x1b[K")
            sys.stderr.flush()
    return show


class held_interrupt:
    """Ctrl-C during a transfer to the card: taken note of, and acted on where
    the Flipper is at its prompt, so that no half of a file stays behind.  A
    second one is not held back.  Gives the question "was there one?"."""

    def __init__(self, how):
        self.how = how                      # what is said at the first one

    def __enter__(self):
        self.hit = False
        self.old = signal.signal(signal.SIGINT, self.note)
        return lambda: self.hit

    def note(self, *_):
        self.hit = True
        signal.signal(signal.SIGINT, self.old)
        if sys.stderr.isatty():
            print(f"\r\x1b[K({self.how}; Ctrl-C again stops at once)",
                  file=sys.stderr)
        else:
            print(f"({self.how})", file=sys.stderr)

    def __exit__(self, *exc):
        signal.signal(signal.SIGINT, self.old)


def copied_text(dev, files, copied, same):
    text = f"[{dev.name}] {copied} copied"
    if same:
        text += f", {same} unchanged"
    return f"{text} ({files.where})"


def cmd_ls(args):
    import fe_files
    dev = Device(args.device)
    files, close = open_card(dev)
    try:
        path = fe_files.clean(args.path)
        st = files.stat(path)
        if not st:
            raise fe_files.StorageError("file/dir not exist", path)
        if not st.is_dir:
            entries = [st]
        elif args.recursive:
            entries = sorted(files.tree(path),
                             key=lambda e: [p.lower() for p in e.name.split("/")])
        else:
            entries = fe_files.by_name(files.ls(path))
    finally:
        close()
    for e in entries:
        print(f"{'' if e.is_dir else e.size:>10}  {e.name}{'/' if e.is_dir else ''}")
    return 0


def cmd_push(args):
    import fe_files
    dev = Device(args.device)
    sources = list(args.paths)
    remote = sources.pop() if CARD_PATH.match(sources[-1]) else None
    if not sources:
        sys.exit(f"push: what is to go to {remote}? (push LOCAL... [REMOTE])")
    # --card, for a device that runs: its card out of the slot for the write
    by_hand = args.card and dev.running()
    if by_hand and remote and fe_files.clean(remote).startswith("/int"):
        sys.exit("push --card: /int is in the Flipper's own flash and not on "
                 "its card.  Without --card the files go there through the "
                 "firmware")
    if by_hand:                 # no card pulled for what is not there
        for s in sources:
            if not os.path.exists(s):
                raise fe_files.FilesError(f"{s}: no such file or folder")
    files, close = open_card(dev)
    try:
        with held_interrupt("stopping after this piece") as stop:
            if by_hand:
                with card_out(dev, files.cli, "the files are",
                              "Without --card they go through the firmware, "
                              "with the card where it is") as image:
                    copied, same = fe_files.push(image, sources, remote,
                                                 force=args.force, stop=stop)
                files = image
            else:
                copied, same = fe_files.push(files, sources, remote,
                                             force=args.force,
                                             progress=transfer_progress(),
                                             stop=stop)
    finally:
        close()
    print(copied_text(dev, files, copied, same))
    return 0


# ---- an update package, to a device that runs

LOG_QUIET = ("none", "error", "warn")   # levels that hide the updater's steps


def firmware_log_level(dev, level=None):
    """The firmware's log level, as its RTC register has it.  With a level:
    written there first, which the firmware takes at its next start."""
    m = open_monitor(dev)
    try:
        if level:
            m.cmd(f"qom-set /machine log-level {level}")
        return qom_get(m, "/machine", "log-level")
    finally:
        m.close()


class card_out:
    """The microSD card of a running device out of its slot for a moment, as
    one that is taken to a computer's reader: in the block the launcher has
    the card's image (an fe_files.ImageFiles) and writes megabytes in no
    time, where the firmware's CLI takes 20 KB/s.  The firmware is waited for
    both times, at its CLI: until it has let go of the card, and until it has
    it again.  What it had open on the card it loses, as on a real Flipper."""

    def __init__(self, dev, cli, what, how):
        self.dev, self.cli = dev, cli
        self.what, self.how = what, how     # "the files are"; the other way

    def slot(self, card_in=None):
        """Is the card in its slot?  With an argument: put there, or taken
        out, first"""
        m = open_monitor(self.dev)
        try:
            if card_in is not None:
                err = m.cmd("qom-set /machine sd-card "
                            + ("on" if card_in else "off"))
                if err:
                    sys.exit(f"[{self.dev.name}] "
                             f"{err.removeprefix('Error: ')}")
            return qom_get(m, "/machine", "sd-card")
        finally:
            m.close()

    def mounted(self):
        return "Storage error" not in self.cli.run("storage info /ext")

    def wait(self, mounted, seconds):
        end = time.monotonic() + seconds
        while self.mounted() != mounted:
            if time.monotonic() > end:
                return False
            time.sleep(0.2)
        return True

    def __enter__(self):
        import fe_files
        name = self.dev.name
        if not self.slot():
            sys.exit(f"[{name}] its microSD card is not in the slot: "
                     f"`./flipperemu -d {name} sd insert` puts it there")
        if not self.mounted():
            sys.exit(f"[{name}] its firmware has no card that it can use "
                     f"(`./flipperemu -d {name} cli \"storage info /ext\"`)")
        image = fe_files.ImageFiles(self.dev.sd)
        print(f"[{name}] its card is out of the slot for a moment: "
              f"{self.what} written to its image", flush=True)
        self.slot(False)
        if not self.wait(False, 10.0):
            self.slot(True)
            sys.exit(f"[{name}] the firmware did not let go of its card when "
                     "it was pulled out, so nothing was written to it.  "
                     + self.how)
        return image

    def __exit__(self, kind, *_):
        self.slot(True)
        if kind is None:
            if not self.wait(True, 30.0):
                sys.exit(f"[{self.dev.name}] the card is in its slot again, "
                         "but the firmware does not take it: `./flipperemu "
                         f"-d {self.dev.name} reset` starts the firmware "
                         "anew.  " + self.how)
            print(f"[{self.dev.name}] the card is in again, and the firmware "
                  "has it", flush=True)
        elif issubclass(kind, Exception):
            try:                # the error is said; the card is the firmware's
                self.wait(True, 10.0)       # again when this command is back
            except Exception:
                pass
        return False


def await_update(dev, log, timeout):
    """Wait for the firmware's updater: what became of it ("back": the
    Flipper runs again, with its USB serial port; "error": the updater stopped
    at one; "ended": the emulator did; "restarted": it was started anew;
    "timeout"), and how often its log showed the firmware starting.

    The updater has no USB: the serial port coming back is the end of it.
    Until then its log says where it is (`[I][UpdWorker] Stage 9, progress
    0`).  The stage numbers are the firmware's own, and differ between
    firmwares, so only this is made of them: a stage that ended at 100
    before a restart is the one for "done", and one above it is an error,
    after which the updater stays on its screen."""
    import fe_log
    tty = sys.stderr.isatty()
    start = time.monotonic()
    starts, stage, full, done, gone, look = 0, None, False, None, False, 0.0
    while True:
        now = time.monotonic()
        for item in log.poll():
            if item is fe_log.RESTART:
                return "restarted", starts
            if item is fe_log.REBOOT:
                starts, gone = starts + 1, True
                if stage is not None and full:
                    done = stage
                stage = None
            elif item.tag == "UpdWorker":
                hit = re.match(r"Stage (\d+), progress (\d+)", item.text)
                if hit:
                    stage, full = int(hit.group(1)), hit.group(2) == "100"
        if done is not None and stage is not None and stage > done:
            return "error", starts
        if now >= look:
            look = now + 1
            if not dev.running():
                return "ended", starts
            m = open_monitor(dev)
            try:
                usb = read_usb(m)
            finally:
                m.close()
            if "CDC ACM" not in (usb["device"] or ""):
                gone = True
            elif gone:
                return "back", starts
        if now - start > timeout:
            return "timeout", starts
        if tty:
            sys.stderr.write(f"\r\x1b[K  the updater works: {now - start:.0f} s"
                             + (f", start {starts}" if starts else "")
                             + (f", stage {stage}" if stage is not None else ""))
            sys.stderr.flush()
        time.sleep(0.25)


def send_update(dev, pkg, keep_radio=False, wait=True, timeout=900.0,
                through_cli=False):
    """Put an update package on a running device's SD card, have the
    firmware install it, and wait until it has.  The package is written to
    the card's image, with the card out of its slot for that moment; or sent
    through the firmware's CLI, as its own tools send one to a real Flipper,
    which is 20 KB/s."""
    import fe_files
    import fe_log
    import tempfile
    if not dev.running():
        sys.exit(f"[{dev.name}] is not running: `./flipperemu -d {dev.name} run "
                 f"--update {pkg}` starts it and installs the package")
    was, lent = None, False

    def give_back():
        """The log level that was lent to the updater: as it was again,
        from the firmware's next start"""
        if lent and dev.running():
            firmware_log_level(dev, was)

    with tempfile.TemporaryDirectory(prefix="fe-update-") as tmp:
        pdir, label = unpack_update(pkg, pathlib.Path(tmp), keep_radio)
        size = sum(f.stat().st_size for f in pdir.rglob("*") if f.is_file())
        manifest = f"/ext/update/{pdir.name}/update.fuf"
        files, close = open_card(dev)
        what = (f"{label} ({size / 1e6:.1f} MB"
                + ("" if keep_radio else ", without its radio stage") + ")")

        def say(line):
            print("  " + line.replace(f"{tmp}/", ""), flush=True)

        try:
            with held_interrupt("stopping after this piece") as stop:
                print(f"[{dev.name}] {what} goes to /ext/update/{pdir.name}",
                      flush=True)
                if through_cli:
                    print(f"[{dev.name}] through the Flipper's CLI, which takes "
                          "some 20 KB/s; what is there already is not sent "
                          "again", flush=True)
                    fe_files.push(files, [pdir], "/ext/update/",
                                  progress=transfer_progress(), stop=stop,
                                  say=say)
                else:
                    with card_out(dev, files.cli, "the package is",
                                  "`update --cli` sends the package through "
                                  "the Flipper's CLI, with the card where it "
                                  "is") as image:
                        fe_files.push(image, [pdir], "/ext/update/",
                                      stop=stop, say=say)
            log = fe_log.Log(dev.uart, tail=4096)
            log.poll()                  # from here on: what the updater logs
            was = firmware_log_level(dev)
            if wait and was in LOG_QUIET:
                # the updater is the firmware's next start, and takes the
                # level that the register has by then.  Without its "Stage"
                # lines an error on its screen is not seen from here
                lent = True
                firmware_log_level(dev, "info")
                print(f"[{dev.name}] the firmware's log level is {was}: info "
                      "while the updater works, for its steps to be seen",
                      flush=True)
            try:
                refused = start_update(files.cli, manifest)
            except BaseException:
                give_back()
                raise
        finally:
            close()
    if refused:
        give_back()
        sys.exit(f"[{dev.name}] update refused: {refused}")
    stamp = dict(firmware=f"{label} (installed by update)",
                 flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)
    if not wait:
        dev.save_info(**stamp)
        print(f"[{dev.name}] updater started: {manifest} (it has no USB while "
              f"it works; `./flipperemu -d {dev.name} status` shows the serial "
              "port when it is back)")
        return 0
    print(f"[{dev.name}] updater started: the Flipper starts a few times, "
          "without USB, until it is done", flush=True)
    start = time.monotonic()
    try:
        how, starts = await_update(dev, log, timeout)
    except KeyboardInterrupt:
        give_back()
        raise KeyboardInterrupt("no longer waiting: the update goes on on the "
                                "Flipper") from None
    finally:
        log.close()
        if sys.stderr.isatty():
            sys.stderr.write("\r\x1b[K")
    took = time.monotonic() - start
    look = (f"`./flipperemu -d {dev.name} shot FILE.png` shows its screen, "
            f"`./flipperemu -d {dev.name} log` what it logged")
    if how != "back":
        give_back()
    if how == "error":
        sys.exit(f"[{dev.name}] the updater stopped at an error after "
                 f"{took:.0f} s, and waits on its screen: holding Back there "
                 f"(`./flipperemu -d {dev.name} press --hold 1500 back`) "
                 f"starts the firmware that is on the Flipper.  {look}")
    if how == "ended":
        sys.exit(f"[{dev.name}] the emulator ended while the updater worked")
    if how == "restarted":
        sys.exit(f"[{dev.name}] was started anew while the updater worked")
    if how == "timeout":
        sys.exit(f"[{dev.name}] the Flipper's USB serial port is not back "
                 f"after {took:.0f} s (its log shows {starts} starts): the "
                 f"updater may still work, or wait at an error.  {look}")
    cli = open_cli(dev, timeout=30.0)
    try:
        now = dict(re.findall(r"(?m)^([\w.]+) *: (.*)$", cli.run("info device")))
    finally:
        cli.close()
    dev.save_info(**stamp)
    runs = now.get("firmware.version") or "a firmware that does not say which"
    more = ", ".join(f"{what} {now[key]}" for key, what in (
        ("firmware.commit.hash", "commit"), ("firmware.build.date", "built"))
        if now.get(key))
    print(f"[{dev.name}] updated in {took:.0f} s: it runs {runs}"
          + (f" ({more})" if more else ""))
    left = firmware_log_level(dev)
    if left != was:
        # the firmware's own doing (the official updater: default; Unleashed's:
        # none), and what a real Flipper has after an update too
        print(f"[{dev.name}] its updater left the firmware's log level at "
              f"{log_level_text(left)} (it was {log_level_text(was)}): "
              f"`./flipperemu -d {dev.name} log --set-level {was}` sets it "
              "again, from the firmware's next start "
              f"(`./flipperemu -d {dev.name} reset`)")
    return 0


def cmd_update(args):
    return send_update(Device(args.device), pathlib.Path(args.package),
                       keep_radio=args.keep_radio, wait=not args.no_wait,
                       timeout=args.timeout, through_cli=args.cli)


def cmd_pull(args):
    import fe_files
    dev = Device(args.device)
    sources = list(args.paths)
    local = sources.pop() if len(sources) > 1 and not CARD_PATH.match(sources[-1]) \
        else "."
    files, close = open_card(dev)
    try:
        with held_interrupt("stopping when the Flipper has sent this file: "
                            "it cannot be told to stop") as stop:
            copied, same = fe_files.pull(files, sources, local,
                                         force=args.force,
                                         progress=transfer_progress(),
                                         stop=stop)
    except fe_files.Interrupted:
        raise
    except KeyboardInterrupt:
        if isinstance(files, fe_files.CliFiles):
            raise fe_files.Interrupted(
                "interrupted; if the Flipper was sending a file, it sends the "
                "rest to nobody, and its CLI answers again when that is done"
            ) from None
        raise
    finally:
        close()
    print(copied_text(dev, files, copied, same))
    return 0


def log_trouble(path, start):
    """([lines], crash): what the firmware logged from byte `start` of its log
    on that is a warning or worse, and its crash message if it had one"""
    import fe_log
    try:
        with open(path, "rb") as f:
            f.seek(start)
            text = f.read().decode(errors="replace")
    except OSError:
        return [], None
    lines, crash = [], None
    for raw in text.splitlines():
        line = fe_log.parse(raw)
        found = fe_log.crash_of(line)
        if found:
            crash = f"{found[1]}"
        elif line.level in ("W", "E"):
            # (a line may hold bytes of a file the firmware could not read)
            text = re.sub(r"[^\x20-\x7e]+", "?", line.plain)
            lines.append(text if len(text) <= 120 else text[:119] + "…")
    return lines, crash


def app_copy(files, local, to):
    """Put a .fap on the card: over the app of its file name, else into
    /ext/apps, or into the folder `to`.  Its path there."""
    import fe_files
    remote = fe_files.clean(to) + "/" if to else None
    (_, target), = fe_files.plan_push(files, [local], remote)[1]
    with held_interrupt("stopping after this piece") as stop:
        fe_files.push(files, [local], target, progress=transfer_progress(),
                      stop=stop)
    return target


def press_back(dev, long=False):
    m = open_monitor(dev)
    try:
        m.press("back", 1200 if long else 120)
    finally:
        m.close()


def app_close(dev, cli):
    """Close the app that runs, with its Back button if it has to be.
    What to say about it: a list, empty when none ran."""
    import fe_apps
    try:
        mark = dev.uart.stat().st_size
    except OSError:
        mark = None
    try:
        closed = fe_apps.close(
            cli, back=lambda long=False: press_back(dev, long))
    except (fe_apps.Restarted, TimeoutError) as e:
        # a release build starts again after a crash, a debug build halts
        halt = None if isinstance(e, fe_apps.Restarted) else firmware_halt(dev)
        if isinstance(e, TimeoutError) and not halt:
            raise
        crash = log_trouble(dev.uart, mark)[1] if mark is not None else None
        # its log has no report of a crash that came in the middle of another
        # thread's line; a release build has the reason in a register then
        fault = None if crash or halt else firmware_fault(dev)
        reason = crash or (fault if fault != NO_REASON else None)
        if crash:
            report = f"`./flipperemu -d {dev.name} log` has the firmware's report"
        elif fault or halt:
            report = ("The firmware's log has no report of it (what a crash "
                      "prints is lost when another thread is in the middle of "
                      "a line there)"
                      + (": the reason is from its fault register, and on its "
                         "screen" if reason else ""))
        else:
            report = "The firmware's log has no report of a crash"
        raise fe_apps.AppError(
            "the firmware "
            + (f"crashed ({reason})" if reason else
               "crashed" if fault else "stopped")
            + " when the app was asked to close, and "
            + ("has halted: a debug build waits for a debugger there" if halt
               else "has started again")
            + ".  The loader's request ends an app where it is, and not every "
            "app is ready for that in the middle of its work (reading, "
            "sending): leave that with its Back button first.  " + report
            + (f"; {halt_text(dev, halt)[1]}" if halt else "")
        ) from None
    return [f'"{name}" closed' + (" (with its Back button: it takes no "
                                  "request to close)" if pressed else "")
            for name, pressed in closed]


def cmd_app(args):
    import fe_apps
    import fe_files
    dev = Device(args.device)
    local = fap = None
    if args.app and not CARD_PATH.match(args.app):
        path = pathlib.Path(args.app)
        if path.suffix.lower() == ".fap" or os.sep in args.app:
            if not path.is_file():
                sys.exit(f"flipperemu: {args.app}: no such file")
            local = path
    if (args.close or args.list) and (args.app or args.no_start or args.to):
        sys.exit("app: --close and --list stand alone")
    if args.close and args.list:
        sys.exit("app: --close or --list, one of them")
    if (args.to or args.no_start) and not local:
        sys.exit("app: --to and --no-start are for a .fap file from here")
    try:
        if local:
            try:
                fap = fe_apps.manifest(local.read_bytes())
            except fe_apps.AppError as e:
                sys.exit(f"flipperemu: {local}: {e}")
        if not dev.running():
            if not (local and args.no_start):
                sys.exit(f"[{dev.name}] is not running, and it is its firmware "
                         f"that starts apps (`./flipperemu -d {dev.name} run`)"
                         + ("; with --no-start the file is only copied to its "
                            "card" if local else ""))
            files, close = open_card(dev)
            try:
                print(f"{local}: {fe_apps.about(fap)[0]}")
                app_copy(files, local, args.to)
            finally:
                close()
            return 0
        cli = open_cli(dev)
        try:
            return app_session(dev, cli, args, local, fap)
        finally:
            cli.close()
    except fe_apps.AppError as e:
        sys.exit(f"[{dev.name}] {e}")


def app_session(dev, cli, args, local, fap):
    import fe_apps
    import fe_files
    if args.list:
        for title, names in fe_apps.builtin(cli).items():
            if names:
                print(f"{title} (in the firmware):")
            for name in names:
                print(f"  {name}")
        try:
            found = sorted(e.name for e in
                           fe_files.CliFiles(cli).tree("/ext/apps")
                           if not e.is_dir and e.name.lower().endswith(".fap"))
        except fe_files.FilesError:
            found = []
        print("On the card:" if found else "On the card: none")
        for name in found:
            print(f"  /ext/apps/{name}")
        return 0
    if not args.app:
        if args.close:
            for text in app_close(dev, cli) or ["no app runs"]:
                print(f"[{dev.name}] {text}")
        else:
            now = fe_apps.running(cli)
            print(f'[{dev.name}] "{now}" runs' if now
                  else f"[{dev.name}] no app runs")
        return 0

    if local:
        line, warn = fe_apps.about(fap, fe_apps.firmware_api(cli))
        print(f"{local}: {line}")
        if warn:
            print(f"  ({warn})", file=sys.stderr)
    if not args.no_start:
        for text in app_close(dev, cli):
            print(f"[{dev.name}] {text}")
    what = (app_copy(fe_files.CliFiles(cli), local, args.to) if local
            else args.app)
    if args.no_start:
        return 0

    try:
        mark = dev.uart.stat().st_size
    except OSError:
        mark = None

    def logged():
        return log_trouble(dev.uart, mark) if mark is not None else ([], None)

    def waiting():
        if firmware_halt(dev):          # nobody is asking: said below
            raise TimeoutError("the firmware gives no answer")
        left = max(0.0, args.wait - fe_apps.QUESTION)
        print(f"[{dev.name}] no answer yet: the Flipper may be asking on its "
              "screen whether to start it.  Answer there (in the window, or "
              "`press right` / `press back` from another terminal); in "
              f"{left:g} s it is cancelled with Back.", file=sys.stderr)

    said = lost = now = None
    cancelled = False
    try:
        said, cancelled = fe_apps.start(cli, what, " ".join(args.args),
                                        wait=args.wait, waiting=waiting,
                                        back=lambda: press_back(dev))
        if not said:
            time.sleep(1.0)                 # an app that fails does it at once
            if not logged()[1]:
                now = fe_apps.running(cli)
    except (ConnectionError, TimeoutError) as e:
        lost = str(e)
    lines, crash = logged()
    if said:                                # the log has the same sentence
        lines = [text for text in lines if said not in text]
    if lines:
        print("  warnings and errors in the firmware's log since then:")
        for text in lines[-12:]:
            print(f"    {text}")
    halt = firmware_halt(dev) if crash or lost else None
    if halt:
        what, todo = halt_text(dev, halt)
        why = f"the firmware {what}.  {todo}"
    elif crash:
        why = f"the firmware crashed with it, and started again: {crash}"
    elif lost:
        why = lost
    elif said or cancelled:
        why = (("nobody answered the Flipper's question, and it was cancelled "
                "with Back.  " if cancelled else "")
               + f"The loader did not start it: {said or 'it gave no reason'}")
        if not cancelled:
            why = why[0].lower() + why[1:]
    else:
        print(f'[{dev.name}] "{now}" runs' if now
              else f"[{dev.name}] it was started, and has ended already")
        return 0
    sys.stdout.flush()
    print(f"[{dev.name}] {why}", file=sys.stderr)
    return 1


