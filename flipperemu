ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))

QEMU = ROOT / "build" / "qemu" / "qemu-system-arm"
DEVICES = ROOT / "devices"
FLASH_BASE = 0x08000000
FLASH_SIZE = 1 << 20
SECURE_START = 0x080D7000          # SFSA 0xD7: CPU2 area, never written


# ------------------------------------------------------------ firmware IO

def parse_dfu(data: bytes):
    """DfuSe: yields (address, bytes) elements."""
    if data[:5] != b"DfuSe":
        raise ValueError("not a DfuSe file")
    off, out = 11, []
    for _ in range(data[10]):
        if data[off:off + 6] != b"Target":
            raise ValueError("bad DfuSe target prefix")
        nel = struct.unpack_from("<I", data, off + 270)[0]
        off += 274
        for _ in range(nel):
            addr, size = struct.unpack_from("<II", data, off)
            out.append((addr, data[off + 8:off + 8 + size]))
            off += 8 + size
    return out


def parse_elf(data: bytes):
    """Loadable file contents at their physical (load) addresses."""
    if data[:4] != b"\x7fELF" or data[4] != 1:
        raise ValueError("not a 32-bit ELF")
    phoff, = struct.unpack_from("<I", data, 28)
    phentsize, phnum = struct.unpack_from("<HH", data, 42)
    out = []
    for i in range(phnum):
        p_type, p_off, _vaddr, p_paddr, p_filesz = struct.unpack_from(
            "<IIIII", data, phoff + i * phentsize)
        if p_type == 1 and p_filesz and FLASH_BASE <= p_paddr < FLASH_BASE + FLASH_SIZE:
            out.append((p_paddr, data[p_off:p_off + p_filesz]))
    if not out:
        raise ValueError("ELF has nothing to load into flash")
    return out


def load_firmware(path: pathlib.Path):
    """-> (elements, elf_bytes_or_None, resources_source_or_None, label)"""
    raw = path.read_bytes()
    name = path.name.lower()
    if raw[:4] == b"\x7fELF":
        return parse_elf(raw), raw, None, path.name
    if raw[:5] == b"DfuSe":
        return parse_dfu(raw), None, None, path.name
    if name.endswith((".tgz", ".tar.gz", ".tar")):
        with tarfile.open(path, "r:*") as tar:
            names = tar.getnames()
            dfu = next((n for n in names if n.endswith("firmware.dfu")), None)
            if not dfu:
                raise ValueError("no firmware.dfu in the package")
            fuf = next((n for n in names if n.endswith("update.fuf")), None)
            label = path.name
            if fuf:
                for line in tar.extractfile(fuf).read().decode(errors="replace").splitlines():
                    if line.startswith("Info:"):
                        label = line.split(":", 1)[1].strip()
            return parse_dfu(tar.extractfile(dfu).read()), None, path, label
    if name.endswith(".bin"):
        return [(FLASH_BASE, raw)], None, None, path.name
    raise ValueError(f"don't know how to load {path}")


# ---------------------------------------------------------------- device

class Device:
    def __init__(self, name: str):
        self.name = name
        self.dir = DEVICES / name
        self.flash = self.dir / "flash.img"
        self.sd = self.dir / "sd.img"
        self.elf = self.dir / "firmware.elf"
        self.meta = self.dir / "device.json"
        self.monitor = self.dir / "monitor.sock"
        self.uart = self.dir / "uart.log"       # what the firmware logged, this run
        self.uart_old = self.dir / "uart.log.1"     # ... and the run before
        self.nvram = self.dir / "nvram.bin"     # gauge + RTC backup domain
        self.enclave = self.dir / "enclave.keys"    # the secure enclave's keys
        self.usb_sock = self.dir / "usb.sock"   # --usb unix
        self.usb_tty = self.dir / "usb.tty"     # --usb pty: symlink to the pty
        self.subghz_sock = self.dir / "subghz.sock"     # a radio bridge (fe_sdr.py)
        self.nfc_sock = self.dir / "nfc.sock"           # a card on the link (fe_nfc_link.py)
        self.panel_sock = self.dir / "panel.sock"       # its face: the window (fe_gui.py)
        self.held_file = self.dir / "held.json"         # names of what is held to it
        self.gdb_sock = self.dir / "gdb.sock"           # its gdb stub, once asked for
        self.gdb_init = self.dir / "gdb.init"           # ... and what gdb is told (cmd_gdb)
        self.gdb_apps = self.dir / "gdb-apps"           # ... links to apps' debug ELFs

    def running(self):
        """Is a QEMU serving this device's monitor socket?"""
        if not self.monitor.exists():
            return False
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            s.connect(str(self.monitor))
            return True
        except BlockingIOError:         # one is, with others waiting for it
            return True
        except OSError:
            return False
        finally:
            s.close()

    def held(self):
        """What the commands last held to it: {'nfc': label, 'rfid': ..}"""
        try:
            return json.loads(self.held_file.read_text())
        except (OSError, ValueError):
            return {}

    def set_held(self, what, label):
        """The emulator has the card's bytes, not what it was called: `status`
        and the window read that here.  label None: taken away."""
        held = self.held()
        if label:
            held[what] = label
        else:
            held.pop(what, None)
        tmp = self.held_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(held, indent=2) + "\n")
        os.replace(tmp, self.held_file)

    def refuse_if_running(self):
        # two emulators (or mtools) on one flash/SD image corrupt it
        if self.running():
            sys.exit(f"[{self.name}] is running: ./flipperemu -d {self.name} stop first")

    def info(self):
        try:
            return json.loads(self.meta.read_text())
        except (OSError, ValueError):
            return {}

    def save_info(self, **kw):
        info = self.info()
        info.update(kw)
        self.meta.write_text(json.dumps(info, indent=2) + "\n")

    def program(self, fw: pathlib.Path, erase_all: bool = False):
        elements, elf, resources, label = load_firmware(fw)
        self.dir.mkdir(parents=True, exist_ok=True)
        if not self.flash.exists() or erase_all:
            self.flash.write_bytes(b"\xff" * FLASH_SIZE)
        img = bytearray(self.flash.read_bytes().ljust(FLASH_SIZE, b"\xff"))
        # like DFU: erase every touched 4 KiB page first, then program
        for addr, data in elements:
            if addr < FLASH_BASE or addr + len(data) > SECURE_START:
                raise ValueError(f"element {addr:#x}+{len(data)} outside user flash")
            off = addr - FLASH_BASE
            first, last = off // 4096, (off + len(data) - 1) // 4096
            img[first * 4096:(last + 1) * 4096] = b"\xff" * ((last - first + 1) * 4096)
        for addr, data in elements:
            off = addr - FLASH_BASE
            img[off:off + len(data)] = data
        self.flash.write_bytes(img)
        if elf:
            self.elf.write_bytes(elf)
        elif self.elf.exists():
            self.elf.unlink()                   # stale symbols would mislead gdb
        if resources is None:
            resources = find_resources_for(fw)
        self.save_info(firmware=label, source=str(fw.resolve()),
                       flashed=time.strftime("%Y-%m-%d %H:%M:%S"),
                       bytes=sum(len(d) for _, d in elements),
                       **({"resources": str(resources.resolve())} if resources else {}))
        return label, resources

    def make_sd(self, resources=None, size="512M", force=False):
        cmd = [sys.executable, "-I", str(ROOT / "scripts" / "make_sdcard.py"),
               str(self.sd), "--size", size]
        if resources:
            cmd += ["--resources", str(resources)]
        if force:
            cmd.append("--force")
        subprocess.run(cmd, check=True)


def find_resources_for(fw: pathlib.Path):
    """Release folders from fetch_firmware.py keep resources next to the ELF."""
    for pat in ("*update*.tgz", "*resources*.tgz"):
        hits = sorted(fw.parent.glob(pat))
        if hits:
            return hits[0]
    return None


def unpack_update(pkg: pathlib.Path, tmp: pathlib.Path, keep_radio: bool):
    """An update package (a .tgz, its folder, or the update.fuf in that), made
    ready for the card under tmp: (its folder, what its manifest calls it).

    The emulated CPU2 is ST's FUS without a radio stack and cannot install
    one, so unless keep_radio is set the radio stage is blanked exactly as
    `fbt updater_package` writes a package without a stack. Every key stays
    in place: the firmware reads the manifest's optional keys in file order,
    and a missing one would hide all the keys after it.
    """
    from make_sdcard import safe_extract
    def one(manifests):
        if len(manifests) != 1:
            sys.exit(f"{pkg}: expected one update.fuf, found {len(manifests)}")
        return manifests[0].parent

    if pkg.name == "update.fuf" and pkg.is_file():
        pkg = pkg.resolve().parent
    if pkg.is_dir():
        folder = one(sorted(pkg.rglob("update.fuf"))).resolve()
        shutil.copytree(folder, tmp / folder.name)
    elif not pkg.exists():
        sys.exit(f"{pkg}: no such update package")
    else:
        try:
            with tarfile.open(pkg, "r:*") as tar:
                safe_extract(tar, tmp)
        except (tarfile.TarError, ValueError, EOFError):
            sys.exit(f"{pkg}: not an update package (a .tgz, or the folder "
                     "that was in one)")
    pdir = one(sorted(tmp.rglob("update.fuf")))
    if not keep_radio:
        fuf = pdir / "update.fuf"
        text = fuf.read_text()
        text = re.sub(r"(?m)^Radio: .*$", "Radio: ", text)
        text = re.sub(r"(?m)^Radio version: .*$",
                      "Radio version: 00 00 00 00 00 00", text)
        fuf.write_text(text)
        (pdir / "radio.bin").unlink(missing_ok=True)
    info = re.search(r"(?m)^Info: *(.+)$", (pdir / "update.fuf").read_text())
    return pdir, (info.group(1).strip() if info else pdir.name)


def stage_update(dev: Device, pkg: pathlib.Path, keep_radio: bool) -> str:
    """Put an update package on the SD card (of a device that does not run)
    the way qFlipper does; return the manifest path as the firmware sees it,
    and what the package calls itself."""
    import tempfile
    with tempfile.TemporaryDirectory(prefix="fe-update-") as tmp:
        pdir, label = unpack_update(pkg, pathlib.Path(tmp), keep_radio)
        img = ["-i", str(dev.sd)]
        subprocess.run(["mmd", *img, "::update"], capture_output=True)
        subprocess.run(["mdeltree", *img, f"::update/{pdir.name}"], capture_output=True)
        subprocess.run(["mcopy", *img, "-s", "-Q", str(pdir), "::update/"], check=True)
    return f"/ext/update/{pdir.name}/update.fuf", label


# --------------------------------------------------------------- commands

def cmd_flash(args):
    dev = Device(args.device)
    dev.refuse_if_running()
    label, _ = dev.program(pathlib.Path(args.firmware), args.erase_all)
    print(f"[{dev.name}] flashed {label} -> {dev.flash}")


def cmd_sd(args):
    dev = Device(args.device)
    if args.action:                     # the card of a running device
        m = open_monitor(dev)
        try:
            err = m.cmd("qom-set /machine sd-card "
                        + ("on" if args.action == "insert" else "off"))
        finally:
            m.close()
        if err:
            sys.exit(f"sd: {err.removeprefix('Error: ')}")
        print(f"[{dev.name}] microSD card: "
              + ("pushed in" if args.action == "insert" else "pulled out"))
        return 0
    dev.refuse_if_running()
    dev.dir.mkdir(parents=True, exist_ok=True)
    dev.make_sd(args.resources, args.size, force=True)


def audio_backends():
    """Audio drivers compiled into our QEMU (configure enables PipeWire,
    PulseAudio, ALSA or SDL when their development headers are installed)."""
    try:
        out = subprocess.run([str(QEMU), "-audiodev", "help"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [l.strip() for l in out.splitlines()[1:] if l.strip()]


def audio_args(args):
    """-audiodev for the speaker: none | wav:PATH | a QEMU audio driver | auto"""
    choice = args.audio
    if choice == "auto":
        if args.headless or args.print_cmd:
            return []
        have = audio_backends()
        choice = next((b for b in ("pipewire", "pa", "alsa", "sdl") if b in have), None)
        if not choice:
            print("(no speaker: this QEMU has no PipeWire/PulseAudio/ALSA/SDL audio; "
                  "install e.g. pipewire-devel and re-run scripts/setup_qemu.sh, "
                  "or record with --audio wav:FILE)")
            return []
    if choice == "none":
        return []
    if choice.startswith("wav:"):
        return ["-audiodev", f"wav,id=snd0,path={pathlib.Path(choice[4:]).resolve()}"]
    return ["-audiodev", f"{choice},id=snd0"]


def pick_window(args):
    """What a run shows: 'qt', the window that looks like a Flipper
    (scripts/fe_gui.py), 'gtk', QEMU's own window with the bare LCD, or 'none'"""
    if args.headless:
        return "none"
    if args.gtk:
        return "gtk"
    import importlib.util
    if importlib.util.find_spec("PySide6"):
        return "qt"
    if not args.print_cmd:
        print("(PySide6 is not installed: this is QEMU's own window, the bare LCD. "
              "With `pip install PySide6`, or your distribution's python3-pyside6, "
              "there is a Flipper around it)")
    return "gtk"


def need_display():
    if not any(os.environ.get(v) for v in ("WAYLAND_DISPLAY", "DISPLAY",
                                           "QT_QPA_PLATFORM")):
        sys.exit("no display to open a window on: `run --headless` runs without one")


# A plausible cell voltage for a charge level.  An empty battery's is under
# what the emulated gauge takes for "shut down now" (3150 mV), and the firmware
# then does, off USB: as a real Flipper with a flat battery.
BATTERY_CURVE = ((0, 3100), (1, 3400), (5, 3480), (10, 3600), (20, 3700),
                 (50, 3820), (80, 4020), (87, 4061), (100, 4180))


def battery_voltage(percent):
    for (p0, v0), (p1, v1) in zip(BATTERY_CURVE, BATTERY_CURVE[1:]):
        if percent <= p1:
            return round(v0 + (v1 - v0) * (percent - p0) / (p1 - p0))
    return BATTERY_CURVE[-1][1]


def chardev_path(path):
    """A path as the value of a -chardev option: its commas doubled"""
    return str(path).replace(",", ",,")


def serial_args(dev: Device, serial):
    """USART1: the firmware's log, and pins 13 and 14 of a real one.  Whatever
    it is connected to, what the firmware writes to it is kept in the
    device's uart.log, for `flipperemu log` and the window."""
    log = f",logfile={chardev_path(dev.uart)},logappend=on"
    if serial in ("stdio", "pty", "null"):
        backend = serial
    elif serial.startswith("tcp:"):
        host, _, port = serial[4:].rpartition(":")
        if not port.isdigit() or not 0 < int(port) < 65536:
            sys.exit(f"--serial: expected tcp:PORT or tcp:HOST:PORT, not {serial!r}")
        # the firmware listens on it too (for an expansion module): this
        # computer only, unless asked
        backend = (f"socket,host={host.strip('[]') or '127.0.0.1'},port={port},"
                   "server=on,wait=off")
    elif serial.startswith("file:"):
        path = pathlib.Path(serial[5:])
        backend = f"file,path={chardev_path(path)},append=on"
        if path.resolve() == dev.uart.resolve():
            log = ""                    # it is the log
    else:
        return ["-serial", serial]      # QEMU's own words: no uart.log
    name, _, options = backend.partition(",")
    return ["-chardev", f"{name},id=uart" + (f",{options}" if options else "") + log,
            "-serial", "chardev:uart"]


def new_log(dev: Device, serial):
    """A run starts a new log, and the one before it is kept as uart.log.1.
    (Each QEMU of a run adds to the log: switching the Flipper off and on in
    its window loses nothing.)"""
    try:
        if dev.uart.stat().st_size:
            os.replace(dev.uart, dev.uart_old)
    except OSError:
        pass
    if serial.startswith("file:"):
        path = pathlib.Path(serial[5:])
        try:
            if path.is_file():
                os.truncate(path, 0)
        except OSError:
            pass


def qemu_cmd(dev: Device, args, window="gtk", gauge=None):
    """gauge: {property: value} of /machine/gauge to start with"""
    machine = (f"flipper-zero,name={args.name or dev.name[:8]}"
               f",lcd-scale={args.scale or 4}"
               f",nvram={dev.nvram},enclave={dev.enclave}")
    if args.legacy_sleep:
        machine += ",legacy-sleep=on"
    if args.unplugged:
        machine += ",usb-cable=off"
    if args.log_level:
        machine += f",log-level={args.log_level}"
    usb = []
    if args.usb == "pty":
        usb = ["-chardev", "pty,id=usb"]
    elif args.usb == "unix":
        usb = ["-chardev", f"socket,id=usb,path={dev.usb_sock},server=on,wait=off"]
    elif args.usb.startswith("tcp:"):
        usb = ["-chardev", f"socket,id=usb,host=127.0.0.1,port={args.usb[4:]},"
                           "server=on,wait=off"]
    elif args.usb != "none":
        sys.exit(f"--usb: expected pty, unix, tcp:PORT or none, not {args.usb!r}")
    if usb:
        machine += ",usb-serial=usb"
    if args.usbip:
        usb += ["-chardev", f"socket,id=usbip,host={args.usbip_host},"
                            f"port={args.usbip},server=on,wait=off"]
        machine += ",usbip=usbip"
    audio = audio_args(args)
    if audio:
        machine += ",audiodev=snd0"
    cmd = [str(QEMU), "-M", machine, *usb, *audio,
           # every Sub-GHz transmission is saved as a .sub RAW file, every
           # infrared one as an .ir file, every 125 kHz emulation as a
           # capture of what a reader would see, and what the virtual NFC
           # reader reads from an emulated card as a .nfc file
           "-global", f"cc1101.tx-dir={dev.dir / 'subghz-tx'}",
           # a real radio (an SDR, through scripts/fe_sdr.py) can be the
           # CC1101's antenna: `./flipperemu subghz --sdr ...`
           "-chardev", f"socket,id=subghz-link,path={dev.subghz_sock},server=on,wait=off",
           "-global", "cc1101.link=subghz-link",
           # and a card on the NFC link (a program, or a real reader's antenna)
           "-chardev", f"socket,id=nfc-link,path={dev.nfc_sock},server=on,wait=off",
           "-global", "st25r3916.link=nfc-link",
           # the front panel: the LCD, the lights and the buttons, for the
           # window drawn around them (docs/PANEL_LINK.md)
           "-chardev", f"socket,id=panel,path={dev.panel_sock},server=on,wait=off",
           "-global", "flipper-panel.link=panel",
           "-global", f"flipper-ir.tx-dir={dev.dir / 'ir-tx'}",
           "-global", f"flipper-rfid.tx-dir={dev.dir / 'rfid-tx'}",
           "-global", f"flipper-ibutton.tx-dir={dev.dir / 'ibutton-tx'}",
           "-global", f"st25r3916.tx-dir={dev.dir / 'nfc-tx'}",
           "-drive", f"if=pflash,format=raw,file={dev.flash}",
           "-rtc", "base=localtime",
           "-monitor", f"unix:{dev.monitor},server=on,wait=off",
           "-name", f"Flipper Zero ({dev.name})"]
    for prop, value in (gauge or {}).items():
        cmd += ["-global", f"bq27220.{prop}={value}"]
    if not args.no_sd and dev.sd.exists():
        cmd += ["-drive", f"if=sd,format=raw,file={dev.sd}"]
    if window == "gtk":
        cmd += ["-display", "gtk,show-menubar=off,zoom-to-fit=off"]
    else:                               # none, or the window is ours
        cmd += ["-display", "none"]
    cmd += serial_args(dev, args.serial)
    if args.gdb or args.wait_gdb:
        cmd += ["-gdb", f"tcp:127.0.0.1:{args.gdb_port}"]
    if args.wait_gdb:
        cmd += ["-S"]
    return cmd + list(args.qemu_args or [])


def cmd_run(args):
    if not QEMU.exists():
        sys.exit(f"QEMU not built yet: run scripts/setup_qemu.sh ({QEMU})")
    dev = Device(args.device)
    if not args.print_cmd:
        dev.refuse_if_running()
    if args.update and (args.usb == "none" or args.unplugged):
        sys.exit("--update starts the install over the USB CLI; drop --usb none "
                 "and --unplugged")
    gauge = None
    if args.battery is not None:
        if not 0 <= args.battery <= 100:
            sys.exit("--battery: 0 to 100 percent")
        gauge = {"soc": args.battery, "voltage-mv": battery_voltage(args.battery)}
    window = pick_window(args)
    if window == "qt" and not args.print_cmd:
        need_display()
    if args.firmware:
        fw = pathlib.Path(args.firmware)
        label, resources = dev.program(fw, args.erase_all)
        print(f"[{dev.name}] flashed {label}")
        if not dev.sd.exists() and not args.no_sd and not args.print_cmd:
            dev.make_sd(resources or find_resources_for(fw))
    if not dev.flash.exists():
        sys.exit(f"[{dev.name}] nothing flashed yet: ./flipperemu run -f <firmware>")
    if args.print_cmd:
        print(" ".join(qemu_cmd(dev, args, window, gauge)))
        return 0
    if not dev.sd.exists() and not args.no_sd:
        dev.make_sd(dev.info().get("resources"))
    manifest = label = None
    if args.update:
        if args.no_sd:
            sys.exit("--update needs the SD card")
        manifest, label = stage_update(dev, pathlib.Path(args.update), args.keep_radio)
        print(f"[{dev.name}] staged {manifest}"
              + ("" if args.keep_radio else " (radio stage dropped: the emulated "
                 "CPU2 cannot install a stack)"))
    info = dev.info()
    print(f"[{dev.name}] {info.get('firmware', '?')}  "
          f"(monitor: {dev.monitor}"
          + (f", gdb: :{args.gdb_port}" if args.gdb or args.wait_gdb else "") + ")")
    new_log(dev, args.serial)
    session = Session(dev, args, window, gauge, manifest, label)
    session.start()
    # killing the launcher stops the emulator too (Ctrl-C already reaches both)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, frame: session.signal(signum))
    if args.usbip:
        print(f"[{dev.name}] USB/IP on {args.usbip_host}:{args.usbip}: attach with "
              f"`sudo {ROOT / 'scripts' / 'usbip_attach.py'} --port {args.usbip}`",
              flush=True)
    if window == "qt":
        import fe_gui
        return fe_gui.run(dev.name, dev.dir, ROOT / "flipperemu", session=session,
                          scale=args.scale)
    try:
        return session.proc.wait()
    except KeyboardInterrupt:
        return session.stop()
    finally:
        session.tidy()


class Session:
    """A device's QEMU.  It exits when the Flipper switches itself off;
    start() again is switching it back on (the window does that)."""

    def __init__(self, dev, args, window, gauge=None, manifest=None, label=None):
        self.dev, self.args, self.window = dev, args, window
        self.gauge = dict(gauge or {})
        self.update = (manifest, label)
        self.proc = None

    def start(self, unplugged=None, gauge=None):
        """unplugged, gauge: as it was left when it went off (default: as
        the run was asked for)"""
        dev, args = self.dev, self.args
        if unplugged is not None:
            args.unplugged = unplugged
        if gauge is not None:
            self.gauge = dict(gauge)
        for stale in (dev.monitor, dev.usb_tty, dev.panel_sock, dev.held_file,
                      dev.gdb_sock):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass
        self.proc = subprocess.Popen(qemu_cmd(dev, args, self.window, self.gauge))
        manifest, label = self.update
        self.update = (None, None)          # an update is started once
        args.log_level = None               # ... and its log level set once
        if args.usb == "pty" or manifest:
            threading.Thread(target=usb_helpers,
                             args=(dev, self.proc, args.usb, manifest, label),
                             daemon=True).start()
        return self.proc

    def poll(self):
        """QEMU's exit code once it is gone, None while it runs"""
        return self.proc.poll() if self.proc else 0

    def tidy(self):
        """Behind a QEMU that is gone: what only meant something while it ran"""
        for stale in (self.dev.usb_tty, self.dev.held_file):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass

    def signal(self, signum):
        if self.proc and self.proc.poll() is None:
            self.proc.send_signal(signum)

    def stop(self, timeout=10):
        """As `flipperemu stop`: QEMU saves the NVRAM on its way out."""
        if not self.proc:
            return 0
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        return self.proc.wait()


def start_update(cli, manifest):
    """Tell the firmware, at its CLI prompt, to install the package whose
    manifest this is.  None when it restarts to do so (no prompt comes after
    that), else what it said instead."""
    cli.write(f"update install {manifest}\r".encode())
    out, end = b"", time.time() + 20
    while time.time() < end and b"BRB" not in out and b"Error" not in out:
        if cli._fill(0.2):
            out += cli.buf
            cli.buf = b""
    text = out.decode(errors="replace")
    if "BRB" in text:
        return None
    err = re.search(r"Error: [^\r\n]*", text)
    return err.group(0) if err else text.strip() or "no answer to `update install`"


def usb_helpers(dev: Device, proc, usb_mode, manifest, label=None):
    """Link devices/<name>/usb.tty to QEMU's pty for the USB serial port, and
    start a staged update through the firmware's CLI (as qFlipper does)."""
    from fe_cli import FlipperCli, usb_endpoint
    ep = None
    for _ in range(100):
        if proc.poll() is not None:
            return
        if dev.monitor.exists():
            try:
                ep = usb_endpoint(dev.monitor)
            except OSError:
                ep = None
            if ep:
                break
        time.sleep(0.1)
    if not ep:
        return
    if ep[0] == "pty":
        dev.usb_tty.symlink_to(ep[1])
        print(f"[{dev.name}] USB serial (CLI/RPC): {ep[1]} -> {dev.usb_tty}"
              f"   (./flipperemu -d {dev.name} cli)", flush=True)
    if not manifest:
        return
    try:
        cli = FlipperCli(ep)
        try:
            cli.read_until_prompt(60)
            refused = start_update(cli, manifest)
        finally:
            cli.close()
    except (OSError, TimeoutError, ConnectionError) as e:
        print(f"[{dev.name}] could not start the update over USB: {e}", flush=True)
        return
    if refused:
        print(f"[{dev.name}] update refused: {refused}", flush=True)
    else:
        print(f"[{dev.name}] updater started: {manifest}", flush=True)
        dev.save_info(firmware=f"{label} (installed by update)",
                      flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)


def cmd_stop(args):
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        print(f"[{dev.name}] not running")
        return 0
    m = Monitor(str(dev.monitor))
    m.s.sendall(b"quit\n")
    m.close()
    for _ in range(100):                # QEMU removes the socket on exit
        if not dev.monitor.exists():
            break
        time.sleep(0.1)
    print(f"[{dev.name}] stopped")
    return 0


def open_monitor(dev):
    from fe_monitor import Monitor
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    return Monitor(str(dev.monitor))


def qom_get(m, path, prop):
    """A QOM property through the monitor (which prints JSON); None: none"""
    try:
        return json.loads(m.cmd(f"qom-get {path} {prop}"))
    except ValueError:
        return None


def stopped(m):
    """Why a running device stands still, or "": "paused" (somebody paused
    it), "debug" (a debugger has it), or another of QEMU's run states.  A
    link's own stop for an answer (NFC) is none: that is over in a moment."""
    why = qom_get(m, "/machine/panel", "stopped")
    if why is None:                 # an emulator from before it could say
        hit = re.search(r"paused(?: \((.+?)\))?", m.cmd("info status"))
        why = (hit.group(1) or "paused") if hit else ""
    return why


def still_text(dev, why):
    """... in words, with what ends it"""
    if why == "paused":
        return f"it is paused (`./flipperemu -d {dev.name} continue`)"
    if why == "debug":
        return "a debugger has it stopped (`continue` there)"
    return f"it stands still (QEMU's state: {why})"


def halted_at(m):
    """Where the firmware sleeps for good, or None: it has not halted.  A
    debug build that crashed waits for a debugger, and furi_halt() waits for
    the end, both in the same two instructions with the interrupts off:
    `wfi`, and a branch back to it.  A firmware that is alive goes on after
    its `wfi` (there are those two places in an image, and no third)."""
    hit = re.search(r"\bR15=([0-9a-f]{8})", m.cmd("info registers"))
    pc = int(hit.group(1), 16) & ~1 if hit else 0
    if pc < 2:
        return None
    code = [int(word, 16) for word in
            re.findall(r"\b0x([0-9a-f]{4})\b", m.cmd(f"x/3hx {pc - 2:#x}"))]
    if code[1:3] == HALT_LOOP:
        return pc
    return pc - 2 if code[0:2] == HALT_LOOP else None


HALT_LOOP = [0xbf30, 0xe7fd]            # wfi; b .-2
FAULT_REGISTER = 0x40002860             # RTC backup register 4
FLASH = range(0x08000000, 0x08100000)
NO_REASON = "Check serial logs"         # its message was not in the flash


def last_fault(m):
    """What the firmware's last crash said, or None.  A release build that
    crashes writes a pointer to its message into a register that lives through
    the restart, shows the message on its desktop afterwards ("Flipper crashed
    and was rebooted") and clears the register when that screen is left.
    A message that is not in the flash (an app's own) is not kept: the
    register then points at NO_REASON.

    The log does not always have it: what a crash prints is dropped while
    another thread is in the middle of a line there."""
    word = re.search(r":\s*0x([0-9a-f]{8})\b",
                     m.cmd(f"xp/1wx {FAULT_REGISTER:#x}"))
    at = int(word.group(1), 16) if word else 0
    if at not in FLASH:
        return None
    data = bytes(int(byte, 16)
                 for line in m.cmd(f"xp/64bx {at:#x}").splitlines()
                 for byte in re.findall(r"\b0x([0-9a-f]{2})\b",
                                        line.partition(":")[2]))
    text = data.split(b"\0")[0].decode("ascii", "replace").strip()
    return text if text and text.isprintable() else None


def firmware_fault(dev, m=None):
    """last_fault() of a running device; None as well when the emulator did
    not say"""
    try:
        if m:
            return last_fault(m)
        from fe_monitor import Monitor
        m = Monitor(str(dev.monitor), timeout=2.0)
        try:
            return last_fault(m)
        finally:
            m.close()
    except (OSError, ConnectionError):
        return None


def firmware_halt(dev, m=None):
    """A running device whose firmware has halted: {"at": where its CPU
    sleeps, "kind": "CRASH" or "HALT", "report": what its log says of it}
    (None and None: the log has nothing).  None: it has not halted, or the
    emulator did not say."""
    try:
        if m:
            at = halted_at(m)
        else:
            from fe_monitor import Monitor
            m = Monitor(str(dev.monitor), timeout=2.0)
            try:
                at = halted_at(m)
            finally:
                m.close()
    except (OSError, ConnectionError):
        return None
    if at is None:
        return None
    import fe_log
    found = None
    try:
        with open(dev.uart, "rb") as f:     # its report is the last it wrote
            f.seek(max(0, f.seek(0, os.SEEK_END) - 8192))
            for raw in f.read().decode(errors="replace").splitlines():
                found = fe_log.crash_of(fe_log.parse(raw)) or found
    except OSError:
        pass
    kind, report = found or (None, None)
    return {"at": f"{at:#010x}", "kind": kind, "report": report or None}


def halt_text(dev, halt):
    """... in words: (what happened, what to do about it)"""
    said = f" ({halt['report']})" if halt["report"] else ""
    if halt["kind"] == "HALT":
        what = f"halted{said}: its own code asked for that"
    elif halt["kind"] == "CRASH":
        what = (f"crashed{said} and has halted: a debug build waits for a "
                "debugger there, where a release build starts again")
    else:
        what = ("has halted, as a debug build does after a crash (its log "
                "has no report of it)")
    return what, (f"`./flipperemu -d {dev.name} gdb` shows where it stands, "
                  f"`./flipperemu -d {dev.name} reset` starts it again")


def halt_note(args):
    """For a command that got no answer from a device: that its firmware has
    halted, if it has"""
    try:
        dev = Device(args.device)
        halt = firmware_halt(dev) if dev.running() else None
    except (Exception, SystemExit):
        return ""
    if not halt:
        return ""
    what, todo = halt_text(dev, halt)
    return f"\n[{dev.name}] the firmware {what}.  {todo}"


def cmd_pause(args):
    """Time stands still on a running device, until `continue`"""
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        was = stopped(m)
        if not was:
            if m.cmd("qom-set /machine/panel paused true").strip():
                m.cmd("stop")       # an emulator from before `paused`
        why = stopped(m)
        gdb = gdb_stub(m)
    finally:
        m.close()
    if was == "paused":
        print(f"[{dev.name}] is paused already")
    elif was:
        sys.exit(f"[{dev.name}] not paused: {still_text(dev, was)}")
    elif why != "paused":
        sys.exit(f"[{dev.name}] did not pause")
    elif gdb and gdb[1]:
        print(f"[{dev.name}] paused: a gdb is on it, and `continue` there "
              "lets it go on")
    else:
        print(f"[{dev.name}] paused: `./flipperemu -d {dev.name} continue` "
              "lets it go on")
    return 0


def cmd_continue(args):
    """A paused device goes on"""
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        was = stopped(m)
        gdb = gdb_stub(m)
        if was and gdb and gdb[1]:
            # it would run, and the gdb would still take it to stand still
            sys.exit(f"[{dev.name}] a gdb is on it, and it stands still: "
                     "`continue` there lets it go on")
        if was:
            if m.cmd("qom-set /machine/panel paused false").strip():
                m.cmd("cont")       # an emulator from before `paused`
        why = stopped(m)
    finally:
        m.close()
    if why:
        sys.exit(f"[{dev.name}] does not go on: {still_text(dev, why)}")
    print(f"[{dev.name}] " + ("goes on" if was else "is not paused: it runs"))
    return 0


def cmd_gui(args):
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running: `./flipperemu -d {dev.name} run` "
                 "starts it, with its window")
    try:
        import fe_gui
    except ImportError as e:
        sys.exit(f"the window needs PySide6 ({e}): `pip install PySide6`, or your "
                 "distribution's python3-pyside6")
    need_display()
    return fe_gui.run(dev.name, dev.dir, ROOT / "flipperemu", scale=args.scale)


def newest(directory):
    """The newest file in a directory of transmissions, or None"""
    try:
        files = [p for p in directory.iterdir() if p.is_file()]
    except OSError:
        return None
    return str(max(files, key=lambda p: p.stat().st_mtime)) if files else None


def read_battery(m):
    g = lambda prop: qom_get(m, "/machine/gauge", prop)
    current = g("current-ma")
    return {"percent": g("soc"), "voltage_mv": g("voltage-mv"),
            "temperature_c": round(g("temperature-dk") / 10 - 273.15, 1),
            "current_ma": current, "capacity_mah": g("capacity-mah"),
            "charging": current > 0}


def battery_text(b):
    return (f"{b['percent']} %, {b['voltage_mv'] / 1000:.3f} V, "
            f"{b['temperature_c']:.1f} °C, "
            + (f"charging at {b['current_ma']} mA" if b["charging"]
               else f"drawing {-b['current_ma']} mA"))


def read_usb(m):
    cable = qom_get(m, "/machine/soc/usb", "attached")
    power = qom_get(m, "/machine/charger", "usb")
    return {"cable": "computer" if cable else "charger" if power else "unplugged",
            "device": qom_get(m, "/machine/soc/usb", "device") if cable else None}


def usb_text(u):
    if u["cable"] == "computer":
        return {"none": "plugged into a computer, which does not see it (yet)",
                "enumerating": "plugged into a computer, which is finding out what it is",
                "failed": "plugged into a computer, which could not make sense of it",
                "usbip": "plugged in: a PC has it over USB/IP",
                }.get(u["device"], f"plugged into a computer, which sees {u['device']}")
    return "on a charger (power, no data)" if u["cable"] == "charger" else "unplugged"


def device_status(dev):
    """What `status` prints, as a dict (--json: as it is)"""
    st = {"device": dev.name, "running": dev.running(),
          "firmware": dev.info().get("firmware")}
    if not st["running"]:
        return st
    from fe_monitor import Monitor
    held = dev.held()
    m = Monitor(str(dev.monitor))
    try:
        g = lambda path, prop: qom_get(m, path, prop)
        st["stopped"] = stopped(m) or None
        st["halted"] = firmware_halt(dev, m)
        st["fault"] = None if st["halted"] else firmware_fault(dev, m)
        st["usb"] = read_usb(m)
        st["battery"] = read_battery(m)
        st["sd"] = {"card": dev.sd.exists(), "inserted": g("/machine", "sd-card")}
        card = g("/machine/nfc", "card")
        st["nfc"] = {"card": (held.get("nfc") or card) if card else None,
                     "reader_field": g("/machine/nfc", "field"),
                     "radio": g("/machine/nfc", "radio"),
                     "last_read": g("/machine/nfc", "tx") or None}
        t5577 = g("/machine/rfid", "t5577")
        tag = g("/machine/rfid", "tag")
        st["rfid"] = {"tag": (held.get("rfid") or tag or "a T5577")
                      if tag or t5577 else None,
                      "t5577": t5577 or None,
                      "reader_field": g("/machine/rfid", "reader"),
                      "noise": g("/machine/rfid", "noise"),
                      "field": g("/machine/rfid", "field"),
                      "last_emulation": g("/machine/rfid", "tx") or None}
        key = g("/machine/ibutton", "key")
        st["ibutton"] = {"key": (held.get("ibutton") or key) if key else None,
                         "rom": g("/machine/ibutton", "rom") or None,
                         "last_read": g("/machine/ibutton", "tx") or None}
        st["infrared"] = {"last_transmission": g("/machine/ir", "tx") or None}
        st["subghz"] = {"radio": g("/machine/subghz", "radio"),
                        "last_transmission": newest(dev.dir / "subghz-tx")}
        st["sound"] = {"muted": g("/machine/speaker", "mute")}
        st["lights"] = {"led": g("/machine/led", "led"),
                        "blinking": g("/machine/led", "blinking"),
                        "backlight": g("/machine/led", "backlight"),
                        "engines": g("/machine/led", "engines")}
        st["log"] = {"level": g("/machine", "log-level"),
                     "file": str(dev.uart) if dev.uart.exists() else None}
    finally:
        m.close()
    return st


LED_COLOURS = {(1, 0, 0): "red", (0, 1, 0): "green", (0, 0, 1): "blue",
               (1, 1, 0): "yellow", (0, 1, 1): "cyan", (1, 0, 1): "magenta",
               (1, 1, 1): "white"}


def lights_text(lights):
    """The LED and the backlight, as `status` says them"""
    led, back = lights["led"], lights["backlight"]
    if led is None:                 # an emulator from before it could say
        return "?"
    rgb = [int(led[i:i + 2], 16) for i in (0, 2, 4)]
    levels = {v for v in rgb if v}
    name = LED_COLOURS.get(tuple(int(v > 0) for v in rgb)) \
        if len(levels) == 1 else None
    colour = "off" if not levels else f"{name} ({led})" if name else led
    return (f"the LED: {'blinks ' if lights['blinking'] else ''}{colour}; "
            f"the backlight: {f'{back} of 255' if back else 'off'}")


def log_level_text(level):
    return {None: "?", "default": "default (info)"}.get(level, level)


def cmd_status(args):
    dev = Device(args.device)
    st = device_status(dev)
    if args.json:
        print(json.dumps(st, indent=2))
        return 0 if st["running"] else 1
    if not st["running"]:
        print(f"[{dev.name}] not running"
              + (f" ({st['firmware']})" if st["firmware"] else ""))
        return 1
    onoff = lambda v: "on" if v else "off"
    last = lambda v: v or "nothing yet"
    nfc, rfid, ibtn, sd = st["nfc"], st["rfid"], st["ibutton"], st["sd"]
    radio = dict(f.split("=", 1) for f in (st["subghz"]["radio"] or "").split()
                 if "=" in f)
    nfc_radio = {"field": "its field is on (reading)", "idle": "off",
                 "listen": "waits for a reader (as a card)"}
    rows = [
        ("usb", usb_text(st["usb"])),
        ("battery", battery_text(st["battery"])),
        ("sd card", "none" if not sd["card"] or sd["inserted"] is None
         else "in the slot" if sd["inserted"] else "pulled out"),
        ("nfc", f"{nfc['card'] or 'no card'} held to it; its radio: "
                f"{nfc_radio.get(nfc['radio'], nfc['radio'])}; a reader's field "
                f"around it: {onoff(nfc['reader_field'])}"),
        ("", f"a virtual reader last read: {last(nfc['last_read'])}"),
        ("rfid", f"{rfid['tag'] or 'no tag'} held to it; its own field: "
                 f"{rfid['field']}; a reader's field around it: "
                 f"{onoff(rfid['reader_field'])}; noise: {onoff(rfid['noise'])}"),
        *([("", f"T5577 blocks: {rfid['t5577']}")] if rfid["t5577"] else []),
        ("", f"last emulation: {last(rfid['last_emulation'])}"),
        ("ibutton", f"{ibtn['key'] or 'no key'} on its contact"
                    + (f", ROM now {ibtn['rom']}" if ibtn["rom"] else "")),
        ("", f"last emulation: {last(ibtn['last_read'])}"),
        ("infrared", f"last sent: {last(st['infrared']['last_transmission'])}"),
        ("sub-ghz", f"the radio: {radio.get('state', '?')}"
                    + (f" at {int(radio['freq']) / 1e6:.2f} MHz"
                       if radio.get("state") in ("rx", "tx", "fstxon")
                       and radio.get("freq", "").isdigit() else "")
                    + f"; last sent: {last(st['subghz']['last_transmission'])}"),
        ("sound", "muted" if st["sound"]["muted"] else "on"),
        ("lights", lights_text(st["lights"])),
        ("log", f"the firmware's level: {log_level_text(st['log']['level'])}"
                + (f"; kept in {st['log']['file']}" if st["log"]["file"] else "")),
    ]
    print(f"[{dev.name}] running: {st['firmware'] or '?'}")
    if st["stopped"]:
        print(f"{'time':9}: {still_text(dev, st['stopped'])}")
    if st["halted"]:
        what, todo = halt_text(dev, st["halted"])
        print(f"{'firmware':9}: it {what}")
        print(f"{'':9}  {todo}")
    elif st["fault"]:
        print(f"{'firmware':9}: it started again after a crash: its "
              f"screen says \"{st['fault']}\" until a button is pressed "
              "there")
    for name, text in rows:
        print(f"{name:9}{':' if name else ' '} {text}")
    return 0


def cmd_usb(args):
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        if args.action:
            out = m.cmd("qom-set /machine/soc/usb attached "
                        + ("on" if args.action == "plug" else "off"))
            if "powered off" in out:
                # it had switched itself off, and ran on the cable alone
                print(f"[{dev.name}] USB unplugged: it is off")
                return 0
            if out:
                sys.exit(f"usb: {out}")
            if args.action != "plug":       # the charger feeds VBUS on its own
                out = m.cmd("qom-set /machine/charger usb "
                            + ("on" if args.action == "charger" else "off"))
                if "powered off" in out:
                    print(f"[{dev.name}] USB unplugged: it is off")
                    return 0
                if out:
                    sys.exit(f"usb: {out}")
        print(f"[{dev.name}] USB: {usb_text(read_usb(m))}")
    finally:
        m.close()
    return 0


def cmd_battery(args):
