LOG_QUIET = ("none", "error", "warn")   # levels that hide the updater's steps


def firmware_log_level(dev, level=None):
    """The firmware's log level, as its RTC register has it.  With a level:
    written there first, which the firmware takes at its next start."""
    m = open_monitor(dev)
    try:
        if level:
            m.cmd(f"qom-set /machine log-level {level}")
        return qom_get(m, "/machine", "log-level")
    finally:
        m.close()


class card_out:
    """The microSD card of a running device out of its slot for a moment, as
    one that is taken to a computer's reader: in the block the launcher has
    the card's image (an fe_files.ImageFiles) and writes megabytes in no
    time, where the firmware's CLI takes 20 KB/s.  The firmware is waited for
    both times, at its CLI: until it has let go of the card, and until it has
    it again.  What it had open on the card it loses, as on a real Flipper."""

    def __init__(self, dev, cli, what, how):
        self.dev, self.cli = dev, cli
        self.what, self.how = what, how     # "the files are"; the other way

    def slot(self, card_in=None):
        """Is the card in its slot?  With an argument: put there, or taken
        out, first"""
        m = open_monitor(self.dev)
        try:
            if card_in is not None:
                err = m.cmd("qom-set /machine sd-card "
                            + ("on" if card_in else "off"))
                if err:
                    sys.exit(f"[{self.dev.name}] "
                             f"{err.removeprefix('Error: ')}")
            return qom_get(m, "/machine", "sd-card")
        finally:
            m.close()

    def mounted(self):
        return "Storage error" not in self.cli.run("storage info /ext")

    def wait(self, mounted, seconds):
        end = time.monotonic() + seconds
        while self.mounted() != mounted:
            if time.monotonic() > end:
                return False
            time.sleep(0.2)
        return True

    def __enter__(self):
        import fe_files
        name = self.dev.name
        if not self.slot():
            sys.exit(f"[{name}] its microSD card is not in the slot: "
                     f"`./flipperemu -d {name} sd insert` puts it there")
        if not self.mounted():
            sys.exit(f"[{name}] its firmware has no card that it can use "
                     f"(`./flipperemu -d {name} cli \"storage info /ext\"`)")
        image = fe_files.ImageFiles(self.dev.sd)
        print(f"[{name}] its card is out of the slot for a moment: "
              f"{self.what} written to its image", flush=True)
        self.slot(False)
        if not self.wait(False, 10.0):
            self.slot(True)
            sys.exit(f"[{name}] the firmware did not let go of its card when "
                     "it was pulled out, so nothing was written to it.  "
                     + self.how)
        return image

    def __exit__(self, kind, *_):
        self.slot(True)
        if kind is None:
            if not self.wait(True, 30.0):
                sys.exit(f"[{self.dev.name}] the card is in its slot again, "
                         "but the firmware does not take it: `./flipperemu "
                         f"-d {self.dev.name} reset` starts the firmware "
                         "anew.  " + self.how)
            print(f"[{self.dev.name}] the card is in again, and the firmware "
                  "has it", flush=True)
        elif issubclass(kind, Exception):
            try:                # the error is said; the card is the firmware's
                self.wait(True, 10.0)       # again when this command is back
            except Exception:
                pass
        return False


def overlay_push(dev):
    """The command that puts the emulator's own Sub-GHz keystores on a
    device's card, as it is typed where the launcher was called"""
    paths = []
    for p in sorted(REKEYED_OVERLAY.iterdir()):
        try:
            p = p.relative_to(pathlib.Path.cwd())
        except ValueError:
            pass
        paths.append(str(p))
    return f"`./flipperemu -d {dev.name} push {' '.join(paths)} /ext/`"


def rekeyed_keystores(dev, cli):
    """The emulator's own Sub-GHz keystores (keystores/overlay, which a new
    card gets) on the card of a device that runs, through its firmware's CLI:
    they are a few KB.  A firmware's updater unpacks the package's resources
    over them, and the keystores among those only a real Flipper's key
    opens.  How many files were written (none: they were there); None with
    no such folder here."""
    import fe_files
    if not REKEYED_OVERLAY.is_dir():
        return None
    end = time.monotonic() + 20.0
    while "Storage error" in cli.run("storage info /ext"):  # (a card just
        if time.monotonic() > end:                          # taken)
            raise fe_files.FilesError("the firmware has no card that it can "
                                      "use")
        time.sleep(0.5)
    copied, _ = fe_files.push(fe_files.CliFiles(cli),
                              sorted(REKEYED_OVERLAY.iterdir()), "/ext/",
                              say=lambda line: None)
    return copied


def rekeyed_said(dev, keys, trouble):
    """What `update` and `run --update` say of the keystores after an update"""
    if keys:
        print(f"[{dev.name}] its updater unpacked the package's Sub-GHz "
              "keystores to the card, which only a real Flipper's key opens: "
              f"the emulator's own are there again ({keys} "
              f"file{'s' if keys > 1 else ''}, docs/keystores.md)", flush=True)
    elif trouble:
        print(f"[{dev.name}] the emulator's own Sub-GHz keystores could not "
              f"be written to its card after the update ({trouble}): "
              f"{overlay_push(dev)} does that (docs/keystores.md)", flush=True)


def keystores_after_update(dev, proc, timeout=900.0):
    """`run --update`: the emulator's own Sub-GHz keystores on the card again
    when the firmware's updater is done, as `update` puts them there.  (This
    is the run's own thread: it waits as long as the updater takes, and says
    nothing of an updater that does not come back.)"""
    import fe_files
    import fe_log
    if not REKEYED_OVERLAY.is_dir():
        return
    log = fe_log.Log(dev.uart, new=True)
    try:
        how, _ = await_update(dev, log, timeout, show=False)
    except OSError:
        return
    finally:
        log.close()
    if how != "back" or proc.poll() is not None:
        return
    keys = trouble = None
    try:
        cli = open_cli(dev, timeout=60.0)       # (in its turn at the port)
        try:
            keys = rekeyed_keystores(dev, cli)
        finally:
            cli.close()
    except SystemExit as e:
        trouble = str(e).removeprefix(f"[{dev.name}] ")
    except (fe_files.FilesError, OSError, TimeoutError) as e:
        trouble = str(e)
    if proc.poll() is None:
        rekeyed_said(dev, keys, trouble)


def await_update(dev, log, timeout, show=True):
    """Wait for the firmware's updater: what became of it ("back": the
    Flipper runs again, with its USB serial port; "error": the updater stopped
    at one; "ended": the emulator did; "restarted": it was started anew;
    "timeout"), and how often its log showed the firmware starting.

    The updater has no USB: the serial port coming back is the end of it.
    Until then its log says where it is (`[I][UpdWorker] Stage 9, progress
    0`).  The stage numbers are the firmware's own, and differ between
    firmwares, so only this is made of them: a stage that ended at 100
    before a restart is the one for "done", and one above it is an error,
    after which the updater stays on its screen."""
    import fe_log
    tty = show and sys.stderr.isatty()
    start = time.monotonic()
    starts, stage, full, done, gone, look = 0, None, False, None, False, 0.0
    while True:
        now = time.monotonic()
        for item in log.poll():
            if item is fe_log.RESTART:
                return "restarted", starts
            if item is fe_log.REBOOT:
                starts, gone = starts + 1, True
                if stage is not None and full:
                    done = stage
                stage = None
            elif item.tag == "UpdWorker":
                hit = re.match(r"Stage (\d+), progress (\d+)", item.text)
                if hit:
                    stage, full = int(hit.group(1)), hit.group(2) == "100"
        if done is not None and stage is not None and stage > done:
            return "error", starts
        if now >= look:
            look = now + 1
            if not dev.running():
                return "ended", starts
            m = open_monitor(dev)
            try:
                usb = read_usb(m)
            finally:
                m.close()
            if "CDC ACM" not in (usb["device"] or ""):
                gone = True
            elif gone:
                return "back", starts
        if now - start > timeout:
            return "timeout", starts
        if tty:
            sys.stderr.write(f"\r\x1b[K  the updater works: {now - start:.0f} s"
                             + (f", start {starts}" if starts else "")
                             + (f", stage {stage}" if stage is not None else ""))
            sys.stderr.flush()
        time.sleep(0.25)


def send_update(dev, pkg, keep_radio=False, wait=True, timeout=900.0,
                through_cli=False):
    """Put an update package on a running device's SD card, have the
    firmware install it, and wait until it has.  The package is written to
    the card's image, with the card out of its slot for that moment; or sent
    through the firmware's CLI, as its own tools send one to a real Flipper,
    which is 20 KB/s."""
    import fe_files
    import fe_log
    import tempfile
    if not dev.running():
        sys.exit(f"[{dev.name}] is not running: `./flipperemu -d {dev.name} run "
                 f"--update {pkg}` starts it and installs the package")
    was, lent = None, False

    def give_back():
        """The log level that was lent to the updater: as it was again,
        from the firmware's next start"""
        if lent and dev.running():
            firmware_log_level(dev, was)

    with tempfile.TemporaryDirectory(prefix="fe-update-") as tmp:
        pdir, label, radio = unpack_update(pkg, pathlib.Path(tmp), keep_radio,
                                           device_stack(dev))
        size = sum(f.stat().st_size for f in pdir.rglob("*") if f.is_file())
        manifest = f"/ext/update/{pdir.name}/update.fuf"
        files, close = open_card(dev)
        words = radio_words(radio)
        what = (f"{label} ({size / 1e6:.1f} MB"
                + (f"; {words}" if words else "") + ")")

        def say(line):
            print("  " + line.replace(f"{tmp}/", ""), flush=True)

        try:
            with held_interrupt("stopping after this piece") as stop:
                print(f"[{dev.name}] {what} goes to /ext/update/{pdir.name}",
                      flush=True)
                if through_cli:
                    print(f"[{dev.name}] through the Flipper's CLI, which takes "
                          "some 20 KB/s; what is there already is not sent "
                          "again", flush=True)
                    fe_files.push(files, [pdir], "/ext/update/",
                                  progress=transfer_progress(), stop=stop,
                                  say=say)
                else:
                    with card_out(dev, files.cli, "the package is",
                                  "`update --cli` sends the package through "
                                  "the Flipper's CLI, with the card where it "
                                  "is") as image:
                        fe_files.push(image, [pdir], "/ext/update/",
                                      stop=stop, say=say)
            log = fe_log.Log(dev.uart, tail=4096)
            log.poll()                  # from here on: what the updater logs
            was = firmware_log_level(dev)
            if wait and was in LOG_QUIET:
                # the updater is the firmware's next start, and takes the
                # level that the register has by then.  Without its "Stage"
                # lines an error on its screen is not seen from here
                lent = True
                firmware_log_level(dev, "info")
                print(f"[{dev.name}] the firmware's log level is {was}: info "
                      "while the updater works, for its steps to be seen",
                      flush=True)
            try:
                refused = start_update(files.cli, manifest)
            except BaseException:
                give_back()
                raise
        finally:
            close()
    if refused:
        give_back()
        sys.exit(f"[{dev.name}] update refused: {refused}")
    stamp = dict(firmware=f"{label} (installed by update)",
                 flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)
    if not wait:
        dev.save_info(**stamp)
        print(f"[{dev.name}] updater started: {manifest} (it has no USB while "
              f"it works; `./flipperemu -d {dev.name} status` shows the serial "
              "port when it is back)")
        if REKEYED_OVERLAY.is_dir():
            print(f"[{dev.name}] it unpacks the package's Sub-GHz keystores "
                  "to the card, which only a real Flipper's key opens: "
                  f"{overlay_push(dev)}, when it is back, puts the emulator's "
                  "own there again (docs/keystores.md)")
        return 0
    print(f"[{dev.name}] updater started: the Flipper starts a few times, "
          "without USB, until it is done", flush=True)
    start = time.monotonic()
    try:
        how, starts = await_update(dev, log, timeout)
    except KeyboardInterrupt:
        give_back()
        raise KeyboardInterrupt("no longer waiting: the update goes on on the "
                                "Flipper") from None
    finally:
        log.close()
        if sys.stderr.isatty():
            sys.stderr.write("\r\x1b[K")
    took = time.monotonic() - start
    look = (f"`./flipperemu -d {dev.name} shot FILE.png` shows its screen, "
            f"`./flipperemu -d {dev.name} log` what it logged")
    if how != "back":
        give_back()
    if how == "error":
        sys.exit(f"[{dev.name}] the updater stopped at an error after "
                 f"{took:.0f} s, and waits on its screen: holding Back there "
                 f"(`./flipperemu -d {dev.name} press --hold 1500 back`) "
                 f"starts the firmware that is on the Flipper.  {look}")
    if how == "ended":
        sys.exit(f"[{dev.name}] the emulator ended while the updater worked")
    if how == "restarted":
        sys.exit(f"[{dev.name}] was started anew while the updater worked")
    if how == "timeout":
        sys.exit(f"[{dev.name}] the Flipper's USB serial port is not back "
                 f"after {took:.0f} s (its log shows {starts} starts): the "
                 f"updater may still work, or wait at an error.  {look}")
    cli = open_cli(dev, timeout=30.0)
    keys = trouble = None
    try:
        now = dict(re.findall(r"(?m)^([\w.]+) *: (.*)$", cli.run("info device")))
        try:
            keys = rekeyed_keystores(dev, cli)
        except (fe_files.FilesError, OSError, TimeoutError) as e:
            trouble = str(e)
    finally:
        cli.close()
    dev.save_info(**stamp)
    runs = now.get("firmware.version") or "a firmware that does not say which"
    more = ", ".join(f"{what} {now[key]}" for key, what in (
        ("firmware.commit.hash", "commit"), ("firmware.build.date", "built"))
        if now.get(key))
    print(f"[{dev.name}] updated in {took:.0f} s: it runs {runs}"
          + (f" ({more})" if more else ""))
    rekeyed_said(dev, keys, trouble)
    left = firmware_log_level(dev)
    if left != was:
        # the firmware's own doing (the official updater: default; Unleashed's:
        # none), and what a real Flipper has after an update too
        print(f"[{dev.name}] its updater left the firmware's log level at "
              f"{log_level_text(left)} (it was {log_level_text(was)}): "
              f"`./flipperemu -d {dev.name} log --set-level {was}` sets it "
              "again, from the firmware's next start "
              f"(`./flipperemu -d {dev.name} reset`)")
    return 0


def cmd_update(args):
    return send_update(Device(args.device), pathlib.Path(args.package),
                       keep_radio=args.keep_radio, wait=not args.no_wait,
                       timeout=args.timeout, through_cli=args.cli)


def cmd_pull(args):
    import fe_files
    dev = Device(args.device)
    sources = list(args.paths)
    local = sources.pop() if len(sources) > 1 and not CARD_PATH.match(sources[-1]) \
        else "."
    files, close = open_card(dev)
    try:
        with held_interrupt("stopping when the Flipper has sent this file: "
                            "it cannot be told to stop") as stop:
            copied, same = fe_files.pull(files, sources, local,
                                         force=args.force,
                                         progress=transfer_progress(),
                                         stop=stop)
    except fe_files.Interrupted:
        raise
    except KeyboardInterrupt:
        if isinstance(files, fe_files.CliFiles):
            raise fe_files.Interrupted(
                "interrupted; if the Flipper was sending a file, it sends the "
                "rest to nobody, and its CLI answers again when that is done"
            ) from None
        raise
    finally:
        close()
    print(copied_text(dev, files, copied, same))
    return 0


def log_trouble(path, start):
    """([lines], crash): what the firmware logged from byte `start` of its log
    on that is a warning or worse, and its crash message if it had one"""
    import fe_log
    try:
        with open(path, "rb") as f:
            f.seek(start)
            text = f.read().decode(errors="replace")
    except OSError:
        return [], None
    lines, crash = [], None
    for raw in text.splitlines():
        line = fe_log.parse(raw)
        found = fe_log.crash_of(line)
        if found:
            crash = f"{found[1]}"
        elif line.level in ("W", "E"):
            # (a line may hold bytes of a file the firmware could not read)
            text = re.sub(r"[^\x20-\x7e]+", "?", line.plain)
            lines.append(text if len(text) <= 120 else text[:119] + "…")
    return lines, crash


def app_copy(files, local, to):
    """Put a .fap on the card: over the app of its file name, else into
    /ext/apps, or into the folder `to`.  Its path there."""
    import fe_files
    remote = fe_files.clean(to) + "/" if to else None
    (_, target), = fe_files.plan_push(files, [local], remote)[1]
    with held_interrupt("stopping after this piece") as stop:
        fe_files.push(files, [local], target, progress=transfer_progress(),
                      stop=stop)
    return target


def press_back(dev, long=False):
    m = open_monitor(dev)
    try:
        m.press("back", 1200 if long else 120)
    finally:
        m.close()


def app_close(dev, cli):
    """Close the app that runs, with its Back button if it has to be.
    What to say about it: a list, empty when none ran."""
    import fe_apps
    try:
        mark = dev.uart.stat().st_size
    except OSError:
        mark = None
    try:
        closed = fe_apps.close(
            cli, back=lambda long=False: press_back(dev, long))
    except (fe_apps.Restarted, TimeoutError) as e:
        # a release build starts again after a crash, a debug build halts
        halt = None if isinstance(e, fe_apps.Restarted) else firmware_halt(dev)
        if isinstance(e, TimeoutError) and not halt:
            raise
        crash = log_trouble(dev.uart, mark)[1] if mark is not None else None
        # its log has no report of a crash that came in the middle of another
        # thread's line; a release build has the reason in a register then
        fault = None if crash or halt else firmware_fault(dev)
        reason = crash or (fault if fault != NO_REASON else None)
        if crash:
            report = f"`./flipperemu -d {dev.name} log` has the firmware's report"
        elif fault or halt:
            report = ("The firmware's log has no report of it (what a crash "
                      "prints is lost when another thread is in the middle of "
                      "a line there)"
                      + (": the reason is from its fault register, and on its "
                         "screen" if reason else ""))
        else:
            report = "The firmware's log has no report of a crash"
        raise fe_apps.AppError(
            "the firmware "
            + (f"crashed ({reason})" if reason else
               "crashed" if fault else "stopped")
            + " when the app was asked to close, and "
            + ("has halted: a debug build waits for a debugger there" if halt
               else "has started again")
            + ".  The loader's request ends an app where it is, and not every "
            "app is ready for that in the middle of its work (reading, "
            "sending): leave that with its Back button first.  " + report
            + (f"; {halt_text(dev, halt)[1]}" if halt else "")
        ) from None
    return [f'"{name}" closed' + (" (with its Back button: it takes no "
                                  "request to close)" if pressed else "")
            for name, pressed in closed]


def cmd_app(args):
    import fe_apps
    import fe_files
    dev = Device(args.device)
    local = fap = None
    if args.app and not CARD_PATH.match(args.app):
        path = pathlib.Path(args.app)
        if path.suffix.lower() == ".fap" or os.sep in args.app:
            if not path.is_file():
                sys.exit(f"flipperemu: {args.app}: no such file")
            local = path
    if (args.close or args.list) and (args.app or args.no_start or args.to):
        sys.exit("app: --close and --list stand alone")
    if args.close and args.list:
        sys.exit("app: --close or --list, one of them")
    if (args.to or args.no_start) and not local:
        sys.exit("app: --to and --no-start are for a .fap file from here")
    try:
        if local:
            try:
                fap = fe_apps.manifest(local.read_bytes())
            except fe_apps.AppError as e:
                sys.exit(f"flipperemu: {local}: {e}")
        if not dev.running():
            if not (local and args.no_start):
                sys.exit(f"[{dev.name}] is not running, and it is its firmware "
                         f"that starts apps (`./flipperemu -d {dev.name} run`)"
                         + ("; with --no-start the file is only copied to its "
                            "card" if local else ""))
            files, close = open_card(dev)
            try:
                print(f"{local}: {fe_apps.about(fap)[0]}")
                app_copy(files, local, args.to)
            finally:
                close()
            return 0
        cli = open_cli(dev)
        try:
            return app_session(dev, cli, args, local, fap)
        finally:
            cli.close()
    except fe_apps.AppError as e:
        sys.exit(f"[{dev.name}] {e}")


class PortTaken(Exception):
    """The app that was started has the Flipper's USB port: no CLI answers"""


def app_session(dev, cli, args, local, fap):
    import fe_apps
    import fe_files
    if args.list:
        for title, names in fe_apps.builtin(cli).items():
            if names:
                print(f"{title} (in the firmware):")
            for name in names:
                print(f"  {name}")
        try:
            found = sorted(e.name for e in
                           fe_files.CliFiles(cli).tree("/ext/apps")
                           if not e.is_dir and e.name.lower().endswith(".fap"))
        except fe_files.FilesError:
            found = []
        print("On the card:" if found else "On the card: none")
        for name in found:
            print(f"  /ext/apps/{name}")
        return 0
    if not args.app:
        if args.close:
            for text in app_close(dev, cli) or ["no app runs"]:
                print(f"[{dev.name}] {text}")
        else:
            now = fe_apps.running(cli)
            print(f'[{dev.name}] "{now}" runs' if now
                  else f"[{dev.name}] no app runs")
        return 0

    if local:
        line, warn = fe_apps.about(fap, fe_apps.firmware_api(cli))
        print(f"{local}: {line}")
        if warn:
            print(f"  ({warn})", file=sys.stderr)
    if not args.no_start:
        for text in app_close(dev, cli):
            print(f"[{dev.name}] {text}")
    what = (app_copy(fe_files.CliFiles(cli), local, args.to) if local
            else args.app)
    if args.no_start:
        return 0

    try:
        mark = dev.uart.stat().st_size
    except OSError:
        mark = None

    def logged():
        return log_trouble(dev.uart, mark) if mark is not None else ([], None)

    # An app may take the USB port for itself: U2F and a USB keyboard make
    # another device of it, Bad USB switches it off until a script runs.
    # The loader's answer is lost with the serial port then, and the app
    # runs.  Asked when the CLI has been quiet for a while; a port that is
    # off is asked about twice, since every change of device begins so.
    port, off = [], []
    halted = cli.gone

    def gone():
        if halted and halted():
            return True
        seen = usb_taken(dev)
        if seen == "none" and not off:
            off.append(seen)
            return False
        if seen:
            port[:] = [seen]
        else:
            del off[:]
        return bool(seen)

    cli.gone = gone

    def back():
        if port:
            raise PortTaken()
        press_back(dev)

    def waiting():
        if port:
            raise PortTaken()
        if firmware_halt(dev):          # nobody is asking: said below
            raise TimeoutError("the firmware gives no answer")
        left = max(0.0, args.wait - fe_apps.QUESTION)
        print(f"[{dev.name}] no answer yet: the Flipper may be asking on its "
              "screen whether to start it.  Answer there (in the window, or "
              "`press right` / `press back` from another terminal); in "
              f"{left:g} s it is cancelled with Back.", file=sys.stderr)

    said = lost = now = None
    cancelled = False
    try:
        said, cancelled = fe_apps.start(cli, what, " ".join(args.args),
                                        wait=args.wait, waiting=waiting,
                                        back=back)
        if not said:
            time.sleep(1.0)                 # an app that fails does it at once
            if not logged()[1]:
                now = fe_apps.running(cli)
    except PortTaken:
        pass
    except (ConnectionError, TimeoutError) as e:
        lost = str(e)
    lines, crash = logged()
    if said:                                # the log has the same sentence
        lines = [text for text in lines if said not in text]
    if lines:
        print("  warnings and errors in the firmware's log since then:")
        for text in lines[-12:]:
            print(f"    {text}")
    halt = firmware_halt(dev) if crash or lost else None
    if halt:
        what, todo = halt_text(dev, halt)
        why = f"the firmware {what}.  {todo}"
    elif crash:
        why = f"the firmware crashed with it, and started again: {crash}"
    elif lost:
        why = lost
    elif said or cancelled:
        why = (("nobody answered the Flipper's question, and it was cancelled "
                "with Back.  " if cancelled else "")
               + f"The loader did not start it: {said or 'it gave no reason'}")
        if not cancelled:
            why = why[0].lower() + why[1:]
    elif port:
        sees = ("nothing there now (the app has switched the port off)"
                if port[0] == "none" else port[0])
        print(f"[{dev.name}] it was started, and has the Flipper's USB port "
              f"for itself: the computer sees {sees}.  There is no CLI "
              "until the app is left (its Back button: "
              f"`./flipperemu -d {dev.name} press back`).")
        return 0
    else:
        print(f'[{dev.name}] "{now}" runs' if now
              else f"[{dev.name}] it was started, and has ended already")
        return 0
    sys.stdout.flush()
    print(f"[{dev.name}] {why}", file=sys.stderr)
    return 1


