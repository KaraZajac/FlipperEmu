    elif st["fault"]:
        print(f"{'firmware':9}: it started again after a crash: its "
              f"screen says \"{st['fault']}\" until a button is pressed "
              "there")
    for name, text in rows:
        print(f"{name:9}{':' if name else ' '} {text}")
    return 0


def cmd_usb(args):
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        if args.action:
            out = m.cmd("qom-set /machine/soc/usb attached "
                        + ("on" if args.action == "plug" else "off"))
            if "powered off" in out:
                # it had switched itself off, and ran on the cable alone
                print(f"[{dev.name}] USB unplugged: it is off")
                return 0
            if out:
                sys.exit(f"usb: {out}")
            if args.action != "plug":       # the charger feeds VBUS on its own
                out = m.cmd("qom-set /machine/charger usb "
                            + ("on" if args.action == "charger" else "off"))
                if "powered off" in out:
                    print(f"[{dev.name}] USB unplugged: it is off")
                    return 0
                if out:
                    sys.exit(f"usb: {out}")
        print(f"[{dev.name}] USB: {usb_text(read_usb(m))}")
    finally:
        m.close()
    return 0


