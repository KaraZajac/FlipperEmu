def wait_state(dev):
    """For a wait that was in vain: what the device does instead, or ''"""
    if not dev.running():
        return "  It is not running any more."
    try:
        m = open_monitor(dev)
        try:
            still = stopped(m)
            halt = None if still else firmware_halt(dev, m)
            fault = None if still or halt else firmware_fault(dev, m)
        finally:
            m.close()
    except (OSError, ConnectionError):
        return ""
    if still:
        return f"  Mind that {still_text(dev, still)}."
    if halt:
        what, todo = halt_text(dev, halt)
        return f"  The firmware {what}.  {todo}"
    if fault:
        return (f"  The firmware started again after a crash: its screen says "
                f"\"{fault}\" until a button is pressed there.")
    return ""


def cmd_wait(args):
    """Until a device is where a script wants it: its CLI answers (when
    nothing else is asked for), its log has a line, or its screen is as in a
    file.  0: it is so; 1: not within --timeout, with the reason."""
    import fe_log
    dev = Device(args.device)
    if args.timeout <= 0:
        sys.exit("--timeout: more than 0")
    if args.log is not None and args.screen:
        sys.exit("wait: --log or --screen, one at a time")
    pattern = ref = None
    if args.log is not None:
        try:
            pattern = fe_log.smart(args.log)
        except re.error as e:
            sys.exit(f"--log {args.log}: {e}")
    if args.screen:
        import fe_screen
        try:
            ref = fe_screen.load(args.screen)
        except OSError as e:
            sys.exit(f"{args.screen}: {e.strerror}")
        except ValueError as e:
            sys.exit(f"{args.screen}: {e}")
    began = time.time()
    while not dev.running():        # (`run ... &` in the line before this one)
        if time.time() - began > args.timeout:
            sys.exit(f"[{dev.name}] not running after {args.timeout:g} s")
        time.sleep(0.2)
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    log = fe_log.Log(dev.uart, new=bool(command)) if pattern else None
    if command:
        # What is waited for comes of this: the log counts from here on.
        done = subprocess.run([sys.executable, str(ROOT / "flipperemu"), "-d",
                               dev.name, *command])
        if done.returncode:
            return done.returncode
        began = time.time()
    end = began + args.timeout

    def took():
        return f"{time.time() - began:.1f} s"

    if log:
        found = last = None
        if not command:             # what it logged since it started
            while True:
                for item in log.poll():
                    if isinstance(item, fe_log.Mark):
                        found = None
                    else:
                        last = item if item.plain.strip() else last
                        if pattern.search(item.plain):
                            found = item
                if not log.more:
                    break
        looked = time.time()
        again = ""
        while not found:
            for item in log.poll():
                if isinstance(item, fe_log.Mark):
                    # (the line may still come: `wait --log ... -- reset`)
                    again = ("  The firmware started again meanwhile (after "
                             "a crash, if nothing reset it).")
                    continue
                last = item if item.plain.strip() else last
                if pattern.search(item.plain):
                    found = item
                    break
            if found or log.more:
                continue
            state = ""
            if time.time() - looked > 2.0:      # can it still come?
                looked = time.time()
                state = wait_state(dev)
                if "paused" in state or "started again" in state:
                    state = ""          # (what is waited for can still come)
            if state or time.time() > end:
                since = "after that" if command else "since it started"
                sys.exit(f"[{dev.name}] no line with {args.log!r} in the "
                         f"firmware's log {since}, in {took()}."
                         + (state or wait_state(dev) or again)
                         + (f"\n[{dev.name}] its last line: {last.plain[:200]}"
                            if last else f"\n[{dev.name}] it logged nothing"
                            + (" after it" if command else "")))
            time.sleep(0.1)
        print(found.plain, flush=True)
        return 0

    if ref:
        reference, counts = ref
        looked = time.time()
        while True:
            bits = screen_bits(dev)
            n = fe_screen.differing(bits, reference, counts)
            if not n:
                print(f"[{dev.name}] its screen is as in {args.screen} "
                      f"({took()})")
                return 0
            if time.time() > end:
                break
            if time.time() - looked > 2.0:      # can it still come?
                looked = time.time()
                if firmware_halt(dev):
                    break
            time.sleep(WAIT_LOOK)
        print(f"[{dev.name}] its screen is not as in {args.screen} after "
              f"{took()}: {n} pixel{'s' if n != 1 else ''} differ"
              f"{'' if n != 1 else 's'}.{wait_state(dev)}\n"
              f"[{dev.name}] it shows:", file=sys.stderr)
        fe_screen.write(fe_screen.to_text(bits), sys.stderr)
        return 1

    while True:
        try:
            open_cli(dev, timeout=max(1.0, min(10.0, end - time.time()))).close()
            print(f"[{dev.name}] its CLI answers ({took()})")
            return 0
        except SystemExit as e:
            why = str(e.code)
        except (OSError, TimeoutError) as e:
            why = f"[{dev.name}] no CLI: {e}"
        for_good = not dev.running() or "--usb none" in why \
            or firmware_halt(dev)
        if for_good or time.time() > end:
            sys.exit(f"{why}\n[{dev.name}] waited {took()} for its CLI"
                     + ("" if dev.running() else ": it is not running any more"))
        time.sleep(0.5)


def cmd_record(args):
    """What the LCD of a running device shows, as an animated GIF"""
    import fe_record
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    if not 1 <= args.scale <= 16:
        sys.exit("--scale: 1 to 16 pixels to an LCD pixel")
    if args.seconds is not None and args.seconds <= 0:
        sys.exit("--seconds: more than 0")
    done = []
    before = {sig: signal.signal(sig, lambda *_: done.append(1))
              for sig in (signal.SIGINT, signal.SIGTERM)}
    print(f"[{dev.name}] recording its screen"
          + (f" for {args.seconds:g} s" if args.seconds else "")
          + ": Ctrl-C ends it", flush=True)
    try:
        rec = fe_record.record(dev.panel_sock, args.seconds, lambda: bool(done))
    except OSError as e:
        sys.exit(f"[{dev.name}] no front-panel link ({e}): a device started "
                 "by an older FlipperEmu?")
    finally:
        for sig, handler in before.items():
            signal.signal(sig, handler)
    if rec is None:
        sys.exit(f"[{dev.name}] another program has its front panel (its "
                 "window?), and the emulator talks to one there.  In the "
                 "window: Device > Record the screen")
    if not rec.shots:
        sys.exit(f"[{dev.name}] no picture came")
    try:
        frames, seconds, size = rec.save(args.out, scale=args.scale)
    except OSError as e:
        sys.exit(f"{args.out}: {e.strerror}")
    print(f"[{dev.name}] {frames} picture{'s' if frames != 1 else ''}, "
          f"{seconds:.1f} s: {args.out} ({size} bytes)")


def cmd_press(args):
    from fe_monitor import KEYS
    dev = Device(args.device)
    keys = [key.lower() for key in args.keys]
    for key, typed in zip(keys, args.keys):
        if key not in KEYS:         # (the emulator would press nothing, in silence)
            sys.exit(f"press: {typed!r} is no button of a Flipper's: "
                     + ", ".join(KEYS))
    if args.hold <= 0 or args.gap < 0:
        sys.exit("press: --hold is more than 0 ms, and --gap not less")
    m = open_monitor(dev)
    try:
        still = stopped(m)
        if still:
            sys.exit(f"[{dev.name}] feels no button: {still_text(dev, still)}")
        for key in keys:
            m.press(key, args.hold)
            time.sleep(args.gap / 1000)
    finally:
        m.close()


def cmd_info(args):
    dev = Device(args.device)
    info = dev.info()
    print(f"device   : {dev.name} ({dev.dir})")
    for k in ("firmware", "source", "flashed", "bytes", "resources"):
        if k in info:
            print(f"{k:9}: {info[k]}")
    print(f"flash    : {'yes' if dev.flash.exists() else 'no'}")
    print(f"sd card  : {'yes' if dev.sd.exists() else 'no'}")
    print(f"symbols  : {'yes' if dev.elf.exists() else 'no'}")
    if dev.enclave.exists():
        import fe_enclave
        try:
            keys = fe_enclave.read_store(dev.enclave)
            valid = fe_enclave.valid_factory_keys(keys)
            print(f"enclave  : {len(keys)} keys, {valid} of {fe_enclave.FACTORY_KEYS} "
                  "factory keys valid")
        except (OSError, ValueError) as e:
            print(f"enclave  : {e}")
    else:
        print("enclave  : made on the first run")


