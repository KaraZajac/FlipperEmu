ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))

QEMU = ROOT / "build" / "qemu" / "qemu-system-arm"
DEVICES = ROOT / "devices"
FLASH_BASE = 0x08000000
FLASH_SIZE = 1 << 20
SECURE_START = 0x080D7000          # SFSA 0xD7: CPU2 area, never written


# ------------------------------------------------------------ firmware IO

def parse_dfu(data: bytes):
    """DfuSe: yields (address, bytes) elements."""
    if data[:5] != b"DfuSe":
        raise ValueError("not a DfuSe file")
    off, out = 11, []
    for _ in range(data[10]):
        if data[off:off + 6] != b"Target":
            raise ValueError("bad DfuSe target prefix")
        nel = struct.unpack_from("<I", data, off + 270)[0]
        off += 274
        for _ in range(nel):
            addr, size = struct.unpack_from("<II", data, off)
            out.append((addr, data[off + 8:off + 8 + size]))
            off += 8 + size
    return out


def parse_elf(data: bytes):
    """Loadable file contents at their physical (load) addresses."""
    if data[:4] != b"\x7fELF" or data[4] != 1:
        raise ValueError("not a 32-bit ELF")
    phoff, = struct.unpack_from("<I", data, 28)
    phentsize, phnum = struct.unpack_from("<HH", data, 42)
    out = []
    for i in range(phnum):
        p_type, p_off, _vaddr, p_paddr, p_filesz = struct.unpack_from(
            "<IIIII", data, phoff + i * phentsize)
        if p_type == 1 and p_filesz and FLASH_BASE <= p_paddr < FLASH_BASE + FLASH_SIZE:
            out.append((p_paddr, data[p_off:p_off + p_filesz]))
    if not out:
        raise ValueError("ELF has nothing to load into flash")
    return out


def load_firmware(path: pathlib.Path):
    """-> (elements, elf_bytes_or_None, resources_source_or_None, label)"""
    raw = path.read_bytes()
    name = path.name.lower()
    if raw[:4] == b"\x7fELF":
        return parse_elf(raw), raw, None, path.name
    if raw[:5] == b"DfuSe":
        return parse_dfu(raw), None, None, path.name
    if name.endswith((".tgz", ".tar.gz", ".tar")):
        with tarfile.open(path, "r:*") as tar:
            names = tar.getnames()
            dfu = next((n for n in names if n.endswith("firmware.dfu")), None)
            if not dfu:
                raise ValueError("no firmware.dfu in the package")
            fuf = next((n for n in names if n.endswith("update.fuf")), None)
            label = path.name
            if fuf:
                for line in tar.extractfile(fuf).read().decode(errors="replace").splitlines():
                    if line.startswith("Info:"):
                        label = line.split(":", 1)[1].strip()
            return parse_dfu(tar.extractfile(dfu).read()), None, path, label
    if name.endswith(".bin"):
        return [(FLASH_BASE, raw)], None, None, path.name
    raise ValueError(f"don't know how to load {path}")


# ---------------------------------------------------------------- device

class Device:
    def __init__(self, name: str):
        self.name = name
        self.dir = DEVICES / name
        self.flash = self.dir / "flash.img"
        self.sd = self.dir / "sd.img"
        self.elf = self.dir / "firmware.elf"
        self.meta = self.dir / "device.json"
        self.monitor = self.dir / "monitor.sock"
        self.uart = self.dir / "uart.log"       # what the firmware logged, this run
        self.uart_old = self.dir / "uart.log.1"     # ... and the run before
        self.nvram = self.dir / "nvram.bin"     # gauge + RTC backup domain
        self.enclave = self.dir / "enclave.keys"    # the secure enclave's keys
        self.usb_sock = self.dir / "usb.sock"   # --usb unix
        self.usb_tty = self.dir / "usb.tty"     # --usb pty: symlink to the pty
        self.subghz_sock = self.dir / "subghz.sock"     # a radio bridge (fe_sdr.py)
        self.nfc_sock = self.dir / "nfc.sock"           # a card on the link (fe_nfc_link.py)
        self.panel_sock = self.dir / "panel.sock"       # its face: the window (fe_gui.py)
        self.held_file = self.dir / "held.json"         # names of what is held to it

    def running(self):
        """Is a QEMU serving this device's monitor socket?"""
        if not self.monitor.exists():
            return False
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            s.connect(str(self.monitor))
            return True
        except OSError:
            return False
        finally:
            s.close()

    def held(self):
        """What the commands last held to it: {'nfc': label, 'rfid': ..}"""
        try:
            return json.loads(self.held_file.read_text())
        except (OSError, ValueError):
            return {}

    def set_held(self, what, label):
        """The emulator has the card's bytes, not what it was called: `status`
        and the window read that here.  label None: taken away."""
        held = self.held()
        if label:
            held[what] = label
        else:
            held.pop(what, None)
        tmp = self.held_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(held, indent=2) + "\n")
        os.replace(tmp, self.held_file)

    def refuse_if_running(self):
        # two emulators (or mtools) on one flash/SD image corrupt it
        if self.running():
            sys.exit(f"[{self.name}] is running: ./flipperemu -d {self.name} stop first")

    def info(self):
        try:
            return json.loads(self.meta.read_text())
        except (OSError, ValueError):
            return {}

    def save_info(self, **kw):
        info = self.info()
        info.update(kw)
        self.meta.write_text(json.dumps(info, indent=2) + "\n")

    def program(self, fw: pathlib.Path, erase_all: bool = False):
        elements, elf, resources, label = load_firmware(fw)
        self.dir.mkdir(parents=True, exist_ok=True)
        if not self.flash.exists() or erase_all:
            self.flash.write_bytes(b"\xff" * FLASH_SIZE)
        img = bytearray(self.flash.read_bytes().ljust(FLASH_SIZE, b"\xff"))
        # like DFU: erase every touched 4 KiB page first, then program
        for addr, data in elements:
            if addr < FLASH_BASE or addr + len(data) > SECURE_START:
                raise ValueError(f"element {addr:#x}+{len(data)} outside user flash")
            off = addr - FLASH_BASE
            first, last = off // 4096, (off + len(data) - 1) // 4096
            img[first * 4096:(last + 1) * 4096] = b"\xff" * ((last - first + 1) * 4096)
        for addr, data in elements:
            off = addr - FLASH_BASE
            img[off:off + len(data)] = data
        self.flash.write_bytes(img)
        if elf:
            self.elf.write_bytes(elf)
        elif self.elf.exists():
            self.elf.unlink()                   # stale symbols would mislead gdb
        if resources is None:
            resources = find_resources_for(fw)
        self.save_info(firmware=label, source=str(fw.resolve()),
                       flashed=time.strftime("%Y-%m-%d %H:%M:%S"),
                       bytes=sum(len(d) for _, d in elements),
                       **({"resources": str(resources.resolve())} if resources else {}))
        return label, resources

    def make_sd(self, resources=None, size="512M", force=False):
        cmd = [sys.executable, "-I", str(ROOT / "scripts" / "make_sdcard.py"),
               str(self.sd), "--size", size]
        if resources:
            cmd += ["--resources", str(resources)]
        if force:
            cmd.append("--force")
        subprocess.run(cmd, check=True)


def find_resources_for(fw: pathlib.Path):
    """Release folders from fetch_firmware.py keep resources next to the ELF."""
    for pat in ("*update*.tgz", "*resources*.tgz"):
        hits = sorted(fw.parent.glob(pat))
        if hits:
            return hits[0]
    return None


def stage_update(dev: Device, pkg: pathlib.Path, keep_radio: bool) -> str:
    """Put an update package on the SD card the way qFlipper does; return the
    manifest path as the firmware sees it.

    The emulated CPU2 is ST's FUS without a radio stack and cannot install
    one, so unless keep_radio is set the radio stage is blanked exactly as
    `fbt updater_package` writes a package without a stack. Every key stays
    in place: the firmware reads the manifest's optional keys in file order,
    and a missing one would hide all the keys after it.
    """
    import tempfile
    from make_sdcard import safe_extract
    with tempfile.TemporaryDirectory(prefix="fe-update-") as tmp:
        tmp = pathlib.Path(tmp)
        if pkg.is_dir():
            shutil.copytree(pkg, tmp / pkg.name)
        else:
            with tarfile.open(pkg, "r:*") as tar:
                safe_extract(tar, tmp)
        manifests = sorted(tmp.rglob("update.fuf"))
        if len(manifests) != 1:
            sys.exit(f"{pkg}: expected one update.fuf, found {len(manifests)}")
        pdir = manifests[0].parent
        if not keep_radio:
            fuf = pdir / "update.fuf"
            text = fuf.read_text()
            text = re.sub(r"(?m)^Radio: .*$", "Radio: ", text)
            text = re.sub(r"(?m)^Radio version: .*$",
                          "Radio version: 00 00 00 00 00 00", text)
            fuf.write_text(text)
            (pdir / "radio.bin").unlink(missing_ok=True)
        info = re.search(r"(?m)^Info: *(.+)$", (pdir / "update.fuf").read_text())
        img = ["-i", str(dev.sd)]
        subprocess.run(["mmd", *img, "::update"], capture_output=True)
        subprocess.run(["mdeltree", *img, f"::update/{pdir.name}"], capture_output=True)
        subprocess.run(["mcopy", *img, "-s", "-Q", str(pdir), "::update/"], check=True)
    return f"/ext/update/{pdir.name}/update.fuf", (info.group(1).strip() if info else pdir.name)


# --------------------------------------------------------------- commands

def cmd_flash(args):
    dev = Device(args.device)
    dev.refuse_if_running()
    label, _ = dev.program(pathlib.Path(args.firmware), args.erase_all)
    print(f"[{dev.name}] flashed {label} -> {dev.flash}")


def cmd_sd(args):
    dev = Device(args.device)
    if args.action:                     # the card of a running device
        m = open_monitor(dev)
        try:
            err = m.cmd("qom-set /machine sd-card "
                        + ("on" if args.action == "insert" else "off"))
        finally:
            m.close()
        if err:
            sys.exit(f"sd: {err.removeprefix('Error: ')}")
        print(f"[{dev.name}] microSD card: "
              + ("pushed in" if args.action == "insert" else "pulled out"))
        return 0
    dev.refuse_if_running()
    dev.dir.mkdir(parents=True, exist_ok=True)
    dev.make_sd(args.resources, args.size, force=True)


def audio_backends():
    """Audio drivers compiled into our QEMU (configure enables PipeWire,
    PulseAudio, ALSA or SDL when their development headers are installed)."""
    try:
        out = subprocess.run([str(QEMU), "-audiodev", "help"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [l.strip() for l in out.splitlines()[1:] if l.strip()]


def audio_args(args):
    """-audiodev for the speaker: none | wav:PATH | a QEMU audio driver | auto"""
    choice = args.audio
    if choice == "auto":
        if args.headless or args.print_cmd:
            return []
        have = audio_backends()
        choice = next((b for b in ("pipewire", "pa", "alsa", "sdl") if b in have), None)
        if not choice:
            print("(no speaker: this QEMU has no PipeWire/PulseAudio/ALSA/SDL audio; "
                  "install e.g. pipewire-devel and re-run scripts/setup_qemu.sh, "
                  "or record with --audio wav:FILE)")
            return []
    if choice == "none":
        return []
    if choice.startswith("wav:"):
        return ["-audiodev", f"wav,id=snd0,path={pathlib.Path(choice[4:]).resolve()}"]
    return ["-audiodev", f"{choice},id=snd0"]


def pick_window(args):
    """What a run shows: 'qt', the window that looks like a Flipper
    (scripts/fe_gui.py), 'gtk', QEMU's own window with the bare LCD, or 'none'"""
    if args.headless:
        return "none"
    if args.gtk:
        return "gtk"
    import importlib.util
    if importlib.util.find_spec("PySide6"):
        return "qt"
    if not args.print_cmd:
        print("(PySide6 is not installed: this is QEMU's own window, the bare LCD. "
              "With `pip install PySide6`, or your distribution's python3-pyside6, "
              "there is a Flipper around it)")
    return "gtk"


def need_display():
    if not any(os.environ.get(v) for v in ("WAYLAND_DISPLAY", "DISPLAY",
                                           "QT_QPA_PLATFORM")):
        sys.exit("no display to open a window on: `run --headless` runs without one")


# A plausible cell voltage for a charge level.  An empty battery's is under
# what the emulated gauge takes for "shut down now" (3150 mV), and the firmware
# then does, off USB: as a real Flipper with a flat battery.
BATTERY_CURVE = ((0, 3100), (1, 3400), (5, 3480), (10, 3600), (20, 3700),
                 (50, 3820), (80, 4020), (87, 4061), (100, 4180))


def battery_voltage(percent):
    for (p0, v0), (p1, v1) in zip(BATTERY_CURVE, BATTERY_CURVE[1:]):
        if percent <= p1:
            return round(v0 + (v1 - v0) * (percent - p0) / (p1 - p0))
    return BATTERY_CURVE[-1][1]


def chardev_path(path):
    """A path as the value of a -chardev option: its commas doubled"""
    return str(path).replace(",", ",,")


def serial_args(dev: Device, serial):
    """USART1: the firmware's log, and pins 13 and 14 of a real one.  Whatever
    it is connected to, what the firmware writes to it is kept in the
    device's uart.log, for `flipperemu log` and the window."""
    log = f",logfile={chardev_path(dev.uart)},logappend=on"
    if serial in ("stdio", "pty", "null"):
        backend = serial
    elif serial.startswith("tcp:"):
        host, _, port = serial[4:].rpartition(":")
        if not port.isdigit() or not 0 < int(port) < 65536:
            sys.exit(f"--serial: expected tcp:PORT or tcp:HOST:PORT, not {serial!r}")
        # the firmware listens on it too (for an expansion module): this
        # computer only, unless asked
        backend = (f"socket,host={host.strip('[]') or '127.0.0.1'},port={port},"
                   "server=on,wait=off")
    elif serial.startswith("file:"):
        path = pathlib.Path(serial[5:])
        backend = f"file,path={chardev_path(path)},append=on"
        if path.resolve() == dev.uart.resolve():
            log = ""                    # it is the log
    else:
        return ["-serial", serial]      # QEMU's own words: no uart.log
    name, _, options = backend.partition(",")
    return ["-chardev", f"{name},id=uart" + (f",{options}" if options else "") + log,
            "-serial", "chardev:uart"]


def new_log(dev: Device, serial):
    """A run starts a new log, and the one before it is kept as uart.log.1.
    (Each QEMU of a run adds to the log: switching the Flipper off and on in
    its window loses nothing.)"""
    try:
        if dev.uart.stat().st_size:
            os.replace(dev.uart, dev.uart_old)
    except OSError:
        pass
    if serial.startswith("file:"):
        path = pathlib.Path(serial[5:])
        try:
            if path.is_file():
                os.truncate(path, 0)
        except OSError:
            pass


def qemu_cmd(dev: Device, args, window="gtk", gauge=None):
    """gauge: {property: value} of /machine/gauge to start with"""
    machine = (f"flipper-zero,name={args.name or dev.name[:8]}"
               f",lcd-scale={args.scale or 4}"
               f",nvram={dev.nvram},enclave={dev.enclave}")
    if args.legacy_sleep:
        machine += ",legacy-sleep=on"
    if args.unplugged:
        machine += ",usb-cable=off"
    if args.log_level:
        machine += f",log-level={args.log_level}"
    usb = []
    if args.usb == "pty":
        usb = ["-chardev", "pty,id=usb"]
    elif args.usb == "unix":
        usb = ["-chardev", f"socket,id=usb,path={dev.usb_sock},server=on,wait=off"]
    elif args.usb.startswith("tcp:"):
        usb = ["-chardev", f"socket,id=usb,host=127.0.0.1,port={args.usb[4:]},"
                           "server=on,wait=off"]
    elif args.usb != "none":
        sys.exit(f"--usb: expected pty, unix, tcp:PORT or none, not {args.usb!r}")
    if usb:
        machine += ",usb-serial=usb"
    if args.usbip:
        usb += ["-chardev", f"socket,id=usbip,host={args.usbip_host},"
                            f"port={args.usbip},server=on,wait=off"]
        machine += ",usbip=usbip"
    audio = audio_args(args)
    if audio:
        machine += ",audiodev=snd0"
    cmd = [str(QEMU), "-M", machine, *usb, *audio,
           # every Sub-GHz transmission is saved as a .sub RAW file, every
           # infrared one as an .ir file, every 125 kHz emulation as a
           # capture of what a reader would see, and what the virtual NFC
           # reader reads from an emulated card as a .nfc file
           "-global", f"cc1101.tx-dir={dev.dir / 'subghz-tx'}",
           # a real radio (an SDR, through scripts/fe_sdr.py) can be the
           # CC1101's antenna: `./flipperemu subghz --sdr ...`
           "-chardev", f"socket,id=subghz-link,path={dev.subghz_sock},server=on,wait=off",
           "-global", "cc1101.link=subghz-link",
           # and a card on the NFC link (a program, or a real reader's antenna)
           "-chardev", f"socket,id=nfc-link,path={dev.nfc_sock},server=on,wait=off",
           "-global", "st25r3916.link=nfc-link",
           # the front panel: the LCD, the lights and the buttons, for the
           # window drawn around them (docs/PANEL_LINK.md)
           "-chardev", f"socket,id=panel,path={dev.panel_sock},server=on,wait=off",
           "-global", "flipper-panel.link=panel",
           "-global", f"flipper-ir.tx-dir={dev.dir / 'ir-tx'}",
           "-global", f"flipper-rfid.tx-dir={dev.dir / 'rfid-tx'}",
           "-global", f"flipper-ibutton.tx-dir={dev.dir / 'ibutton-tx'}",
           "-global", f"st25r3916.tx-dir={dev.dir / 'nfc-tx'}",
           "-drive", f"if=pflash,format=raw,file={dev.flash}",
           "-rtc", "base=localtime",
           "-monitor", f"unix:{dev.monitor},server=on,wait=off",
           "-name", f"Flipper Zero ({dev.name})"]
    for prop, value in (gauge or {}).items():
        cmd += ["-global", f"bq27220.{prop}={value}"]
    if not args.no_sd and dev.sd.exists():
        cmd += ["-drive", f"if=sd,format=raw,file={dev.sd}"]
    if window == "gtk":
        cmd += ["-display", "gtk,show-menubar=off,zoom-to-fit=off"]
    else:                               # none, or the window is ours
        cmd += ["-display", "none"]
    cmd += serial_args(dev, args.serial)
    if args.gdb or args.wait_gdb:
        cmd += ["-gdb", f"tcp::{args.gdb_port}"]
    if args.wait_gdb:
        cmd += ["-S"]
    return cmd + list(args.qemu_args or [])


def cmd_run(args):
    if not QEMU.exists():
        sys.exit(f"QEMU not built yet: run scripts/setup_qemu.sh ({QEMU})")
    dev = Device(args.device)
    if not args.print_cmd:
        dev.refuse_if_running()
    if args.update and (args.usb == "none" or args.unplugged):
        sys.exit("--update starts the install over the USB CLI; drop --usb none "
                 "and --unplugged")
    gauge = None
    if args.battery is not None:
        if not 0 <= args.battery <= 100:
            sys.exit("--battery: 0 to 100 percent")
        gauge = {"soc": args.battery, "voltage-mv": battery_voltage(args.battery)}
    window = pick_window(args)
    if window == "qt" and not args.print_cmd:
        need_display()
    if args.firmware:
        fw = pathlib.Path(args.firmware)
        label, resources = dev.program(fw, args.erase_all)
        print(f"[{dev.name}] flashed {label}")
        if not dev.sd.exists() and not args.no_sd and not args.print_cmd:
            dev.make_sd(resources or find_resources_for(fw))
    if not dev.flash.exists():
        sys.exit(f"[{dev.name}] nothing flashed yet: ./flipperemu run -f <firmware>")
    if args.print_cmd:
        print(" ".join(qemu_cmd(dev, args, window, gauge)))
        return 0
    if not dev.sd.exists() and not args.no_sd:
        dev.make_sd(dev.info().get("resources"))
    manifest = label = None
    if args.update:
        if args.no_sd:
            sys.exit("--update needs the SD card")
        manifest, label = stage_update(dev, pathlib.Path(args.update), args.keep_radio)
        print(f"[{dev.name}] staged {manifest}"
              + ("" if args.keep_radio else " (radio stage dropped: the emulated "
                 "CPU2 cannot install a stack)"))
    info = dev.info()
    print(f"[{dev.name}] {info.get('firmware', '?')}  "
          f"(monitor: {dev.monitor}"
          + (f", gdb: :{args.gdb_port}" if args.gdb or args.wait_gdb else "") + ")")
    new_log(dev, args.serial)
    session = Session(dev, args, window, gauge, manifest, label)
    session.start()
    # killing the launcher stops the emulator too (Ctrl-C already reaches both)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, frame: session.signal(signum))
    if args.usbip:
        print(f"[{dev.name}] USB/IP on {args.usbip_host}:{args.usbip}: attach with "
              f"`sudo {ROOT / 'scripts' / 'usbip_attach.py'} --port {args.usbip}`",
              flush=True)
    if window == "qt":
        import fe_gui
        return fe_gui.run(dev.name, dev.dir, ROOT / "flipperemu", session=session,
                          scale=args.scale)
    try:
        return session.proc.wait()
    except KeyboardInterrupt:
        return session.stop()
    finally:
        session.tidy()


class Session:
    """A device's QEMU.  It exits when the Flipper switches itself off;
    start() again is switching it back on (the window does that)."""

    def __init__(self, dev, args, window, gauge=None, manifest=None, label=None):
        self.dev, self.args, self.window = dev, args, window
        self.gauge = dict(gauge or {})
        self.update = (manifest, label)
        self.proc = None

    def start(self, unplugged=None, gauge=None):
        """unplugged, gauge: as it was left when it went off (default: as
        the run was asked for)"""
        dev, args = self.dev, self.args
        if unplugged is not None:
            args.unplugged = unplugged
        if gauge is not None:
            self.gauge = dict(gauge)
        for stale in (dev.monitor, dev.usb_tty, dev.panel_sock, dev.held_file):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass
        self.proc = subprocess.Popen(qemu_cmd(dev, args, self.window, self.gauge))
        manifest, label = self.update
        self.update = (None, None)          # an update is started once
        args.log_level = None               # ... and its log level set once
        if args.usb == "pty" or manifest:
            threading.Thread(target=usb_helpers,
                             args=(dev, self.proc, args.usb, manifest, label),
                             daemon=True).start()
        return self.proc

    def poll(self):
        """QEMU's exit code once it is gone, None while it runs"""
        return self.proc.poll() if self.proc else 0

    def tidy(self):
        """Behind a QEMU that is gone: what only meant something while it ran"""
        for stale in (self.dev.usb_tty, self.dev.held_file):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass

    def signal(self, signum):
        if self.proc and self.proc.poll() is None:
            self.proc.send_signal(signum)

    def stop(self, timeout=10):
        """As `flipperemu stop`: QEMU saves the NVRAM on its way out."""
        if not self.proc:
            return 0
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        return self.proc.wait()


def usb_helpers(dev: Device, proc, usb_mode, manifest, label=None):
    """Link devices/<name>/usb.tty to QEMU's pty for the USB serial port, and
    start a staged update through the firmware's CLI (as qFlipper does)."""
    from fe_cli import FlipperCli, usb_endpoint
    ep = None
    for _ in range(100):
        if proc.poll() is not None:
            return
        if dev.monitor.exists():
            try:
                ep = usb_endpoint(dev.monitor)
            except OSError:
                ep = None
            if ep:
                break
        time.sleep(0.1)
    if not ep:
        return
    if ep[0] == "pty":
        dev.usb_tty.symlink_to(ep[1])
        print(f"[{dev.name}] USB serial (CLI/RPC): {ep[1]} -> {dev.usb_tty}"
              f"   (./flipperemu -d {dev.name} cli)", flush=True)
    if not manifest:
        return
    try:
        cli = FlipperCli(ep)
        try:
            cli.read_until_prompt(60)
            cli.write(f"update install {manifest}\r".encode())
            out, end = b"", time.time() + 20
            while time.time() < end and b"BRB" not in out and b"Error" not in out:
                if cli._fill(0.2):
                    out += cli.buf
                    cli.buf = b""
        finally:
            cli.close()
    except (OSError, TimeoutError, ConnectionError) as e:
        print(f"[{dev.name}] could not start the update over USB: {e}", flush=True)
        return
    text = out.decode(errors="replace")
    if "BRB" in text:
        print(f"[{dev.name}] updater started: {manifest}", flush=True)
        dev.save_info(firmware=f"{label} (installed by update)",
                      flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)
    else:
        err = re.search(r"Error: [^\r\n]*", text)
        print(f"[{dev.name}] update refused: {err.group(0) if err else text.strip()}",
              flush=True)


def cmd_stop(args):
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        print(f"[{dev.name}] not running")
        return 0
    m = Monitor(str(dev.monitor))
    m.s.sendall(b"quit\n")
    m.close()
    for _ in range(100):                # QEMU removes the socket on exit
        if not dev.monitor.exists():
            break
        time.sleep(0.1)
    print(f"[{dev.name}] stopped")
    return 0


