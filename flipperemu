"""FlipperEmu - run Flipper Zero firmware in QEMU, no Flipper required.

Each virtual device lives in devices/<name>/ with a persistent 1 MiB internal
flash (flash.img) and a microSD card (sd.img), exactly like a real one: what
you flash stays flashed, settings and files persist across runs.

  ./flipperemu run  -f firmware.elf          flash + boot (GTK window)
  ./flipperemu run                           boot whatever is flashed
  ./flipperemu run -f update.tgz --headless  update package, no window
  ./flipperemu run --update update.tgz       install it through the firmware's own
                                             updater (OTA, keeps settings and files)
  ./flipperemu stop                          shut a running device down cleanly
  ./flipperemu flash fw.dfu                  just program the flash
  ./flipperemu sd --resources update.tgz     (re)build the SD card
  ./flipperemu cli                           USB CLI of a running device
  ./flipperemu cli "storage list /ext"       run CLI commands, print output
  ./flipperemu ir NEC 0x04 0x08              point a virtual IR remote at it
  ./flipperemu gdb                           attach gdb to a --gdb run
  ./flipperemu shot out.png | press ok       drive a running device
  ./flipperemu info                          what is on the device

Firmware formats: .elf (from fbt: build/f7-firmware-*/firmware.elf),
.dfu / .bin (release or fbt dist/), and update packages (.tgz, official,
Momentum, Unleashed, ...). Keys: arrows, Enter/Space = OK, Backspace/Esc = Back.

USB: the firmware's USB serial port (CLI and protobuf RPC) is bridged to a
pty by default (--usb), linked as devices/<name>/usb.tty while running.
"""
import argparse
import io
import json
import os
import pathlib
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tarfile
import threading
import time

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))

QEMU = ROOT / "build" / "qemu" / "qemu-system-arm"
DEVICES = ROOT / "devices"
FLASH_BASE = 0x08000000
FLASH_SIZE = 1 << 20
SECURE_START = 0x080D7000          # SFSA 0xD7: CPU2 area, never written


# ------------------------------------------------------------ firmware IO

def parse_dfu(data: bytes):
    """DfuSe: yields (address, bytes) elements."""
    if data[:5] != b"DfuSe":
        raise ValueError("not a DfuSe file")
    off, out = 11, []
    for _ in range(data[10]):
        if data[off:off + 6] != b"Target":
            raise ValueError("bad DfuSe target prefix")
        nel = struct.unpack_from("<I", data, off + 270)[0]
        off += 274
        for _ in range(nel):
            addr, size = struct.unpack_from("<II", data, off)
            out.append((addr, data[off + 8:off + 8 + size]))
            off += 8 + size
    return out


def parse_elf(data: bytes):
    """Loadable file contents at their physical (load) addresses."""
    if data[:4] != b"\x7fELF" or data[4] != 1:
        raise ValueError("not a 32-bit ELF")
    phoff, = struct.unpack_from("<I", data, 28)
    phentsize, phnum = struct.unpack_from("<HH", data, 42)
    out = []
    for i in range(phnum):
        p_type, p_off, _vaddr, p_paddr, p_filesz = struct.unpack_from(
            "<IIIII", data, phoff + i * phentsize)
        if p_type == 1 and p_filesz and FLASH_BASE <= p_paddr < FLASH_BASE + FLASH_SIZE:
            out.append((p_paddr, data[p_off:p_off + p_filesz]))
    if not out:
        raise ValueError("ELF has nothing to load into flash")
    return out


def load_firmware(path: pathlib.Path):
    """-> (elements, elf_bytes_or_None, resources_source_or_None, label)"""
    raw = path.read_bytes()
    name = path.name.lower()
    if raw[:4] == b"\x7fELF":
        return parse_elf(raw), raw, None, path.name
    if raw[:5] == b"DfuSe":
        return parse_dfu(raw), None, None, path.name
    if name.endswith((".tgz", ".tar.gz", ".tar")):
        with tarfile.open(path, "r:*") as tar:
            names = tar.getnames()
            dfu = next((n for n in names if n.endswith("firmware.dfu")), None)
            if not dfu:
                raise ValueError("no firmware.dfu in the package")
            fuf = next((n for n in names if n.endswith("update.fuf")), None)
            label = path.name
            if fuf:
                for line in tar.extractfile(fuf).read().decode(errors="replace").splitlines():
                    if line.startswith("Info:"):
                        label = line.split(":", 1)[1].strip()
            return parse_dfu(tar.extractfile(dfu).read()), None, path, label
    if name.endswith(".bin"):
        return [(FLASH_BASE, raw)], None, None, path.name
    raise ValueError(f"don't know how to load {path}")


# ---------------------------------------------------------------- device

class Device:
    def __init__(self, name: str):
        self.name = name
        self.dir = DEVICES / name
        self.flash = self.dir / "flash.img"
        self.sd = self.dir / "sd.img"
        self.elf = self.dir / "firmware.elf"
        self.meta = self.dir / "device.json"
        self.monitor = self.dir / "monitor.sock"
        self.uart = self.dir / "uart.log"
        self.nvram = self.dir / "nvram.bin"     # gauge + RTC backup domain
        self.usb_sock = self.dir / "usb.sock"   # --usb unix
        self.usb_tty = self.dir / "usb.tty"     # --usb pty: symlink to the pty

    def running(self):
        """Is a QEMU serving this device's monitor socket?"""
        if not self.monitor.exists():
            return False
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            s.connect(str(self.monitor))
            return True
        except OSError:
            return False
        finally:
            s.close()

    def refuse_if_running(self):
        # two emulators (or mtools) on one flash/SD image corrupt it
        if self.running():
            sys.exit(f"[{self.name}] is running: ./flipperemu -d {self.name} stop first")

    def info(self):
        try:
            return json.loads(self.meta.read_text())
        except (OSError, ValueError):
            return {}

    def save_info(self, **kw):
        info = self.info()
        info.update(kw)
        self.meta.write_text(json.dumps(info, indent=2) + "\n")

    def program(self, fw: pathlib.Path, erase_all: bool = False):
        elements, elf, resources, label = load_firmware(fw)
        self.dir.mkdir(parents=True, exist_ok=True)
        if not self.flash.exists() or erase_all:
            self.flash.write_bytes(b"\xff" * FLASH_SIZE)
        img = bytearray(self.flash.read_bytes().ljust(FLASH_SIZE, b"\xff"))
        # like DFU: erase every touched 4 KiB page first, then program
        for addr, data in elements:
            if addr < FLASH_BASE or addr + len(data) > SECURE_START:
                raise ValueError(f"element {addr:#x}+{len(data)} outside user flash")
            off = addr - FLASH_BASE
            first, last = off // 4096, (off + len(data) - 1) // 4096
            img[first * 4096:(last + 1) * 4096] = b"\xff" * ((last - first + 1) * 4096)
        for addr, data in elements:
            off = addr - FLASH_BASE
            img[off:off + len(data)] = data
        self.flash.write_bytes(img)
        if elf:
            self.elf.write_bytes(elf)
        elif self.elf.exists():
            self.elf.unlink()                   # stale symbols would mislead gdb
        if resources is None:
            resources = find_resources_for(fw)
        self.save_info(firmware=label, source=str(fw.resolve()),
                       flashed=time.strftime("%Y-%m-%d %H:%M:%S"),
                       bytes=sum(len(d) for _, d in elements),
                       **({"resources": str(resources.resolve())} if resources else {}))
        return label, resources

    def make_sd(self, resources=None, size="512M", force=False):
        cmd = [sys.executable, "-I", str(ROOT / "scripts" / "make_sdcard.py"),
               str(self.sd), "--size", size]
        if resources:
            cmd += ["--resources", str(resources)]
        if force:
            cmd.append("--force")
        subprocess.run(cmd, check=True)


def find_resources_for(fw: pathlib.Path):
    """Release folders from fetch_firmware.py keep resources next to the ELF."""
    for pat in ("*update*.tgz", "*resources*.tgz"):
        hits = sorted(fw.parent.glob(pat))
        if hits:
            return hits[0]
    return None


def stage_update(dev: Device, pkg: pathlib.Path, keep_radio: bool) -> str:
    """Put an update package on the SD card the way qFlipper does; return the
    manifest path as the firmware sees it.

    The emulated CPU2 is ST's FUS without a radio stack and cannot install
    one, so unless keep_radio is set the radio stage is blanked exactly as
    `fbt updater_package` writes a package without a stack. Every key stays
    in place: the firmware reads the manifest's optional keys in file order,
    and a missing one would hide all the keys after it.
    """
    import tempfile
    from make_sdcard import safe_extract
    with tempfile.TemporaryDirectory(prefix="fe-update-") as tmp:
        tmp = pathlib.Path(tmp)
        if pkg.is_dir():
            shutil.copytree(pkg, tmp / pkg.name)
        else:
            with tarfile.open(pkg, "r:*") as tar:
                safe_extract(tar, tmp)
        manifests = sorted(tmp.rglob("update.fuf"))
        if len(manifests) != 1:
            sys.exit(f"{pkg}: expected one update.fuf, found {len(manifests)}")
        pdir = manifests[0].parent
        if not keep_radio:
            fuf = pdir / "update.fuf"
            text = fuf.read_text()
            text = re.sub(r"(?m)^Radio: .*$", "Radio: ", text)
            text = re.sub(r"(?m)^Radio version: .*$",
                          "Radio version: 00 00 00 00 00 00", text)
            fuf.write_text(text)
            (pdir / "radio.bin").unlink(missing_ok=True)
        info = re.search(r"(?m)^Info: *(.+)$", (pdir / "update.fuf").read_text())
        img = ["-i", str(dev.sd)]
        subprocess.run(["mmd", *img, "::update"], capture_output=True)
        subprocess.run(["mdeltree", *img, f"::update/{pdir.name}"], capture_output=True)
        subprocess.run(["mcopy", *img, "-s", "-Q", str(pdir), "::update/"], check=True)
    return f"/ext/update/{pdir.name}/update.fuf", (info.group(1).strip() if info else pdir.name)


# --------------------------------------------------------------- commands

def cmd_flash(args):
    dev = Device(args.device)
    dev.refuse_if_running()
    label, _ = dev.program(pathlib.Path(args.firmware), args.erase_all)
    print(f"[{dev.name}] flashed {label} -> {dev.flash}")


def cmd_sd(args):
    dev = Device(args.device)
    dev.refuse_if_running()
    dev.dir.mkdir(parents=True, exist_ok=True)
    dev.make_sd(args.resources, args.size, force=True)


def audio_backends():
    """Audio drivers compiled into our QEMU (configure enables PipeWire,
    PulseAudio, ALSA or SDL when their development headers are installed)."""
    try:
        out = subprocess.run([str(QEMU), "-audiodev", "help"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [l.strip() for l in out.splitlines()[1:] if l.strip()]


def audio_args(args):
    """-audiodev for the speaker: none | wav:PATH | a QEMU audio driver | auto"""
    choice = args.audio
    if choice == "auto":
        if args.headless or args.print_cmd:
            return []
        have = audio_backends()
        choice = next((b for b in ("pipewire", "pa", "alsa", "sdl") if b in have), None)
        if not choice:
            print("(no speaker: this QEMU has no PipeWire/PulseAudio/ALSA/SDL audio; "
                  "install e.g. pipewire-devel and re-run scripts/setup_qemu.sh, "
                  "or record with --audio wav:FILE)")
            return []
    if choice == "none":
        return []
    if choice.startswith("wav:"):
        return ["-audiodev", f"wav,id=snd0,path={pathlib.Path(choice[4:]).resolve()}"]
    return ["-audiodev", f"{choice},id=snd0"]


def qemu_cmd(dev: Device, args):
    machine = (f"flipper-zero,name={args.name or dev.name[:8]},lcd-scale={args.scale}"
               f",nvram={dev.nvram}")
    if args.legacy_sleep:
        machine += ",legacy-sleep=on"
    usb = []
    if args.usb == "pty":
        usb = ["-chardev", "pty,id=usb"]
    elif args.usb == "unix":
        usb = ["-chardev", f"socket,id=usb,path={dev.usb_sock},server=on,wait=off"]
    elif args.usb.startswith("tcp:"):
        usb = ["-chardev", f"socket,id=usb,host=127.0.0.1,port={args.usb[4:]},"
                           "server=on,wait=off"]
    elif args.usb != "none":
        sys.exit(f"--usb: expected pty, unix, tcp:PORT or none, not {args.usb!r}")
    if usb:
        machine += ",usb-serial=usb"
    audio = audio_args(args)
    if audio:
        machine += ",audiodev=snd0"
    cmd = [str(QEMU), "-M", machine, *usb, *audio,
           "-drive", f"if=pflash,format=raw,file={dev.flash}",
           "-rtc", "base=localtime",
           "-monitor", f"unix:{dev.monitor},server=on,wait=off",
           "-name", f"Flipper Zero ({dev.name})"]
    if not args.no_sd and dev.sd.exists():
        cmd += ["-drive", f"if=sd,format=raw,file={dev.sd}"]
    if args.headless:
        cmd += ["-display", "none"]
    else:
        cmd += ["-display", "gtk,show-menubar=off,zoom-to-fit=off"]
    if args.serial == "stdio" and not args.headless:
        cmd += ["-serial", "stdio"]
    elif args.serial == "stdio":
        cmd += ["-serial", "stdio"]
    elif args.serial.startswith("tcp:"):
        cmd += ["-serial", f"tcp::{args.serial[4:]},server=on,wait=off"]
    else:
        cmd += ["-serial", args.serial]
    if args.gdb or args.wait_gdb:
        cmd += ["-gdb", f"tcp::{args.gdb_port}"]
    if args.wait_gdb:
        cmd += ["-S"]
    return cmd + list(args.qemu_args or [])


def cmd_run(args):
    if not QEMU.exists():
        sys.exit(f"QEMU not built yet: run scripts/setup_qemu.sh ({QEMU})")
    dev = Device(args.device)
    if not args.print_cmd:
        dev.refuse_if_running()
    if args.update and args.usb == "none":
        sys.exit("--update starts the install over the USB CLI; drop --usb none")
    if args.firmware:
        fw = pathlib.Path(args.firmware)
        label, resources = dev.program(fw, args.erase_all)
        print(f"[{dev.name}] flashed {label}")
        if not dev.sd.exists() and not args.no_sd and not args.print_cmd:
            dev.make_sd(resources or find_resources_for(fw))
    if not dev.flash.exists():
        sys.exit(f"[{dev.name}] nothing flashed yet: ./flipperemu run -f <firmware>")
    cmd = qemu_cmd(dev, args)
    if args.print_cmd:
        print(" ".join(cmd))
        return 0
    if not dev.sd.exists() and not args.no_sd:
        dev.make_sd(dev.info().get("resources"))
        cmd = qemu_cmd(dev, args)
    manifest = label = None
    if args.update:
        if args.no_sd:
            sys.exit("--update needs the SD card")
        manifest, label = stage_update(dev, pathlib.Path(args.update), args.keep_radio)
        print(f"[{dev.name}] staged {manifest}"
              + ("" if args.keep_radio else " (radio stage dropped: the emulated "
                 "CPU2 cannot install a stack)"))
    info = dev.info()
    print(f"[{dev.name}] {info.get('firmware', '?')}  "
          f"(monitor: {dev.monitor}"
          + (f", gdb: :{args.gdb_port}" if args.gdb or args.wait_gdb else "") + ")")
    for stale in (dev.monitor, dev.usb_tty):
        try:
            stale.unlink()
        except FileNotFoundError:
            pass
    proc = subprocess.Popen(cmd)
    # killing the launcher stops the emulator too (Ctrl-C already reaches both)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, frame: proc.send_signal(signum))
    if args.usb == "pty" or manifest:
        threading.Thread(target=usb_helpers,
                         args=(dev, proc, args.usb, manifest, label),
                         daemon=True).start()
    try:
        return proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        return proc.wait()


def usb_helpers(dev: Device, proc, usb_mode, manifest, label=None):
    """Link devices/<name>/usb.tty to QEMU's pty for the USB serial port, and
    start a staged update through the firmware's CLI (as qFlipper does)."""
    from fe_cli import FlipperCli, usb_endpoint
    ep = None
    for _ in range(100):
        if proc.poll() is not None:
            return
        if dev.monitor.exists():
            try:
                ep = usb_endpoint(dev.monitor)
            except OSError:
                ep = None
            if ep:
                break
        time.sleep(0.1)
    if not ep:
        return
    if ep[0] == "pty":
        dev.usb_tty.symlink_to(ep[1])
        print(f"[{dev.name}] USB serial (CLI/RPC): {ep[1]} -> {dev.usb_tty}"
              f"   (./flipperemu -d {dev.name} cli)", flush=True)
    if not manifest:
        return
    try:
        cli = FlipperCli(ep)
        try:
            cli.read_until_prompt(60)
            cli.write(f"update install {manifest}\r".encode())
            out, end = b"", time.time() + 20
            while time.time() < end and b"BRB" not in out and b"Error" not in out:
                if cli._fill(0.2):
                    out += cli.buf
                    cli.buf = b""
        finally:
            cli.close()
    except (OSError, TimeoutError, ConnectionError) as e:
        print(f"[{dev.name}] could not start the update over USB: {e}", flush=True)
        return
    text = out.decode(errors="replace")
    if "BRB" in text:
        print(f"[{dev.name}] updater started: {manifest}", flush=True)
        dev.save_info(firmware=f"{label} (installed by update)",
                      flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)
    else:
        err = re.search(r"Error: [^\r\n]*", text)
        print(f"[{dev.name}] update refused: {err.group(0) if err else text.strip()}",
              flush=True)


def cmd_stop(args):
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        print(f"[{dev.name}] not running")
        return 0
    m = Monitor(str(dev.monitor))
    m.s.sendall(b"quit\n")
    m.close()
    for _ in range(100):                # QEMU removes the socket on exit
        if not dev.monitor.exists():
            break
        time.sleep(0.1)
    print(f"[{dev.name}] stopped")
    return 0


def cmd_gdb(args):
    dev = Device(args.device)
    gdb = shutil.which("gdb-multiarch") or shutil.which("arm-none-eabi-gdb") or "gdb"
    cmd = [gdb, "-q"]
    if dev.elf.exists():
        cmd += ["-ex", f"file {dev.elf}"]
    else:
        print("(no ELF for this firmware: flash an .elf to get symbols)")
        cmd += ["-ex", "set architecture armv7e-m"]
    cmd += ["-ex", f"target remote :{args.gdb_port}"]
    os.execvp(cmd[0], cmd)


def cmd_cli(args):
    from fe_cli import FlipperCli, usb_endpoint
    dev = Device(args.device)
    if not dev.monitor.exists():
        sys.exit(f"[{dev.name}] not running (no {dev.monitor})")
    ep = usb_endpoint(dev.monitor)
    if not ep:
        sys.exit(f"[{dev.name}] was started with --usb none")
    cli = FlipperCli(ep)
    try:
        if not args.commands:
            print(f"[{dev.name}] USB CLI on {ep[1]}; Ctrl-] quits")
            cli.interactive()
            return 0
        cli.read_until_prompt(args.timeout)
        for command in args.commands:
            print(cli.run(command, timeout=args.timeout, color=sys.stdout.isatty()))
    finally:
        cli.close()
    return 0


def cmd_ir(args):
    import fe_ir
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    sig = args.signal
    try:
        if sig[0].lower() == "raw":
            label, durs = "raw", [abs(int(x)) for x in sig[1:]]
        elif sig[0].endswith(".ir"):
            label, durs = fe_ir.parse_ir_file(sig[0], sig[1] if len(sig) > 1 else None)
        elif len(sig) == 3:
            proto = next((p for p in fe_ir.SPECS if p.lower() == sig[0].lower()), sig[0])
            label = f"{proto} A:{int(sig[1], 0):#x} C:{int(sig[2], 0):#x}"
            durs = fe_ir.encode(proto, int(sig[1], 0), int(sig[2], 0), args.repeat)
        else:
            sys.exit("usage: ir PROTOCOL ADDRESS COMMAND | ir raw D1 D2 ... | ir FILE.ir [NAME]")
    except (ValueError, KeyError, OSError) as e:
        sys.exit(f"ir: {e}")
    if not durs:
        sys.exit("ir: empty signal")
    m = Monitor(str(dev.monitor))
    err = m.cmd("qom-set /machine/ir rx " + ",".join(map(str, durs)))
    m.close()
    if err:
        sys.exit(f"ir: {err}")
    print(f"[{dev.name}] IR {label}: {len(durs)} marks/spaces, {sum(durs) / 1000:.0f} ms")
    return 0


def cmd_shot(args):
    from fe_monitor import Monitor
    print(Monitor(str(Device(args.device).monitor)).screenshot(args.out))


def cmd_press(args):
    from fe_monitor import Monitor
    m = Monitor(str(Device(args.device).monitor))
    for key in args.keys:
        m.press(key, args.hold)
        time.sleep(args.gap / 1000)


def cmd_info(args):
    dev = Device(args.device)
    info = dev.info()
    print(f"device   : {dev.name} ({dev.dir})")
    for k in ("firmware", "source", "flashed", "bytes", "resources"):
        if k in info:
            print(f"{k:9}: {info[k]}")
    print(f"flash    : {'yes' if dev.flash.exists() else 'no'}")
    print(f"sd card  : {'yes' if dev.sd.exists() else 'no'}")
    print(f"symbols  : {'yes' if dev.elf.exists() else 'no'}")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-d", "--device", default="default",
                    help="virtual device name (devices/<name>/), default: default")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("run", help="boot the device (optionally flashing first)")
    p.add_argument("-f", "--firmware", help=".elf/.dfu/.bin/update .tgz to flash first")
    p.add_argument("--update", metavar="PKG",
                   help="install an update package (.tgz or folder) through the "
                        "firmware's own updater, like qFlipper: settings and files stay")
    p.add_argument("--keep-radio", action="store_true",
                   help="with --update: keep the radio stack stage (the emulated CPU2 "
                        "cannot install it, so the updater will fail)")
    p.add_argument("--erase-all", action="store_true", help="wipe flash before programming")
    p.add_argument("--headless", action="store_true", help="no window")
    p.add_argument("--no-sd", action="store_true", help="boot without a microSD card")
    p.add_argument("--usb", default="pty",
                   help="USB serial port (CLI/RPC): pty (default), unix "
                        "(devices/<name>/usb.sock), tcp:PORT, none (cable unplugged)")
    p.add_argument("--audio", default="auto",
                   help="speaker: auto (a desktop audio driver if QEMU has one; silent "
                        "when headless), wav:FILE (record), pipewire, pa, alsa, sdl, none")
    p.add_argument("--serial", default="stdio",
                   help="USART1 log: stdio (default), file:PATH, pty, tcp:PORT, null")
    p.add_argument("--gdb", action="store_true", help="enable the gdb stub")
    p.add_argument("--wait-gdb", action="store_true", help="gdb stub, halt at reset")
    p.add_argument("--gdb-port", type=int, default=1234)
    p.add_argument("--scale", type=int, default=4, help="LCD pixel size (default 4)")
    p.add_argument("--name", help="device name in OTP (max 8 chars)")
    p.add_argument("--legacy-sleep", action="store_true",
                   help="new device starts with Sleep Method = Legacy (light sleep "
                        "only) instead of the firmware's default STOP2")
    p.add_argument("--print-cmd", action="store_true", help="show the QEMU command and exit")
    p.add_argument("qemu_args", nargs="*", help="extra QEMU arguments after --")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("flash", help="program firmware into the device flash")
    p.add_argument("firmware")
    p.add_argument("--erase-all", action="store_true")
    p.set_defaults(func=cmd_flash)

    p = sub.add_parser("sd", help="(re)create the microSD image")
    p.add_argument("--resources", help="resources .tgz, update package or directory")
    p.add_argument("--size", default="512M")
    p.set_defaults(func=cmd_sd)

    p = sub.add_parser("stop", help="shut a running device down (saves its NVRAM)")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("cli", help="the USB CLI of a running device")
    p.add_argument("commands", nargs="*",
                   help="run these CLI commands and print their output "
                        "(default: interactive session, Ctrl-] quits)")
    p.add_argument("--timeout", type=float, default=30)
    p.set_defaults(func=cmd_cli)

    p = sub.add_parser("ir", help="send an infrared signal to a running device's receiver")
    p.add_argument("signal", nargs="+",
                   help="PROTOCOL ADDRESS COMMAND (NEC NECext NEC42 NEC42ext Samsung32 "
                        "SIRC SIRC15 SIRC20 RC5 RC5X RC6 RCA Pioneer Kaseikyo), "
                        "raw MARK SPACE MARK ... (µs), or FILE.ir [NAME]")
    p.add_argument("--repeat", type=int, help="frames to send (default: what the "
                                              "protocol's encoder sends)")
    p.set_defaults(func=cmd_ir)

    p = sub.add_parser("gdb", help="attach gdb to a running --gdb device")
    p.add_argument("--gdb-port", type=int, default=1234)
    p.set_defaults(func=cmd_gdb)

    p = sub.add_parser("shot", help="save the LCD of a running device as PNG")
    p.add_argument("out")
    p.set_defaults(func=cmd_shot)

    p = sub.add_parser("press", help="press buttons on a running device")
    p.add_argument("keys", nargs="+", help="ok back up down left right")
    p.add_argument("--hold", type=int, default=120, help="ms per press")
    p.add_argument("--gap", type=int, default=250, help="ms between presses")
    p.set_defaults(func=cmd_press)

    p = sub.add_parser("info", help="show what is on the device")
    p.set_defaults(func=cmd_info)

    args = ap.parse_args()
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
