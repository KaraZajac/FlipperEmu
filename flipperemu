# What every device on a bus has, and is not a value of its own
I2C_EVERY = ("type", "parent_bus", "realized", "hotplugged", "hotpluggable",
             "address")


def bus_types(bus):
    """The devices that this build of QEMU has for a kind of bus, as its
    `-device help` names that (i2c-bus, SSI): [(its name there, what QEMU
    says it is, or '')]; none: QEMU did not say"""
    try:
        said = subprocess.run([str(QEMU), "-device", "help"],
                              capture_output=True, text=True, timeout=30,
                              stdin=subprocess.DEVNULL).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return sorted(re.findall(
        r'^name "([^"]+)", bus %s(?![\w-])(?:, desc "([^"]*)")?'
        % re.escape(bus), said, re.M))


def i2c_types():
    """The I2C devices that this build of QEMU has, as bus_types has them"""
    return bus_types("i2c-bus")


def i2c_help():
    """`run --i2c help`: what there is to put on the header's bus"""
    types = i2c_types()
    if not types:
        sys.exit(f"flipperemu: {QEMU} did not list its devices (`-device "
                 "help`)")
    short = {}
    for name, kind in I2C_NAMES.items():
        short.setdefault(kind, []).append(name)
    print("QEMU's I2C devices, each a TYPE for `run --i2c TYPE@ADDRESS` (the "
          "bus of pins 15 and 16):")
    wide = max(len(name) for name, _ in types)
    for name, what in types:
        also = " or ".join(f"`{x}`" for x in short.get(name, ()))
        said = (what or I2C_WHAT.get(name, ""),
                also and f"{also} for short")
        print(f"  {name:<{wide}}  {'; '.join(x for x in said if x)}".rstrip())
    return 0


def i2c_known(specs):
    """Refuses a type that this build of QEMU has not, with those it has"""
    parsed = i2c_parse(specs)
    types = [name for name, _ in i2c_types()] if parsed else []
    for kind, address, _, _ in parsed:
        if types and kind not in types:
            sys.exit(f"--i2c {kind}@0x{address:02x}: QEMU has no I2C device "
                     f"'{kind}'.  It has: {', '.join(types)} (`run --i2c "
                     "help` says what they are)")


def i2c_degrees(name):
    """Is a value of that name a temperature?  QEMU's sensors have theirs in
    thousandths of a degree; here they are read and written in °C.
    They also forget one that is given with the device (it is set back when
    the device is put on its bus), so it is set once the emulator runs."""
    return fe_header.i2c_degrees(name)


def i2c_parse(specs):
    """`run --i2c TYPE@ADDRESS[,PROPERTY=VALUE...]`, once for each device on
    the header's I2C bus (pins 15 and 16) -> [(type, address, {property:
    value} for QEMU's -device, {property: value} to set once it runs)].  The
    type is a QEMU I2C device's: i2c_known refuses one that it has not."""
    out, seen = [], {}
    for spec in specs or ():
        head, *props = spec.split(",")
        kind, at, where = head.partition("@")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", kind) or not at:
            sys.exit(f"--i2c {spec}: a device is TYPE@ADDRESS, as "
                     "tmp105@0x48 (and ,PROPERTY=VALUE after it)")
        if not re.fullmatch(r"0[xX][0-9a-fA-F]{1,2}", where):
            sys.exit(f"--i2c {spec}: an address is as 0x48 (seven bits, in "
                     "hex)")
        address = int(where, 16)
        if not 0x08 <= address <= 0x77:
            sys.exit(f"--i2c {spec}: a device's address is 0x08 to 0x77 "
                     "(the others are not for devices)")
        kind = I2C_NAMES.get(kind, kind)
        if address in seen:
            sys.exit(f"--i2c {spec}: {seen[address]} is at 0x{address:02x} "
                     "already (two on a bus have two addresses)")
        seen[address] = kind
        given, later = {}, {}
        for prop in props:
            key, eq, value = prop.partition("=")
            if not key or not eq:
                sys.exit(f"--i2c {spec}: after the address come "
                         f"PROPERTY=VALUE, not '{prop}'")
            if key in ("bus", "address", "id"):
                sys.exit(f"--i2c {spec}: '{key}' is not to be set (the bus "
                         "is the header's, the address is after the @)")
            if i2c_degrees(key):
                if i2c_number(key, value) is None:
                    sys.exit(f"--i2c {spec}: a temperature is in °C, "
                             f"as {key}=23.5")
                later[key] = value
            else:
                given[key] = value
        for key, value in I2C_NEEDS.get(kind, {}).items():
            given.setdefault(key, value)
        if kind == "at24c-eeprom":
            try:
                size = int(given["rom-size"], 0)
            except ValueError:
                size = 0
            if not 0 < size <= 1 << 20:
                sys.exit(f"--i2c {spec}: rom-size is the EEPROM's bytes, 1 "
                         "to 1048576, as rom-size=4096")
            given["rom-size"] = str(size)
        out.append((kind, address, given, later))
    return out


def i2c_rom(dev, address):
    """Where the contents of an EEPROM at that address of the header's bus
    are kept: an EEPROM does not forget when the emulator stops"""
    return dev.dir / f"i2c-{address:02x}.bin"


def i2c_roms(dev, specs):
    """The EEPROMs of `run --i2c` whose contents are kept in the device's
    folder (all that were given no drive of their own): [(address, the
    file, its bytes)]"""
    return [(address, i2c_rom(dev, address), int(given["rom-size"]))
            for kind, address, given, _ in i2c_parse(specs)
            if kind == "at24c-eeprom" and "drive" not in given]


def i2c_args(specs, dev=None):
    """QEMU's arguments for each device of `run --i2c`; dev: with the
    files of its EEPROMs"""
    out = []
    kept = {address: path for address, path, _ in i2c_roms(dev, specs)} \
        if dev else {}
    for kind, address, given, _ in i2c_parse(specs):
        name = f"i2c-{address:02x}"
        if address in kept:
            out += ["-drive", f"if=none,id={name}-rom,format=raw,"
                              f"file={kept[address]}"]
            given = dict(given, drive=f"{name}-rom")
        out += ["-device", ",".join(
            [kind, "bus=i2c3", f"address=0x{address:02x}", f"id={name}"]
            + [f"{k}={v}" for k, v in given.items()])]
    return out


def i2c_number(name, value):
    """A value as QEMU's monitor takes it (a temperature: in thousandths of
    a degree), or None: it is none"""
    if not i2c_degrees(name):
        return value if re.fullmatch(r"[A-Za-z0-9_.+-]+", value) else None
    try:
        return str(round(float(value) * 1000))
    except (ValueError, OverflowError):
        return None


def i2c_path(address):
    return f"/machine/peripheral/i2c-{address:02x}"


def i2c_own(m, address):
    """The names of the values that the device at that address of the
    header's bus has of its own"""
    out = []
    for line in m.cmd(f"qom-list {i2c_path(address)}").splitlines():
        found = re.fullmatch(r"(\S+) \((.+)\)", line.strip())
        if (found and found[1] not in I2C_EVERY
                and not found[2].startswith(("link<", "child<"))):
            out.append(found[1])
    return sorted(out)


def i2c_read(m, address, name):
    """A value of that device as it is (None: it has none); a temperature
    in °C"""
    value = qom_get(m, i2c_path(address), name)
    if (i2c_degrees(name) and isinstance(value, int)
            and not isinstance(value, bool)):
        return value / 1000
    return value


def i2c_value(m, address, name, unit=True):
    """A value of that device, in words"""
    return fe_header.i2c_said(name, i2c_read(m, address, name), unit)


def i2c_device(dev, m, kind, address):
    """A device on the header's bus with the values it has of its own, as
    `i2c --json` prints it; an EEPROM whose contents are kept in the
    device's folder has that "file" too"""
    d = {"type": kind, "address": address,
         "values": {name: i2c_read(m, address, name)
                    for name in i2c_own(m, address)}}
    if (kind == "at24c-eeprom"
            and d["values"].get("drive") == f"i2c-{address:02x}-rom"):
        d["file"] = str(i2c_rom(dev, address))
    return d


def i2c_put(m, address, name, value):
    """Set a value of that device.  None, or why it was not taken, in words"""
    number = i2c_number(name, value)
    if number is None:
        return ("a temperature is in °C, as 23.5" if i2c_degrees(name)
                else "a value is a number, or a word as on and off")
    out = m.cmd(f"qom-set {i2c_path(address)} {name} {number}")
    why = re.search(r"Error: *(.*)", out)
    if not why:
        return None
    if "after it was realized" in why[1]:
        return ("that is said when the device is put there (`run --i2c "
                f"TYPE@ADDRESS,{name}=...`), and stays as it is while it "
                "runs")
    return why[1].strip()


def i2c_begin(dev, proc, specs):
    """What `run --i2c` gave a device that it takes only once it is there:
    set as soon as the emulator answers, long before the firmware is up"""
    from fe_monitor import Monitor
    for _ in range(100):
        if proc.poll() is not None:
            return
        if dev.monitor.exists():
            try:
                m = Monitor(str(dev.monitor))
            except OSError:
                time.sleep(0.1)
                continue
            try:
                for kind, address, _, later in specs:
                    for name, value in later.items():
                        why = i2c_put(m, address, name, value)
                        if why:
                            print(f"[{dev.name}] --i2c: {kind} at "
                                  f"0x{address:02x} did not take {name}="
                                  f"{value}: {why}", file=sys.stderr,
                                  flush=True)
            finally:
                m.close()
            return
        time.sleep(0.1)


# `run --spi`: another name for one of QEMU's device types,
SPI_NAMES = {"flash": "w25q32"}
# ... the SPI devices of QEMU that are not for the header: the Flipper's own,
# and a display that wants one more pin, for data or command,
SPI_NOT = ("st7567", "cc1101", "flipper-sd-slot", "st25r3916", "ssd0323")
# ... and the chip select of a device that names none: the pin of the
# firmware's own handle for that bus (PA4)
SPI_PIN = 4


def spi_types():
    """The SPI devices that this build of QEMU has for the header: [(its
    name there, what QEMU says it is, or '')]; none: QEMU did not say"""
    return [(name, what) for name, what in bus_types("SSI")
            if name not in SPI_NOT]


def spi_selects():
    """The header's pins that may be a chip select, in words"""
    pins = [f"{n} ({pin})" for n, pin in fe_header.SPI_SELECTS.items()]
    return ", ".join(pins[:-1]) + f" and {pins[-1]}"


def spi_help():
    """`run --spi help`: what there is to put on the header's bus"""
    import textwrap
    types = spi_types()
    if not types:
        sys.exit(f"flipperemu: {QEMU} did not list its devices (`-device "
                 "help`)")
    print(textwrap.fill(
        "QEMU's SPI devices, each a TYPE for `run --spi TYPE@PIN` (the bus "
        "of pins 2, 3 and 5).  PIN is the device's chip select, a pin of "
        f"the header: {spi_selects()}.  Not said, it is {SPI_PIN}, the one "
        "of the firmware's own handle for that bus.  "
        + "  ".join(f"`{name}` is {kind} for short."
                    for name, kind in SPI_NAMES.items()), 78))
    kinds = {}
    for name, what in types:
        kinds.setdefault(what or "other devices", []).append(name)
    for what, names in sorted(kinds.items()):
        print("Serial flashes, each as large as the part of that name; "
              "contents are kept:" if what == "Serial Flash" else f"{what}:")
        print(textwrap.fill(", ".join(names), 78, initial_indent="  ",
                            subsequent_indent="  "))
    return 0


def spi_parse(specs):
    """`run --spi TYPE[@PIN][,PROPERTY=VALUE...]`, once for each device on
    the header's SPI bus (pins 2, 3 and 5) -> [(type, the pin of its chip
    select by its number on the header, {property: value} for QEMU's
    -device)].  The type is a QEMU SPI device's: spi_known refuses one that
    it has not."""
    out, seen = [], {}
    for spec in specs or ():
        head, *props = spec.split(",")
        kind, at, where = head.partition("@")
        if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", kind)
                or (at and not where)):
            sys.exit(f"--spi {spec}: a device is TYPE@PIN, as w25q32@PA4 "
                     "(and ,PROPERTY=VALUE after it); PIN is its chip "
                     f"select, and {SPI_PIN} when it is not said")
        pin = fe_header.spi_select(where) if at else SPI_PIN
        if pin is None:
            sys.exit(f"--spi {spec}: '{where}' is no pin for a chip select. "
                     f"Those are {spi_selects()} of the header, each by its "
                     "number there, by that name, or as on the case (A4); "
                     "2, 3 and 5 are the bus itself")
        kind = SPI_NAMES.get(kind, kind)
        if pin in seen:
            sys.exit(f"--spi {spec}: {seen[pin]} has its chip select on pin "
                     f"{pin} already (two on a bus have two)")
        seen[pin] = kind
        given = {}
        for prop in props:
            key, eq, value = prop.partition("=")
            if not key or not eq:
                sys.exit(f"--spi {spec}: after the pin come "
                         f"PROPERTY=VALUE, not '{prop}'")
            if key in ("bus", "cs", "id"):
                sys.exit(f"--spi {spec}: '{key}' is not to be set (the bus "
                         "is the header's, the chip select is after the @)")
            given[key] = value
        out.append((kind, pin, given))
    return out


def spi_known(specs):
    """Refuses a type that this build of QEMU has not for the header"""
    parsed = spi_parse(specs)
    types = [name for name, _ in spi_types()] if parsed else []
    for kind, pin, _ in parsed:
        if kind in SPI_NOT:
            sys.exit(f"--spi {kind}@{pin}: {kind} is no device for the "
                     "header here (`run --spi help` lists those that are)")
        if types and kind not in types:
            sys.exit(f"--spi {kind}@{pin}: QEMU has no SPI device '{kind}' "
                     "(`run --spi help` lists those it has; `flash` is "
                     f"{SPI_NAMES['flash']}, a serial flash of 4 MiB)")


SPI_SIZES = {}


def spi_size(kind):
    """How many bytes a flash of that type has.  QEMU is asked: it refuses
    an empty drive for one with the size that it wants (a start without a
    firmware, which ends at once).  0: a device that keeps nothing, or QEMU
    did not say."""
    if kind not in SPI_SIZES:
        try:
            said = subprocess.run(
                [str(QEMU), "-M", "flipper-zero", "-display", "none", "-S",
                 "-monitor", "none", "-serial", "none", "-drive",
                 f"if=none,id=probe,format=raw,file={os.devnull},"
                 "read-only=on", "-device",
                 f"{kind},bus=spi-header,cs={SPI_PIN},drive=probe"],
                capture_output=True, text=True, timeout=10,
                stdin=subprocess.DEVNULL).stderr
        except (OSError, subprocess.SubprocessError):
            said = ""
        hit = re.search(r"requires (\d+) bytes", said)
        SPI_SIZES[kind] = int(hit[1]) if hit else 0
    return SPI_SIZES[kind]


def spi_rom(dev, pin):
    """Where the contents of a flash with its chip select on that pin of the
    header are kept: a flash does not forget when the emulator stops"""
    return dev.dir / f"spi-{pin}.bin"


def spi_roms(dev, specs):
    """The flashes of `run --spi` whose contents are kept in the device's
    folder (all that were given no drive of their own): [(the pin of its
    chip select, its type, the file, its bytes)]"""
    return [(pin, kind, spi_rom(dev, pin), spi_size(kind))
            for kind, pin, given in spi_parse(specs)
            if "drive" not in given and spi_size(kind)]


def spi_new(path, size):
    """A new flash: every bit is 1"""
    with open(path, "wb") as f:
        for at in range(0, size, 1 << 20):
            f.write(b"\xff" * min(1 << 20, size - at))


def spi_args(specs, dev=None):
    """QEMU's arguments for each device of `run --spi`; dev: with the
    files of its flashes"""
    out = []
    kept = {pin: path for pin, _, path, _ in spi_roms(dev, specs)} \
        if dev else {}
    for kind, pin, given in spi_parse(specs):
        name = f"spi-{pin}"
        if pin in kept:
            out += ["-drive", f"if=none,id={name}-rom,format=raw,"
                              f"file={kept[pin]}"]
            given = dict(given, drive=f"{name}-rom")
        out += ["-device", ",".join(
            [kind, "bus=spi-header", f"cs={pin}", f"id={name}"]
            + [f"{k}={v}" for k, v in given.items()])]
    return out


def qemu_cmd(dev: Device, args, window="gtk", gauge=None):
    """gauge: {property: value} of /machine/gauge to start with"""
    machine = (f"flipper-zero,name={args.name or dev.name[:8]}"
               f",lcd-scale={args.scale or 4}"
               f",nvram={dev.nvram},enclave={dev.enclave}")
    if args.legacy_sleep:
        machine += ",legacy-sleep=on"
    if getattr(args, "radio_stack", None):
        machine += f",radio-stack={args.radio_stack}"
    if args.unplugged:
        machine += ",usb-cable=off"
    if args.log_level:
        machine += f",log-level={args.log_level}"
    usb = []
    if args.usb == "pty":
        usb = ["-chardev", "pty,id=usb"]
    elif args.usb == "unix":
        usb = ["-chardev", f"socket,id=usb,path={dev.usb_sock},server=on,wait=off"]
    elif args.usb.startswith("tcp:"):
        usb = ["-chardev", f"socket,id=usb,host=127.0.0.1,port={args.usb[4:]},"
                           "server=on,wait=off"]
    elif args.usb != "none":
        sys.exit(f"--usb: expected pty, unix, tcp:PORT or none, not {args.usb!r}")
    if usb:
        machine += ",usb-serial=usb"
    if args.usbip:
        usb += ["-chardev", f"socket,id=usbip,host={args.usbip_host},"
                            f"port={args.usbip},server=on,wait=off"]
        machine += ",usbip=usbip"
    audio = audio_args(args)
    if audio:
        machine += ",audiodev=snd0"
    cmd = [str(QEMU), "-M", machine, *usb, *audio,
           # every Sub-GHz transmission is saved as a .sub RAW file, every
           # infrared one as an .ir file, every 125 kHz emulation as a
           # capture of what a reader would see, and what the virtual NFC
           # reader reads from an emulated card as a .nfc file
           "-global", f"cc1101.tx-dir={dev.dir / 'subghz-tx'}",
           # a real radio (an SDR, through scripts/fe_sdr.py) can be the
           # CC1101's antenna: `./flipperemu subghz --sdr ...`
           "-chardev", f"socket,id=subghz-link,path={dev.subghz_sock},server=on,wait=off",
           "-global", "cc1101.link=subghz-link",
           # and a card on the NFC link (a program, or a real reader's antenna)
           "-chardev", f"socket,id=nfc-link,path={dev.nfc_sock},server=on,wait=off",
           "-global", "st25r3916.link=nfc-link",
           # and a central on the Bluetooth link, as a phone is: `ble`
           "-chardev", f"socket,id=ble-link,path={dev.ble_sock},server=on,wait=off",
           "-global", "stm32wb55-ipcc.ble-link=ble-link",
           # the front panel: the LCD, the lights and the buttons, for the
           # window drawn around them (docs/PANEL_LINK.md)
           "-chardev", f"socket,id=panel,path={dev.panel_sock},server=on,wait=off",
           "-global", "flipper-panel.link=panel",
           "-global", f"flipper-ir.tx-dir={dev.dir / 'ir-tx'}",
           "-global", f"flipper-rfid.tx-dir={dev.dir / 'rfid-tx'}",
           "-global", f"flipper-ibutton.tx-dir={dev.dir / 'ibutton-tx'}",
           "-global", f"st25r3916.tx-dir={dev.dir / 'nfc-tx'}",
           "-drive", f"if=pflash,format=raw,file={dev.flash}",
           "-rtc", "base=localtime",
           "-monitor", f"unix:{dev.monitor},server=on,wait=off",
           "-name", f"Flipper Zero ({dev.name})"]
    for prop, value in (gauge or {}).items():
        cmd += ["-global", f"bq27220.{prop}={value}"]
    if not args.no_sd and dev.sd.exists():
        cmd += ["-drive", f"if=sd,format=raw,file={dev.sd}"]
    if window == "gtk":
        cmd += ["-display", "gtk,show-menubar=off,zoom-to-fit=off"]
    else:                               # none, or the window is ours
        cmd += ["-display", "none"]
    cmd += serial_args(dev, args.serial)
    cmd += lpuart_args(dev, args.lpuart)
    cmd += i2c_args(args.i2c, dev)
    cmd += spi_args(args.spi, dev)
    if args.gdb or args.wait_gdb:
        cmd += ["-gdb", f"tcp:127.0.0.1:{args.gdb_port}"]
    if args.wait_gdb:
        cmd += ["-S"]
    return cmd + list(args.qemu_args or [])


DETACHED = "FLIPPEREMU_DETACHED"     # set for the run that `run --detach` starts


def run_detached(dev, ready=None):
    """`run --detach`: this same run as a process of its own, and back to the
    shell when its emulator is up, or with what it said when that never came.
    A script's `run ... &` learns of a firmware that is not there a minute
    later, from a `wait` that ran out.  ready: says when it is up (a loaded
    snapshot's emulator answers before the state is known to be in)."""
    import tempfile
    ready = ready or dev.running
    DEVICES.mkdir(parents=True, exist_ok=True)
    # (beside the device's folder until there is one: a run that fails for
    # its firmware leaves no device behind)
    fd, said = tempfile.mkstemp(prefix=f".{dev.name}-run-", suffix=".log",
                                dir=DEVICES)
    with os.fdopen(fd, "wb") as out:
        child = subprocess.Popen(
            [sys.executable, str(ROOT / "flipperemu"), *sys.argv[1:]],
            stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
            start_new_session=True,
            env=dict(os.environ, PYTHONUNBUFFERED="1", **{DETACHED: "1"}))
    shown = 0

    def show():
        nonlocal shown
        with open(said, "rb") as f:
            f.seek(shown)
            data = f.read()
        shown += len(data)
        sys.stdout.flush()
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()

    try:
        while child.poll() is None and not ready():
            show()
            time.sleep(0.2)
        if child.poll() is not None:
            show()
            return child.returncode or 1
        time.sleep(0.5)                 # (its lines about the ports)
        show()
        log = dev.dir / "run.log"
        os.replace(said, log)
        said = None
        print(f"[{dev.name}] it runs on by itself, until `./flipperemu -d "
              f"{dev.name} stop`  (what the emulator prints: {log})")
        return 0
    except KeyboardInterrupt:
        child.terminate()
        show()
        return 130
    finally:
        if said:
            try:
                os.unlink(said)
            except OSError:
                pass


def cmd_run(args):
    if not QEMU.exists():
        sys.exit(f"QEMU not built yet: run scripts/setup_qemu.sh ({QEMU})")
    dev = Device(args.device)
    detached = os.environ.pop(DETACHED, None)
    if "help" in (args.i2c or ()):
        return i2c_help()
    if "help" in (args.spi or ()):
        return spi_help()
    i2c_args(args.i2c)          # (a wrong one is said before anything is done)
    i2c_known(args.i2c)
    for address, path, size in i2c_roms(dev, args.i2c):
        if path.exists() and path.stat().st_size != size:
            sys.exit(f"--i2c: the EEPROM at 0x{address:02x} is to have "
                     f"{size} bytes, and its contents, {path}, are "
                     f"{path.stat().st_size} bytes: say rom-size="
                     f"{path.stat().st_size}, or remove the file for a new, "
                     "empty EEPROM")
    spi_parse(args.spi)
    spi_known(args.spi)
    for pin, kind, path, size in spi_roms(dev, args.spi):
        if path.exists() and path.stat().st_size != size:
            sys.exit(f"--spi: the {kind} on pin {pin} is a flash of {size} "
                     f"bytes, and its contents, {path}, are "
                     f"{path.stat().st_size} bytes: remove the file for a "
                     "new, empty flash, or say a type of that size")
    if not args.print_cmd:
        dev.refuse_if_running()
        if args.detach and not detached:
            return run_detached(dev)
        if args.detach and args.serial == "stdio":
            args.serial = "null"        # (the log is `flipperemu log`'s to show)
        snap_undo(dev)
    if args.update and (args.usb == "none" or args.unplugged):
        sys.exit("--update starts the install over the USB CLI; drop --usb none "
                 "and --unplugged")
    gauge = None
    if args.battery is not None:
        if not 0 <= args.battery <= 100:
            sys.exit("--battery: 0 to 100 percent")
        gauge = {"soc": args.battery, "voltage-mv": battery_voltage(args.battery)}
    window = pick_window(args)
    if window == "qt" and not args.print_cmd:
        need_display()
    if args.firmware:
        fw = pathlib.Path(args.firmware)
        label, resources = dev.program(fw, args.erase_all)
        print(f"[{dev.name}] flashed {label}")
        if not dev.sd.exists() and not args.no_sd and not args.print_cmd:
            dev.make_sd(resources or find_resources_for(fw))
    if not dev.flash.exists():
        sys.exit(f"[{dev.name}] nothing flashed yet: ./flipperemu run -f <firmware>")
    if args.print_cmd:
        print(" ".join(qemu_cmd(dev, args, window, gauge)))
        return 0
    if not dev.sd.exists() and not args.no_sd:
        dev.make_sd(dev.info().get("resources"))
    manifest = label = None
    if args.update:
        if args.no_sd:
            sys.exit("--update needs the SD card")
        manifest, label, radio = stage_update(dev, pathlib.Path(args.update),
                                              args.keep_radio, run_stack(args))
        words = radio_words(radio)
        print(f"[{dev.name}] staged {manifest}" + (f" ({words})" if words else ""))
    info = dev.info()
    print(f"[{dev.name}] {info.get('firmware', '?')}  "
          f"(monitor: {dev.monitor}"
          + (f", gdb: :{args.gdb_port}" if args.gdb or args.wait_gdb else "") + ")")
    new_log(dev, args.serial)
    session = Session(dev, args, window, gauge, manifest, label)
    session.start()
    session.signals()
    return session.front()


class Session:
    """A device's QEMU.  It exits when the Flipper switches itself off;
    start() again is switching it back on (the window does that)."""

    def __init__(self, dev, args, window, gauge=None, manifest=None, label=None):
        self.dev, self.args, self.window = dev, args, window
        self.gauge = dict(gauge or {})
        self.update = (manifest, label)
        self.proc = None
        self.snapshot = None            # the one this run began at (a load)

    def start(self, unplugged=None, gauge=None, incoming=None):
        """unplugged, gauge: as it was left when it went off (default: as
        the run was asked for).  incoming: a state's file, and the machine
        comes up as that state has it, standing still (snapshot_load(), which
        does the rest once the state is known to be in)"""
        dev, args = self.dev, self.args
        if unplugged is not None:
            args.unplugged = unplugged
        if gauge is not None:
            self.gauge = dict(gauge)
        for stale in (dev.monitor, dev.usb_tty, dev.lpuart_tty, dev.usart_tty,
                      dev.lpuart_sock, dev.usart_sock, dev.panel_sock,
                      dev.held_file, dev.gdb_sock, dev.run_file):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass
        for _, path, size in i2c_roms(dev, args.i2c):
            if not path.exists():       # a new EEPROM: every bit is 1
                path.write_bytes(b"\xff" * size)
        for _, _, path, size in spi_roms(dev, args.spi):
            if not path.exists():
                spi_new(path, size)
        cmd = qemu_cmd(dev, args, self.window, self.gauge)
        if incoming:
            cmd += ["-incoming", f"file:{incoming}"]
        else:
            self.snapshot = None        # (switched on again: a start)
        self.proc = subprocess.Popen(cmd)
        run_note(dev, self.proc.pid, args)
        manifest, label = self.update
        self.update = (None, None)          # an update is started once
        args.log_level = None               # ... and its log level set once
        if incoming:
            return self.proc
        first = [spec for spec in i2c_parse(args.i2c) if spec[3]]
        helpers = "pty" in (args.usb, args.lpuart, args.serial) or manifest

        def after(proc=self.proc):
            if first:
                i2c_begin(dev, proc, first)
            if helpers:
                usb_helpers(dev, proc, args.usb, manifest, label)
        if first or helpers:
            threading.Thread(target=after, daemon=True).start()
        return self.proc

    def poll(self):
        """QEMU's exit code once it is gone, None while it runs"""
        return self.proc.poll() if self.proc else 0

    def tidy(self):
        """Behind a QEMU that is gone: what only meant something while it ran"""
        for stale in (self.dev.usb_tty, self.dev.lpuart_tty,
                      self.dev.usart_tty, self.dev.lpuart_sock,
                      self.dev.usart_sock, self.dev.held_file,
                      self.dev.run_file):
            try:
                stale.unlink()
            except FileNotFoundError:
                pass

    def signal(self, signum):
        if self.proc and self.proc.poll() is None:
            self.proc.send_signal(signum)

    def signals(self):
        """Killing the launcher stops the emulator too (Ctrl-C already
        reaches both)"""
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda signum, frame: self.signal(signum))

    def front(self):
        """The rest of a run that is up: its window, or the wait for its end"""
        dev, args = self.dev, self.args
        if args.usbip:
            print(f"[{dev.name}] USB/IP on {args.usbip_host}:{args.usbip}: "
                  f"attach with `sudo {ROOT / 'scripts' / 'usbip_attach.py'} "
                  f"--port {args.usbip}`", flush=True)
        if self.window == "qt":
            import fe_gui
            return fe_gui.run(dev.name, dev.dir, ROOT / "flipperemu",
                              session=self, scale=args.scale)
        try:
            return self.proc.wait()
        except KeyboardInterrupt:
            return self.stop()
        finally:
            self.tidy()

    def stop(self, timeout=10):
        """As `flipperemu stop`: QEMU saves the NVRAM on its way out."""
        if not self.proc:
            return 0
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        return self.proc.wait()


def start_update(cli, manifest):
    """Tell the firmware, at its CLI prompt, to install the package whose
    manifest this is.  None when it restarts to do so (no prompt comes after
    that), else what it said instead."""
    cli.write(f"update install {manifest}\r".encode())
    out, end = b"", time.time() + 20
    while time.time() < end and b"BRB" not in out and b"Error" not in out:
        if cli._fill(0.2):
            out += cli.buf
            cli.buf = b""
    text = out.decode(errors="replace")
    if "BRB" in text:
        return None
    err = re.search(r"Error: [^\r\n]*", text)
    return err.group(0) if err else text.strip() or "no answer to `update install`"


def usb_helpers(dev: Device, proc, usb_mode, manifest, label=None):
    """Link devices/<name>/usb.tty to QEMU's pty for the USB serial port
    (and lpuart.tty, usart.tty to those of the header's serial ports), and
    start a staged update through the firmware's CLI (as qFlipper does)."""
    from fe_cli import FlipperCli, usb_endpoint
    from fe_monitor import Monitor
    ep, pins = None, {}
    for _ in range(100):
        if proc.poll() is not None:
            return
        if dev.monitor.exists():
            try:
                m = Monitor(str(dev.monitor))
                try:
                    ep = usb_endpoint(m)
                    pins = {port: usb_endpoint(m, UART_PORTS[port][0])
                            for port in UART_PORTS}
                finally:
                    m.close()
            except OSError:
                ep, pins = None, {}
            if ep or any(pins.values()):
                break
        time.sleep(0.1)
    for port, at in pins.items():
        if at and at[0] == "pty":
            link = uart_link(dev, port)
            link.symlink_to(at[1])
            print(f"[{dev.name}] serial port on pins {UART_PORTS[port][1]} "
                  f"({UART_PORTS[port][2]}): {at[1]} -> {link}", flush=True)
    if not ep:
        return
    if ep[0] == "pty":
        dev.usb_tty.symlink_to(ep[1])
        print(f"[{dev.name}] USB serial (CLI/RPC): {ep[1]} -> {dev.usb_tty}"
              f"   (./flipperemu -d {dev.name} cli)", flush=True)
    if not manifest:
        return
    try:
        cli = FlipperCli(ep)
        try:
            cli.read_until_prompt(60)
            refused = start_update(cli, manifest)
        finally:
            cli.close()
    except (OSError, TimeoutError, ConnectionError) as e:
        print(f"[{dev.name}] could not start the update over USB: {e}", flush=True)
        return
    if refused:
        print(f"[{dev.name}] update refused: {refused}", flush=True)
    else:
        print(f"[{dev.name}] updater started: {manifest}", flush=True)
        dev.save_info(firmware=f"{label} (installed by update)",
                      flashed=time.strftime("%Y-%m-%d %H:%M:%S"), source=manifest)
        keystores_after_update(dev, proc)


def cmd_stop(args):
    from fe_monitor import Monitor
    dev = Device(args.device)
    if not dev.running():
        print(f"[{dev.name}] not running")
        return 0
    m = Monitor(str(dev.monitor))
    m.s.sendall(b"quit\n")
    m.close()
    for _ in range(100):                # QEMU removes the socket on exit
        if not dev.monitor.exists():
            break
        time.sleep(0.1)
    print(f"[{dev.name}] stopped")
    return 0


def open_monitor(dev):
    from fe_monitor import Monitor
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    return Monitor(str(dev.monitor))


def qom_get(m, path, prop):
    """A QOM property through the monitor (which prints JSON); None: none"""
    try:
        return json.loads(m.cmd(f"qom-get {path} {prop}"))
    except ValueError:
        return None


def read_bluetooth(m):
    """CPU2 and its BLE stack (stm32wb55_ble.c): what it runs, whether the
    firmware has started the stack, its advertising.  None: an emulator from
    before it had a stack"""
    raw = qom_get(m, "/machine/soc/ipcc", "ble")
    try:
        return json.loads(raw) if isinstance(raw, str) else None
    except ValueError:
        return None


def bluetooth_text(bt):
    """... in words"""
    if bt is None:
        return "this emulator has no radio stack (rebuild it: scripts/setup_qemu.sh)"
    if not bt.get("stack"):
        return "no radio stack installed: CPU2 runs the FUS alone (run --radio-stack none)"
    if bt.get("runs") != "stack":
        return (f"the radio stack {bt['stack']} is installed; CPU2 has not "
                "started it" + (" (it runs the FUS)" if bt.get("runs") == "fus"
                                else ""))
    if not bt.get("up"):
        return f"the radio stack {bt['stack']} runs; the firmware has not started BLE"
    conn = bt.get("connection")
    bonds = bt.get("bonds") or 0
    if conn:
        how = ("paired" if conn.get("authenticated") else "encrypted"
               if conn.get("encrypted") else "not paired")
        if conn.get("pairing") not in (None, "none"):
            how = f"pairing ({conn['pairing']})"
        state = f"connected to {conn.get('central')} ({how}, MTU {conn.get('mtu')})"
    elif bt.get("advertising"):
        state = f"advertising as \"{bt.get('name') or '?'}\""
    else:
        state = "not advertising"
    return (f"the radio stack {bt['stack']} runs; {state}"
            + f"; {bt.get('services', 0)} GATT services"
            + (f"; its address {bt['address']}" if bt.get("address") else "")
            + (f"; bonded with {bonds} central{'s' if bonds > 1 else ''}"
               if bonds else "")
            + ("; a program is on its Bluetooth link (ble.sock)"
               if bt.get("link") and not conn else ""))


def cmd_ble(args):
    """A running device's Bluetooth, as a phone sees it: the advertising
    (`scan`), its services and their values (`gatt`), one value read or
    written, and an RPC session over the air (`rpc`).  All but `scan`
    connect and pair, with the PIN that the Flipper shows.  Nothing: what its
    stack does, and who is connected (scripts/fe_ble.py)."""
    import fe_ble
    dev = Device(args.device)
    if not dev.running():
        sys.exit(f"[{dev.name}] not running")
    if args.action == "status":
        m = open_monitor(dev)
        try:
            bt = read_bluetooth(m)
        finally:
            m.close()
        if args.json:
            print(json.dumps(bt, indent=2))
        else:
            print(f"[{dev.name}] {bluetooth_text(bt)}")
        return 0
    if args.action == "forget":
        return fe_ble.run(dev.ble_sock, "forget",
                          bonds=dev.dir / "ble-central.json")
    if args.action in ("read", "write") and not args.what:
        sys.exit(f"ble {args.action}: a characteristic's UUID (2a26) or "
                 "handle (0x0012)" + (", and the bytes in hex" if
                                      args.action == "write" else ""))
    if not dev.ble_sock.exists():
        sys.exit(f"[{dev.name}] has no Bluetooth link (ble.sock): an emulator "
                 "from before 2026-11-14 started it. Stop it and run it again")
    # this device's phone keeps its bonds beside it: with one, it comes back
    # without a PIN, as long as the Flipper keeps its side of it
    return fe_ble.run(dev.ble_sock, args.action, args.what, args.pin, dev.uart,
                      args.timeout, args.json,
                      bonds=dev.dir / "ble-central.json")


def stopped(m):
    """Why a running device stands still, or "": "paused" (somebody paused
    it), "debug" (a debugger has it), or another of QEMU's run states.  A
    link's own stop for an answer (NFC) is none: that is over in a moment."""
    why = qom_get(m, "/machine/panel", "stopped")
    if why is None:                 # an emulator from before it could say
        hit = re.search(r"paused(?: \((.+?)\))?", m.cmd("info status"))
        why = (hit.group(1) or "paused") if hit else ""
    return why


def still_text(dev, why):
    """... in words, with what ends it"""
    if why == "paused":
        return f"it is paused (`./flipperemu -d {dev.name} continue`)"
    if why == "debug":
        return "a debugger has it stopped (`continue` there)"
    return f"it stands still (QEMU's state: {why})"


def halted_at(m):
    """Where the firmware sleeps for good, or None: it has not halted.  A
    debug build that crashed waits for a debugger, and furi_halt() waits for
    the end, both in the same two instructions with the interrupts off:
    `wfi`, and a branch back to it.  A firmware that is alive goes on after
    its `wfi` (there are those two places in an image, and no third)."""
    hit = re.search(r"\bR15=([0-9a-f]{8})", m.cmd("info registers"))
    pc = int(hit.group(1), 16) & ~1 if hit else 0
    if pc < 2:
        return None
    code = [int(word, 16) for word in
            re.findall(r"\b0x([0-9a-f]{4})\b", m.cmd(f"x/3hx {pc - 2:#x}"))]
    if code[1:3] == HALT_LOOP:
        return pc
    return pc - 2 if code[0:2] == HALT_LOOP else None


HALT_LOOP = [0xbf30, 0xe7fd]            # wfi; b .-2
FAULT_REGISTER = 0x40002860             # RTC backup register 4
FLASH = range(0x08000000, 0x08100000)
NO_REASON = "Check serial logs"         # its message was not in the flash


def last_fault(m):
    """What the firmware's last crash said, or None.  A release build that
    crashes writes a pointer to its message into a register that lives through
    the restart, shows the message on its desktop afterwards ("Flipper crashed
    and was rebooted") and clears the register when that screen is left.
    A message that is not in the flash (an app's own) is not kept: the
    register then points at NO_REASON.

    The log does not always have it: what a crash prints is dropped while
    another thread is in the middle of a line there."""
    word = re.search(r":\s*0x([0-9a-f]{8})\b",
                     m.cmd(f"xp/1wx {FAULT_REGISTER:#x}"))
    at = int(word.group(1), 16) if word else 0
    if at not in FLASH:
        return None
    data = bytes(int(byte, 16)
                 for line in m.cmd(f"xp/64bx {at:#x}").splitlines()
                 for byte in re.findall(r"\b0x([0-9a-f]{2})\b",
                                        line.partition(":")[2]))
    text = data.split(b"\0")[0].decode("ascii", "replace").strip()
    return text if text and text.isprintable() else None


def firmware_fault(dev, m=None):
    """last_fault() of a running device; None as well when the emulator did
    not say"""
    try:
        if m:
            return last_fault(m)
        from fe_monitor import Monitor
        m = Monitor(str(dev.monitor), timeout=2.0)
        try:
            return last_fault(m)
        finally:
            m.close()
    except (OSError, ConnectionError):
        return None


def firmware_halt(dev, m=None):
    """A running device whose firmware has halted: {"at": where its CPU
    sleeps, "kind": "CRASH" or "HALT", "report": what its log says of it}
    (None and None: the log has nothing).  None: it has not halted, or the
    emulator did not say."""
    try:
        if m:
            at = halted_at(m)
        else:
            from fe_monitor import Monitor
            m = Monitor(str(dev.monitor), timeout=2.0)
            try:
                at = halted_at(m)
            finally:
                m.close()
    except (OSError, ConnectionError):
        return None
    if at is None:
        return None
    import fe_log
    found = None
    try:
        with open(dev.uart, "rb") as f:     # its report is the last it wrote
            f.seek(max(0, f.seek(0, os.SEEK_END) - 8192))
            for raw in f.read().decode(errors="replace").splitlines():
                found = fe_log.crash_of(fe_log.parse(raw)) or found
    except OSError:
        pass
    kind, report = found or (None, None)
    return {"at": f"{at:#010x}", "kind": kind, "report": report or None}


def halt_text(dev, halt):
    """... in words: (what happened, what to do about it)"""
    said = f" ({halt['report']})" if halt["report"] else ""
    if halt["kind"] == "HALT":
        what = f"halted{said}: its own code asked for that"
    elif halt["kind"] == "CRASH":
        what = (f"crashed{said} and has halted: a debug build waits for a "
                "debugger there, where a release build starts again")
    else:
        what = ("has halted, as a debug build does after a crash (its log "
                "has no report of it)")
    return what, (f"`./flipperemu -d {dev.name} gdb` shows where it stands, "
                  f"`./flipperemu -d {dev.name} reset` starts it again")


def halt_note(args):
    """For a command that got no answer from a device: that its firmware has
    halted, if it has"""
    try:
        dev = Device(args.device)
        halt = firmware_halt(dev) if dev.running() else None
    except (Exception, SystemExit):
        return ""
    if not halt:
        return ""
    what, todo = halt_text(dev, halt)
    return f"\n[{dev.name}] the firmware {what}.  {todo}"


def cmd_pause(args):
    """Time stands still on a running device, until `continue`"""
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        was = stopped(m)
        if not was:
            if m.cmd("qom-set /machine/panel paused true").strip():
                m.cmd("stop")       # an emulator from before `paused`
        why = stopped(m)
        gdb = gdb_stub(m)
    finally:
        m.close()
    if was == "paused":
        print(f"[{dev.name}] is paused already")
    elif was:
        sys.exit(f"[{dev.name}] not paused: {still_text(dev, was)}")
    elif why != "paused":
        sys.exit(f"[{dev.name}] did not pause")
    elif gdb and gdb[1]:
        print(f"[{dev.name}] paused: a gdb is on it, and `continue` there "
              "lets it go on")
    else:
        print(f"[{dev.name}] paused: `./flipperemu -d {dev.name} continue` "
              "lets it go on")
    return 0


def cmd_continue(args):
    """A paused device goes on"""
    dev = Device(args.device)
    m = open_monitor(dev)
    try:
        was = stopped(m)
        gdb = gdb_stub(m)
        if was and gdb and gdb[1]:
            # it would run, and the gdb would still take it to stand still
            sys.exit(f"[{dev.name}] a gdb is on it, and it stands still: "
                     "`continue` there lets it go on")
        if was:
            if m.cmd("qom-set /machine/panel paused false").strip():
                m.cmd("cont")       # an emulator from before `paused`
        why = stopped(m)
    finally:
        m.close()
    if why:
        sys.exit(f"[{dev.name}] does not go on: {still_text(dev, why)}")
    print(f"[{dev.name}] " + ("goes on" if was else "is not paused: it runs"))
    return 0


# ------------------------------------------------------------- snapshots
#
# A snapshot is a running device as it stands, kept in the device's folder
# (devices/NAME/snapshots/SNAPSHOT/): the emulator's state (QEMU's migration
# to a file: the CPU, the RAM, every model of the chip and of the board) and
# a copy of the device's files as they were at that moment.  The state alone
# would not do.  The firmware has a part of the card's file system in its
# RAM, and on a card that went on since it writes that over what is newer.
#
# A state holds the device's RAM and flash, its keys with them, and the
# memory of a card that is held to it.  A snapshot's folder is the user's
# alone (0700), and nothing here prints what is in one.

# the arguments of a run that make its machine (the rest is the front end's,
# or a start's alone: a battery's charge, a log level)
MACHINE_ARGS = ("usb", "usbip", "usbip_host", "serial", "lpuart", "i2c",
                "spi", "no_sd", "name", "legacy_sleep", "radio_stack",
                "qemu_args")
RUN_DEFAULTS = {}               # `run` with nothing said (main() has them)
SNAP_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
SNAP_ASIDE = ".before-load"     # the device's own files, while one is loaded
# header devices whose models save nothing of themselves (QEMU's own; tried)
SNAP_AS_NEW = ("aspeed.i2c.slave", "i2c-echo", "isl69259", "isl69260",
               "m41t80", "raa228000", "raa229004")
FICLONE = 0x40049409            # <linux/fs.h>: two files share their data


class SnapshotError(Exception):
    pass


def run_note(dev, pid, args, **more):
    """devices/NAME/run.json: which QEMU a run's is, and the arguments that
    made its machine.  A state is loaded into a machine that is made the
    same way, and `snapshot save` reads here how this one was."""
    note = {"pid": pid, "started": time.strftime("%Y-%m-%d %H:%M:%S"),
            "machine": {k: getattr(args, k, None) for k in MACHINE_ARGS},
            **more}
    tmp = dev.run_file.with_suffix(".tmp")
    tmp.write_text(json.dumps(note, indent=2) + "\n")
    os.replace(tmp, dev.run_file)


def run_noted(dev, m=None):
    """That note, or None.  m: the note of the QEMU on this monitor, and
    None when it is another's (an emulator that was started by hand, or by
    a launcher from before, has none)"""
    try:
        note = json.loads(dev.run_file.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(note, dict) or not isinstance(note.get("machine"), dict):
        return None
    if m:
        pid = struct.unpack("3i", m.s.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[0]
        if note.get("pid") != pid:
            return None
    return note


def file_sha256(path):
    """(a file's SHA-256, when it was last written)"""
    import hashlib
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
        return digest.hexdigest(), os.fstat(f.fileno()).st_mtime


def emulator_build(binary=None):
    """Which build an emulator is (the one on the disk, or a running one's
    /proc/PID/exe): a state is for the build that made it"""
    sha256, built = file_sha256(binary or QEMU)
    return {"sha256": sha256,
            "built": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(built))}


def copy_file(src, dst):
    """A copy that is the user's alone.  Where the file system can (btrfs,
    XFS) the two share their data and the copy costs nothing; elsewhere a
    file's holes stay holes (a card's image is mostly one)."""
    import fcntl
    s = os.open(src, os.O_RDONLY)
    try:
        d = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            try:
                fcntl.ioctl(d, FICLONE, s)
                return
            except OSError:
                pass
            size, at = os.fstat(s).st_size, 0
            while at < size:
                try:
                    at = os.lseek(s, at, os.SEEK_DATA)
                    end = os.lseek(s, at, os.SEEK_HOLE)
                except OSError:         # a hole from here to the end
                    break
                os.lseek(s, at, os.SEEK_SET)
                os.lseek(d, at, os.SEEK_SET)
                while at < end:
                    data = os.read(s, min(1 << 20, end - at))
                    if not data:
                        raise OSError(f"{src}: it became shorter in the copy")
                    at += len(data)
                    while data:
                        data = data[os.write(d, data):]
            os.ftruncate(d, size)
        finally:
            os.close(d)
    finally:
        os.close(s)


def snap_files(dev, machine):
    """The device's files that go with a state of a machine with these
    arguments.  The card and what is on the header are their images' (a
    state has none of their contents); the flash, the NVRAM and the keys
    are written anew by a loaded machine, and are here for a folder that is
    one moment's.  (A device on the header with a drive of its own, in the
    user's words, is the user's to keep.)"""
    files = [dev.flash, dev.nvram, dev.enclave, dev.elf, dev.meta]
    if not machine.get("no_sd"):
        files.append(dev.sd)
    files += [path for _, path, _ in i2c_roms(dev, machine.get("i2c"))]
    files += [path for _, _, path, _ in spi_roms(dev, machine.get("spi"))]
    return files


def snap_logs(dev):
    """... and what the firmware said in the run so far: a loaded run goes
    on in the same log (a crash's report is read from it), and `uart wait`
    where it was"""
    return [dev.uart, dev.lpuart_log,
            uart_mark_file(dev, "lpuart"), uart_mark_file(dev, "usart")]


def state_sections(path):
    """The parts of a machine that a state file has: {(name, number)}, from
    the description that QEMU writes at a state's end (names and sizes, no
    contents: a byte 6, its length, JSON).  None: it has none there."""
    with open(path, "rb") as f:
        data = f.read()
    at = len(data)
    while True:
        at = data.rfind(b"\x06", 0, at)
        if at < 0:
            return None
        if at + 5 + int.from_bytes(data[at + 1:at + 5], "big") == len(data) \
                and data[at + 5:at + 6] == b"{":
            try:
                return {(part["name"], part.get("instance_id"))
                        for part in json.loads(data[at + 5:])["devices"]}
            except (ValueError, KeyError, TypeError):
                return None


def snap_migrate(m, path):
    """The state of a machine that stands still, into a file that is there
    (made by us, new and the user's alone: QEMU 11 gives one of its own
    making that mode too, and nothing here leans on it).  QEMU takes a
    machine that has migrated for gone, and the panel's model takes it back
    (flipper_panel.c): its `saves` counts the states that ended well, and
    that count is what says that this one did."""
    before = qom_get(m, "/machine/panel", "saves")
    quoted = str(path).replace("\\", "\\\\").replace('"', '\\"')
    said = re.search(r"Error: *(.+)", m.cmd(f'migrate -d "file:{quoted}"'))
    end = time.time() + 120
    while not said:
        hit = re.search(r"Status:\s*([\w-]+)(?: *\((.+)\))?",
                        m.cmd("info migrate"))
        status = hit.group(1) if hit else ""
        if status == "completed":
            if qom_get(m, "/machine/panel", "saves") == before + 1:
                return
            end = min(end, time.time() + 5)     # (the count follows at once)
        if status in ("failed", "cancelled") or time.time() > end:
            said = hit and hit.group(2) and hit
            break
        time.sleep(0.05)
    raise SnapshotError("the emulator did not save its state"
                        + (f" ({said.group(said.lastindex).strip()})"
                           if said else ""))


def snap_list(dev):
    """The device's snapshots, the oldest first: [(its folder, its note)]"""
    found = []
    try:
        folders = [p for p in dev.snapshots.iterdir()
                   if p.is_dir() and not p.name.startswith(".")]
    except OSError:
        folders = []
    for folder in folders:
        try:
            note = json.loads((folder / "snapshot.json").read_text())
        except (OSError, ValueError):
            continue
        if isinstance(note, dict) and (folder / "state").is_file():
            found.append((folder, note))
    return sorted(found, key=lambda it: (it[1].get("at") or 0, it[0].name))


def snap_find(dev, name):
    """The snapshot of that name, or the newest: (its folder, its note)"""
    found = snap_list(dev)
    if name is None and found:
        return found[-1]
    for folder, note in found:
        if folder.name == name:
            return folder, note
    sys.exit(f"[{dev.name}] has no snapshot"
             + (f" {name}" if name else "")
             + (": it has " + ", ".join(f.name for f, _ in found) if found
                else f": `./flipperemu -d {dev.name} snapshot save` makes "
                     "one of a device that runs"))


def snap_undo(dev, quiet=False):
    """A load that ended badly, or was killed, has the device's own files
    in a folder aside, and the snapshot's in their places: back with them.
    (The folder's note has the names of the snapshot's files once all of
    the device's own are aside, and not before: a load that got no further
    than that has put nothing in their places, and what is still in the
    device's folder is the device's.)"""
    aside = dev.dir / SNAP_ASIDE
    if not aside.is_dir():
        return
    try:
        put = json.loads((aside / "load.json").read_text())
    except (OSError, ValueError):
        put = {}
    for name in put.get("files") or []:
        try:
            (dev.dir / pathlib.Path(name).name).unlink()
        except OSError:
            pass
    for path in aside.iterdir():
        if path.name not in ("load.json", "load.tmp"):
            os.replace(path, dev.dir / path.name)
    shutil.rmtree(aside)
    if not quiet:
        print(f"[{dev.name}] a load of the snapshot {put.get('snapshot', '?')} "
              "did not come to its end: the device's files are as they were "
              "before it")


def snapshot_save(dev, name):
    if not name:
        name = stem = time.strftime("%Y%m%d-%H%M%S")
        more = 1
        while (dev.snapshots / name).exists():  # (two in one second)
            more += 1
            name = f"{stem}-{more}"
    if not SNAP_NAME.match(name):
        sys.exit("snapshot: a name is of letters, digits, `.`, `_` and `-`, "
                 "begins with a letter or a digit and has 64 characters at "
                 "most")
    final = dev.snapshots / name
    if final.exists():
        sys.exit(f"[{dev.name}] has a snapshot {name} already: `./flipperemu "
                 f"-d {dev.name} snapshot rm {name}` removes it")
    stays = None
    m = open_monitor(dev)
    try:
        run = run_noted(dev, m)
        if run is None:
            sys.exit(f"[{dev.name}] no snapshot: this emulator was not "
                     "started by this launcher's `run` (or by one from "
                     "before it had snapshots), and how its machine was "
                     "made is not known.  Stop the device and run it again")
        if qom_get(m, "/machine/panel", "saves") is None:
            sys.exit(f"[{dev.name}] no snapshot: this emulator is from "
                     "before it could save its state.  `scripts/"
                     "setup_qemu.sh` builds the one that can; then stop "
                     "the device and run it again")
        was = stopped(m)
        if was not in ("", "paused", "debug"):
            sys.exit(f"[{dev.name}] no snapshot: {still_text(dev, was)}")
        try:
            build = emulator_build(f"/proc/{run['pid']}/exe")
        except OSError:
            build = emulator_build()
        machine = run["machine"]
        new = dev.snapshots / f".{name}.new"
        dev.snapshots.mkdir(mode=0o700, exist_ok=True)
        if new.exists():
            shutil.rmtree(new)          # of a save that was killed
        new.mkdir(mode=0o700)
        try:
            if not was:
                m.cmd("qom-set /machine/panel paused true")
                if stopped(m) != "paused":
                    raise SnapshotError("the device did not pause")
            try:
                state = new / "state"
                os.close(os.open(state, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                                 0o600))
                snap_migrate(m, state)
                files = []
                for path in snap_files(dev, machine) + snap_logs(dev) \
                        + [dev.held_file]:
                    if path.is_file():
                        copy_file(path, new / path.name)
                        files.append(path.name)
                note = {"name": name, "at": time.time(),
                        "saved": time.strftime("%Y-%m-%d %H:%M:%S"),
                        "firmware": dev.info().get("firmware"),
                        "machine": machine, "emulator": build,
                        "state": file_sha256(state)[0],
                        "held": dev.held(), "files": files}
                fd = os.open(new / "snapshot.json",
                             os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w") as f:
                    f.write(json.dumps(note, indent=2) + "\n")
            finally:
                if not was:
                    gdb = gdb_stub(m)
                    if gdb and gdb[1]:
                        stays = ("it stays paused: a gdb is on it, and "
                                 "`continue` there lets it go on")
                    else:
                        m.cmd("qom-set /machine/panel paused false")
                        why = stopped(m)
                        if why:
                            stays = f"it does not go on: {still_text(dev, why)}"
            os.rename(new, final)
        except BaseException:
            shutil.rmtree(new, ignore_errors=True)
            raise
    except SnapshotError as e:
        sys.exit(f"[{dev.name}] no snapshot: {e}"
                 + (f".  And {stays}" if stays else ""))
    finally:
        m.close()
    print(f"[{dev.name}] snapshot {name}: {note['firmware'] or '?'}, as it "
          f"stands  (`./flipperemu -d {dev.name} snapshot load {name}` is "
          "back there)")
    if stays:
        print(f"[{dev.name}] {stays}")
    for kind, address, _, _ in i2c_parse(machine.get("i2c")):
        if kind in SNAP_AS_NEW:
            print(f"[{dev.name}] the {kind} at 0x{address:02x} of the header "
                  "has nothing in a snapshot (its model saves nothing): "
                  "after a load it is as new")
    return 0


def snap_enter(dev, proc, snap, paused):
    """A QEMU that was started on a state: wait for the state to be in,
    see that it had something for every part of this machine, give the
    held things their names back, and let the machine go on.

    QEMU refuses a state with a part that this machine does not have, or
    with one of another size, and ends.  It takes one that lacks a part,
    and that part is as after a reset: so the loaded machine saves a state
    of its own, before it has run, and the two are compared by their parts'
    names.  (Not by the whole descriptions: what a part saves depends on
    what the machine was doing.)"""
    import tempfile
    from fe_monitor import Monitor
    m, end = None, time.time() + 60
    try:
        while True:
            if proc.poll() is not None:
                raise SnapshotError("the emulator refused its state (its "
                                    "words are above this line)")
            if time.time() > end:
                raise SnapshotError("the emulator did not take its state in "
                                    "a minute")
            status = None
            try:
                if m is None and dev.monitor.exists():
                    m = Monitor(str(dev.monitor))
                if m:
                    status = re.search(r"Status:\s*([\w-]+)",
                                       m.cmd("info migrate"))
            except OSError:             # not there yet, or gone again
                if m:
                    m.close()
                m = None
            if status and status.group(1) == "completed":
                break
            time.sleep(0.05)
        if not stopped(m):              # (a state that was saved by hand)
            m.cmd("qom-set /machine/panel paused true")
        fd, again = tempfile.mkstemp(prefix=".state-", dir=dev.dir)
        os.close(fd)
        try:
            snap_migrate(m, again)
            ours = state_sections(again)
        finally:
            os.unlink(again)
        theirs = state_sections(snap / "state")
        if ours is None or theirs is None:
            raise SnapshotError("its state has no description at its end: "
                                "the file is not as the emulator wrote it")
        lacks = sorted({name for name, _ in ours - theirs})
        if lacks:
            raise SnapshotError(
                "its state has nothing for " + ", ".join(lacks[:8])
                + (f" and {len(lacks) - 8} more" if len(lacks) > 8 else "")
                + ", which would be as after a reset: it is of another build "
                "of the emulator, or of a machine with other devices")
        if (snap / dev.held_file.name).is_file():
            copy_file(snap / dev.held_file.name, dev.held_file)
        if not paused:
            said = m.cmd("qom-set /machine/panel paused false").strip()
            why = stopped(m)
            if why:
                raise SnapshotError("it does not go on: "
                                    + (said or still_text(dev, why)))
    except BaseException:
        if m and proc.poll() is None:
            try:
                m.s.sendall(b"quit\n")          # (as `stop` ends one)
                proc.wait(5)
            except (OSError, subprocess.TimeoutExpired):
                pass
        raise
    finally:
        if m:
            m.close()


def snapshot_load(args, dev):
    if not QEMU.exists():
        sys.exit(f"QEMU not built yet: run scripts/setup_qemu.sh ({QEMU})")
    detached = os.environ.pop(DETACHED, None)
    snap, note = snap_find(dev, args.name)
    name = snap.name
    dev.refuse_if_running()
    machine = note.get("machine")
    if not isinstance(machine, dict):
        sys.exit(f"[{dev.name}] the snapshot {name} does not say how its "
                 f"machine was made ({snap / 'snapshot.json'})")
    theirs = note.get("emulator") or {}
    if theirs.get("sha256") != emulator_build()["sha256"]:
        other = (f"the snapshot {name} is of another build of the emulator "
                 f"(its own was built {theirs.get('built', '?')})")
        if not args.any_build:
            sys.exit(f"[{dev.name}] {other}.  A state is for the build that "
                     "made it: another one refuses it, or takes it with a "
                     "part of the machine as something else.  `snapshot load "
                     "--any-build` tries it all the same (a state that the "
                     "emulator refuses, or that lacks a part of this "
                     "machine, is not loaded, and the device is then as it "
                     "was)")
    else:
        other = None
    # (QEMU's stream has no sum of its own: a byte of the RAM that is wrong
    # in the file would be a byte of the RAM that is wrong in the machine)
    if note.get("state") and file_sha256(snap / "state")[0] != note["state"]:
        sys.exit(f"[{dev.name}] the snapshot {name} is not loaded: its state "
                 f"is not the file that was saved ({snap / 'state'} is "
                 "damaged, or was changed).  The device is as it was")
    run = dict(RUN_DEFAULTS)
    run.update({k: machine[k] for k in MACHINE_ARGS if k in machine})
    extra, skip = [], False
    for word in run["qemu_args"] or []:         # (a load made by hand)
        if skip or word == "-incoming":
            skip = not skip
        else:
            extra.append(word)
    run.update(device=dev.name, headless=args.headless, gtk=args.gtk,
               detach=args.detach, scale=args.scale, audio=args.audio,
               gdb=args.gdb, gdb_port=args.gdb_port, qemu_args=extra)
    run = argparse.Namespace(**run)
    if run.serial in ("stdio", "null"):
        # the log on the terminal, or not: that is this start's, as a run's
        run.serial = "null" if args.detach else "stdio"
    i2c_args(run.i2c)
    spi_parse(run.spi)
    window = pick_window(run)
    if window == "qt":
        need_display()
    if args.detach and not detached:
        try:
            dev.run_file.unlink()
        except FileNotFoundError:
            pass
        return run_detached(dev, ready=lambda: (run_noted(dev) or {})
                            .get("snapshot") == name)
    snap_undo(dev)
    if other:
        print(f"[{dev.name}] {other}: tried all the same")
    print(f"[{dev.name}] snapshot {name}: {note.get('firmware') or '?'}, "
          f"saved {note.get('saved', '?')}  (monitor: {dev.monitor}"
          + (f", gdb: :{run.gdb_port}" if run.gdb else "") + ")", flush=True)
    put = snap_files(dev, machine) + snap_logs(dev)
    aside = dev.dir / SNAP_ASIDE
    gone = dev.dir / (SNAP_ASIDE + ".old")
    shutil.rmtree(gone, ignore_errors=True)     # (a load killed at its end)
    aside.mkdir(mode=0o700)
    load = {"snapshot": name}
    (aside / "load.json").write_text(json.dumps(load) + "\n")
    session = Session(dev, run, window)
    done = False
    try:
        for path in put + [dev.uart_old]:
            if path.exists():
                os.replace(path, aside / path.name)
        # from here on the files of these names in the device's folder are
        # the snapshot's, and snap_undo() removes them
        load["files"] = [path.name for path in put]
        (aside / "load.tmp").write_text(json.dumps(load) + "\n")
        os.replace(aside / "load.tmp", aside / "load.json")
        for path in put:
            if (snap / path.name).is_file():
                copy_file(snap / path.name, path)
        session.start(incoming=snap / "state")
        session.signals()
        snap_enter(dev, session.proc, snap, args.paused)
        os.rename(aside, gone)          # loaded: no way back from here
        done = True
        # the log of the run before this one is kept, as a start keeps it
        for old in (gone / dev.uart.name, gone / dev.uart_old.name):
            if old.exists() and old.stat().st_size:
                os.replace(old, dev.uart_old)
                break
        shutil.rmtree(gone)
    except SnapshotError as e:
        sys.exit(f"[{dev.name}] the snapshot {name} is not loaded: {e}.  "
                 "The device is as it was")
    finally:
        if not done:
            session.stop()
            session.tidy()
            # (a QEMU that refuses a state leaves by exit(), sockets and all)
            for stale in (dev.monitor, dev.panel_sock, dev.nfc_sock,
                          dev.subghz_sock, dev.ble_sock, dev.gdb_sock):
                try:
                    stale.unlink()
                except FileNotFoundError:
                    pass
            snap_undo(dev, quiet=True)
    if "pty" in (run.usb, run.lpuart, run.serial):
        usb_helpers(dev, session.proc, run.usb, None)
    print(f"[{dev.name}] loaded: "
          + (f"it stands still, and `./flipperemu -d {dev.name} continue` "
             "lets it go on" if args.paused else "it goes on from there"),
          flush=True)
    run_note(dev, session.proc.pid, run, snapshot=name,
             saved=note.get("saved"))
    session.snapshot = {"name": name, "saved": note.get("saved")}
    return session.front()


def cmd_snapshot(args):
    """A running device as it stands, kept; and a device back at that
    moment"""
    dev = Device(args.device)
    if args.action == "save":
        return snapshot_save(dev, args.name)
    if args.action == "load":
        return snapshot_load(args, dev)
    if args.action == "rm":
        if not args.name:
            sys.exit("snapshot rm: which one?  (`snapshot` lists them)")
        snap, _ = snap_find(dev, args.name)
        shutil.rmtree(snap)
        print(f"[{dev.name}] snapshot {snap.name}: removed")
        return 0
    if args.name:
        sys.exit(f"snapshot: `snapshot save {args.name}` or `snapshot load "
                 f"{args.name}`?")
    found = snap_list(dev)
    build = emulator_build()["sha256"] if found and QEMU.exists() else None
    same = lambda note: (note.get("emulator") or {}).get("sha256") == build
    if args.json:
        print(json.dumps([{"name": folder.name, "saved": note.get("saved"),
                           "firmware": note.get("firmware"),
                           "this_build": same(note),
                           "held": note.get("held") or {},
                           "machine": note.get("machine"),
                           "path": str(folder)}
                          for folder, note in found], indent=2))
        return 0
    if not found:
        print(f"[{dev.name}] no snapshots  (`./flipperemu -d {dev.name} "
              "snapshot save [NAME]` makes one of a device that runs)")
        return 0
    width = max(len(folder.name) for folder, _ in found)
    print(f"[{dev.name}] {len(found)} snapshot{'s'[:len(found) != 1]}, the "
          f"oldest first  ({dev.snapshots})")
    for folder, note in found:
        print(f"  {folder.name:<{width}}  {note.get('saved', '?')}  "
              f"{note.get('firmware') or '?'}"
              + ("" if same(note) else "  (of another build of the emulator)"))
    return 0


def cmd_gui(args):
